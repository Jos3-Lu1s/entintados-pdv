<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <data noupdate="1">

        <record id="demo_collection_interiores" model="tint.collection">
            <field name="name">Interiores (demo)</field>
            <field name="code">INT-DEMO</field>
            <field name="sequence">10</field>
        </record>

        <!-- ============== Rojo Cardenal ============== -->

        <record id="demo_color_rojo_cardenal" model="tint.color">
            <field name="name">Rojo Cardenal (demo)</field>
            <field name="html_color">#C8102E</field>
            <field name="collection_id" ref="demo_collection_interiores" />
        </record>

        <!-- Sobre base Deep, galón: 48 pts de 384 disponibles -->
        <record id="demo_formula_cardenal_d_g" model="tint.color.formula">
            <field name="color_id" ref="demo_color_rojo_cardenal" />
            <field name="base_type_id" ref="tint_base_type_d" />
            <field name="size_id" ref="tint_size_gallon" />
        </record>
        <record id="demo_formula_cardenal_d_g_l1" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_cardenal_d_g" />
            <field name="colorant_id" ref="demo_colorant_red_oxide" />
            <field name="points">40</field>
            <field name="sequence">10</field>
        </record>
        <record id="demo_formula_cardenal_d_g_l2" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_cardenal_d_g" />
            <field name="colorant_id" ref="demo_colorant_black" />
            <field name="points">8</field>
            <field name="sequence">20</field>
        </record>

        <!-- Alternativa sobre base Accent, galón -->
        <record id="demo_formula_cardenal_a_g" model="tint.color.formula">
            <field name="color_id" ref="demo_color_rojo_cardenal" />
            <field name="base_type_id" ref="tint_base_type_a" />
            <field name="size_id" ref="tint_size_gallon" />
        </record>
        <record id="demo_formula_cardenal_a_g_l1" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_cardenal_a_g" />
            <field name="colorant_id" ref="demo_colorant_red_oxide" />
            <field name="points">62</field>
            <field name="sequence">10</field>
        </record>
        <record id="demo_formula_cardenal_a_g_l2" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_cardenal_a_g" />
            <field name="colorant_id" ref="demo_colorant_black" />
            <field name="points">14</field>
            <field name="sequence">20</field>
        </record>

        <!-- ============== Azul Marino ============== -->

        <record id="demo_color_azul_marino" model="tint.color">
            <field name="name">Azul Marino (demo)</field>
            <field name="html_color">#1B365D</field>
            <field name="collection_id" ref="demo_collection_interiores" />
        </record>

        <!-- Sobre base Accent, galón: 110 pts de 576 disponibles -->
        <record id="demo_formula_azul_a_g" model="tint.color.formula">
            <field name="color_id" ref="demo_color_azul_marino" />
            <field name="base_type_id" ref="tint_base_type_a" />
            <field name="size_id" ref="tint_size_gallon" />
        </record>
        <record id="demo_formula_azul_a_g_l1" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_azul_a_g" />
            <field name="colorant_id" ref="demo_colorant_phthalo_blue" />
            <field name="points">90</field>
            <field name="sequence">10</field>
        </record>
        <record id="demo_formula_azul_a_g_l2" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_azul_a_g" />
            <field name="colorant_id" ref="demo_colorant_black" />
            <field name="points">20</field>
            <field name="sequence">20</field>
        </record>

        <!-- ============== Arena ============== -->
        <!-- Pastel sobre base White en litro: 8 pts de 24 disponibles.
             Deja poca holgura, útil para probar el aviso de capacidad. -->

        <record id="demo_color_arena" model="tint.color">
            <field name="name">Arena (demo)</field>
            <field name="html_color">#D8C9A3</field>
            <field name="collection_id" ref="demo_collection_interiores" />
        </record>

        <record id="demo_formula_arena_w_l" model="tint.color.formula">
            <field name="color_id" ref="demo_color_arena" />
            <field name="base_type_id" ref="tint_base_type_w" />
            <field name="size_id" ref="tint_size_liter" />
        </record>
        <record id="demo_formula_arena_w_l_l1" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_arena_w_l" />
            <field name="colorant_id" ref="demo_colorant_yellow_oxide" />
            <field name="points">6</field>
            <field name="sequence">10</field>
        </record>
        <record id="demo_formula_arena_w_l_l2" model="tint.color.formula.line">
            <field name="formula_id" ref="demo_formula_arena_w_l" />
            <field name="colorant_id" ref="demo_colorant_red_oxide" />
            <field name="points">2</field>
            <field name="sequence">20</field>
        </record>

    </data>
</odoo>
