<odoo>
    <record id="stock_picking_form_tint_consumptions" model="ir.ui.view">
        <field name="name">stock.picking.form.tint.consumptions</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="tint_consumption_count" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
