<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Menú principal de Actividades -->
    <!-- Raíz del módulo: visible solo con el privilegio de Actividades (Usuario o
         Administrador). Si el privilegio está en "no", el usuario no ve el módulo. -->
    <menuitem
        id="menu_activity_root"
        name="Actividades"
        sequence="86"
        groups="entintados_pdv.group_activity_user"
        web_icon="entintados_pdv,static/description/icon_actividades.png"
    />

    <menuitem
        id="menu_activity_operations"
        name="Actividades"
        parent="menu_activity_root"
        sequence="10"
    />

    <!-- Acceso directo a las actividades del usuario -->
    <menuitem
        id="menu_activity_my"
        name="Mis actividades"
        parent="menu_activity_operations"
        action="mail_activity_action_my"
        sequence="10"
        groups="entintados_pdv.group_activity_user"
    />

    <!-- "Todas las actividades": solo para el administrador de actividades -->
    <menuitem
        id="menu_activity_all"
        name="Todas las actividades"
        parent="menu_activity_operations"
        action="mail_activity_action_all"
        sequence="20"
        groups="entintados_pdv.group_activity_manager"
    />

    <!-- Sección de Reportes: solo para el administrador de actividades -->
    <menuitem
        id="menu_activity_reporting"
        name="Reportes"
        parent="menu_activity_root"
        sequence="50"
        groups="entintados_pdv.group_activity_manager"
    />

    <menuitem
        id="menu_activity_analysis"
        name="Análisis de actividades"
        parent="menu_activity_reporting"
        action="mail_activity_action_analysis"
        sequence="10"
        groups="entintados_pdv.group_activity_manager"
    />

    <!-- Configuración: visible solo para el administrador de actividades -->
    <menuitem
        id="menu_activity_config"
        name="Configuración"
        parent="menu_activity_root"
        sequence="90"
        groups="entintados_pdv.group_activity_manager"
    />

    <menuitem
        id="menu_activity_type"
        name="Tipos de actividad"
        parent="menu_activity_config"
        action="mail.mail_activity_type_action"
        sequence="10"
        groups="entintados_pdv.group_activity_manager"
    />

    <menuitem
        id="menu_activity_plan"
        name="Planes de actividad"
        parent="menu_activity_config"
        action="mail.mail_activity_plan_action"
        sequence="20"
        groups="entintados_pdv.group_activity_manager"
    />
</odoo>
