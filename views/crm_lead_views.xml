<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retirar la vista de la integración CRM revertida antes de validar
         cualquier vista que herede el formulario de oportunidades. -->
    <delete model="ir.ui.view" id="crm_lead_material_tint_inline"/>

    <!-- Formulario principal de Lead/Oportunidad: tiene DOS campos partner_id
         distintos (uno se usa mientras type == 'lead', el otro mientras
         type == 'opportunity'); se restringen ambos por separado y se asegura
         que al crear un cliente nuevo se marque is_customer = True. -->
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.entintados_pdv</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_schedule_field_visit" string="Agendar visita de campo" type="object" invisible="(not active and probability == 0) or stage_type != 'visit'" class="btn btn-primary"/>
                <button name="action_schedule_demo_meeting" string="Agendar demostración" type="object" invisible="(not active and probability == 0) or picking_count > 0 or demo_meeting_scheduled or stage_type != 'demo'" class="btn btn-primary"/>
            </xpath>
            <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']" position="after">
                <page name="material" string="Solicitudes de materiales" invisible="(stage_type != 'demo' and not material_line_ids) or not demo_meeting_scheduled">
                    <field name="demo_meeting_scheduled" invisible="1"/>
                    <button name="action_request_material_output" string="Solicitud de salida" type="object" invisible="approval_request_id or not demo_meeting_scheduled" class="btn btn-primary"/>
                    <div class="d-flex align-items-center">
                        <label for="wharehouse_id" string="Almacén de origen: " class="me-3"/>
                        <field name="wharehouse_id" domain="[('usage', '=', 'internal')]"   readonly="approval_request_id"/>
                    </div>
                    <group>
                        <field name="material_line_ids" nolabel="1" readonly="approval_request_id">
                            <list string="Solicitudes de materiales" editable="bottom">
                                <field name="product_id" widget="crm_material_product"/>
                                <field name="code_product"/>
                                <field name="quantity"/>
                                <field name="uom_id" readonly="1" force_save="1"/>
                                <field name="qty_available_branch" widget="entintados_stock_availability" readonly="1" optional="show"/>
                                <field name="qty_available_company" widget="entintados_stock_availability" readonly="1" optional="hide"/>
                                <field name="description"/>
                                <field name="cost_currency_id" column_invisible="1"/>
                                <field name="standard_price" widget="monetary" options="{'currency_field': 'cost_currency_id'}" readonly="1"/>
                                <field name="subtotal" string="Costo total" widget="monetary" options="{'currency_field': 'cost_currency_id'}" sum="Total de costos" readonly="1"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_demo_cancellation" model="ir.ui.view">
        <field name="name">crm.lead.form.demo.cancellation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_cancel_demo" invisible="1"/>
                <field name="demo_end" invisible="1"/>
                <field name="stage_type" invisible="1"/>
                <field name="approval_request_id" invisible="1"/>
                <button name="action_cancel_demo" type="object" string="Cancelar demostración"
                        invisible="not can_cancel_demo or not active or demo_end or (stage_type != 'demo' and not approval_request_id)"
                        confirm="Cancelar la demostración marcará automáticamente esta oportunidad como perdida y cancelará sus aprobaciones y salidas de material pendientes. ¿Deseas continuar?"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not can_cancel_demo or not active or demo_end or (stage_type != 'demo' and not approval_request_id)">
                    Cancelar la demostración, su aprobación o su salida de material marcará automáticamente esta oportunidad como perdida.
                </div>
            </xpath>
        </field>
    </record>

    <!-- Formulario de creación rápida (Kanban > Nueva oportunidad): tiene
         "Company" (commercial_partner_id) y "Contact" (partner_id). El
         segundo ya trae un domain dinámico propio de CRM (solo contactos que
         no sean empresa, y si hay compañía seleccionada, hijos de esa
         compañía); se extiende sin perder esa lógica, no se reemplaza. -->
    <record id="quick_create_opportunity_form" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create.inherit.entintados_pdv</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='commercial_partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True), ('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_company': True, 'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '!=', True), ('is_sales_contact', '=', True)] + (
                    [('id', 'child_of', commercial_partner_id)] if commercial_partner_id else []
                )</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
        </field>
    </record>

    

    <record id="crm_lead_view_form_quotation_requirements" model="ir.ui.view">
        <field name="name">crm.lead.form.quotation.requirements</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="required">stage_type == 'quotation'</attribute>
            </xpath>

            <!-- <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            
            <xpath expr="//field[@name='tag_ids']" position="before">
                <xpath expr="//field[@name='source_id']" position="move"/>
            </xpath>

            <xpath expr="//group[field[@name='campaign_id'] and field[@name='medium_id']]/field[@name='source_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_quotation_smart_button" model="ir.ui.view">
        <field name="name">crm.lead.form.quotation.smart.button</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
                <attribute name="invisible">draft_quotation_count == 0</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_inherit_stock_picking" model="ir.ui.view">
        <field name="name">crm.lead.form.stock.picking</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_pickings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="picking_count == 0">

                    <field
                        name="picking_count"
                        string="Salidas"
                        widget="statinfo"
                    />

                </button>

                <button name="action_view_approval_request"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="demo_approval_count == 0">
                    <field name="demo_approval_count" widget="statinfo" string="Aprobaciones"/>
                </button>
            
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_hide_quotation_button" model="ir.ui.view">
        <field name="name">crm.lead.form.hide.quotation.button</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">(not active and probability == 0) or ((demo_meeting_scheduled or approval_request_id) and not demo_end)</attribute>
            </xpath>
        </field>
    </record>
</odoo>
