<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario principal de Lead/Oportunidad: tiene DOS campos partner_id
         distintos (uno se usa mientras type == 'lead', el otro mientras
         type == 'opportunity'); se restringen ambos por separado y se asegura
         que al crear un cliente nuevo se marque is_customer = True. -->
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.entintados_pdv</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="field_visit_scheduled" invisible="1"/>
                <button name="action_schedule_field_visit" string="Agendar visita de campo" type="object" invisible="stage_type != 'visit' or field_visit_scheduled"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="after">
                <page name="material" string="Solicitudes de materiales" invisible="stage_type != 'demo' and not material_line_ids">
                    <field name="demo_meeting_scheduled" invisible="1"/>
                    <button name="action_schedule_demo_meeting" string="Agendar demostración" type="object" invisible="picking_count > 0 or demo_meeting_scheduled"/>
                    <button name="action_request_material_output" string="Solicitud de salida" type="object" invisible="picking_count > 0 or not demo_meeting_scheduled"/>
                    <group>
                        <field name="material_line_ids" nolabel="1" readonly="picking_count > 0">
                            <list string="Solicitudes de materiales" editable="bottom">
                                <field name="product_id"/>
                                <field name="code_product"/>
                                <field name="quantity"/>
                                <field name="uom_id" readonly="1" force_save="1"/>
                                <field name="description"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Formulario de creación rápida (Kanban > Nueva oportunidad): tiene
         "Company" (commercial_partner_id) y "Contact" (partner_id). El
         segundo ya trae un domain dinámico propio de CRM (solo contactos que
         no sean empresa, y si hay compañía seleccionada, hijos de esa
         compañía); se extiende sin perder esa lógica, no se reemplaza. -->
    <record id="quick_create_opportunity_form" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create.inherit.entintados_pdv</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='commercial_partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True), ('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_company': True, 'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '!=', True), ('is_sales_contact', '=', True)] + (
                    [('id', 'child_of', commercial_partner_id)] if commercial_partner_id else []
                )</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
        </field>
    </record>

    

    <record id="crm_lead_view_form_quotation_requirements" model="ir.ui.view">
        <field name="name">crm.lead.form.quotation.requirements</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="required">stage_type == 'quotation'</attribute>
            </xpath>

            <!-- <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            
            <xpath expr="//field[@name='tag_ids']" position="before">
                <xpath expr="//field[@name='source_id']" position="move"/>
            </xpath>

            <xpath expr="//group[field[@name='campaign_id'] and field[@name='medium_id']]/field[@name='source_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_quotation_smart_button" model="ir.ui.view">
        <field name="name">crm.lead.form.quotation.smart.button</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
                <attribute name="invisible">draft_quotation_count == 0</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_inherit_stock_picking" model="ir.ui.view">
        <field name="name">crm.lead.form.stock.picking</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_pickings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="picking_count == 0">

                    <field
                        name="picking_count"
                        string="Salidas"
                        widget="statinfo"
                    />

                </button>
            </xpath>
        </field>
    </record>

</odoo>
