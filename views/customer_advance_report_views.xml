<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_advance_preview_report" model="account.report">
        <field name="name">Facturas de anticipos</field>
        <field name="custom_handler_model_id" ref="model_account_customer_advance_report_handler"/>
        <field name="filter_date_range" eval="False"/>
        <field name="default_opening_date_filter">today</field>
        <field name="filter_partner" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_hierarchy">never</field>
        <field name="load_more_limit">80</field>
        <field name="column_ids">
            <record id="customer_advance_preview_invoice_date" model="account.report.column">
                <field name="name">Fecha de factura</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
                <field name="sequence">10</field>
            </record>
            <record id="customer_advance_preview_total" model="account.report.column">
                <field name="name">Total</field>
                <field name="expression_label">amount_total</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">20</field>
            </record>
            <record id="customer_advance_preview_available" model="account.report.column">
                <field name="name">Saldo disponible</field>
                <field name="expression_label">advance_available</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">30</field>
            </record>
            <record id="customer_advance_preview_applied" model="account.report.column">
                <field name="name">Saldo utilizado</field>
                <field name="expression_label">advance_applied</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">40</field>
            </record>
        </field>
    </record>
    <record id="action_customer_advance_preview_report" model="ir.actions.client">
        <field name="name">Facturas de anticipos</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('customer_advance_preview_report')}"/>
    </record>
</odoo>
