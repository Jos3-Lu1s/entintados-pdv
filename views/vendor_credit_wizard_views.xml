<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vendor_credit_wizard_form" model="ir.ui.view">
        <field name="name">vendor.credit.group.form</field>
        <field name="model">vendor.credit.group</field>
        <field name="arch" type="xml">
            <form string="Nota de crédito agrupada">
                <header>
                    <button name="action_create_credit" type="object" string="Crear nota en borrador" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_credit" type="object" string="Ver nota de crédito" invisible="not credit_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                
                <div class="oe_title">
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                </div>
            
                <group>
                    <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                    <field name="company_id" readonly="state != 'draft'" invisible="1"/>
                    <field name="partner_id" readonly="state != 'draft'" domain="[('is_purchase_contact', '=', True), ('distributed_notes', '=', True)]" options="{'no_create': True}"/>
                    <field name="currency_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                    <field name="journal_id" readonly="state != 'draft'" domain="[('type', '=', 'purchase'), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                    <field name="date" readonly="state != 'draft'"/>
                    <field name="reason" readonly="state != 'draft'"/>
                    <field name="credit_id" readonly="1" invisible="not credit_id"/>
                </group>
                <div class="alert alert-info">
                    Marca las facturas que se incluirán en la nota de crédito. Puedes ajustar el
                    importe con impuestos de cada una; se distribuirá proporcionalmente entre sus
                    líneas. Se creará una sola nota en borrador; después de contabilizarla podrás
                    conciliarla con las facturas.
                </div>
                <field name="line_ids" readonly="state != 'draft'">
                    <list editable="bottom" create="0" delete="0" decoration-muted="not selected">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="selected"/>
                        <field name="invoice_id" readonly="1" force_save="1"/>
                        <field name="residual"/>
                        <field name="amount" readonly="not selected" force_save="1"/>
                    </list>
                </field>
                <group><field name="amount_total"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="vendor_credit_group_list" model="ir.ui.view">
        <field name="name">vendor.credit.group.list</field>
        <field name="model">vendor.credit.group</field>
        <field name="arch" type="xml">
            <list string="Notas de crédito agrupadas">
                <field name="date"/>
                <field name="reason"/>
                <field name="partner_id" domain="[('distributed_notes', '=', True)]"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"/>
                <field name="credit_id"/>
            </list>
        </field>
    </record>
    <record id="vendor_credit_group_company_rule" model="ir.rule">
        <field name="name">Notas agrupadas: compañías permitidas</field>
        <field name="model_id" ref="model_vendor_credit_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="vendor_credit_group_line_company_rule" model="ir.rule">
        <field name="name">Líneas de notas agrupadas: compañías permitidas</field>
        <field name="model_id" ref="model_vendor_credit_group_line"/>
        <field name="domain_force">[('group_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="vendor_credit_wizard_action" model="ir.actions.act_window">
        <field name="name">Nota de crédito agrupada</field>
        <field name="res_model">vendor.credit.group</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>
    <menuitem id="vendor_credit_wizard_menu" name="Nota de crédito agrupada" parent="account.menu_finance_payables" action="vendor_credit_wizard_action" sequence="5" groups="account.group_account_invoice"/>
    <record id="account_move_vendor_credit_sources" model="ir.ui.view">
        <field name="name">account.move.vendor.credit.sources</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Facturas de origen" invisible="move_type != 'in_refund' or not vendor_credit_source_ids">
                    <field name="vendor_credit_source_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
