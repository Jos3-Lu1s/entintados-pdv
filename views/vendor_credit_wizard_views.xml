<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vendor_credit_wizard_form" model="ir.ui.view">
        <field name="name">vendor.credit.group.form</field>
        <field name="model">vendor.credit.group</field>
        <field name="arch" type="xml">
            <form string="Nota de crédito agrupada">
                <header>
                    <button name="action_create_credit" type="object" string="Generar y conciliar notas" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_credit" type="object" string="Ver notas de crédito" invisible="credit_count == 0"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state == 'cancel'" confirm="Se cancelarán las notas relacionadas y se desvincularán las facturas. Las notas contabilizadas se regresarán a borrador y se desconciliarán. ¿Continuar?"/>
                    <button name="action_draft" type="object" string="Restablecer a borrador" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,cancel"/>
                </header>
                <sheet>

                <div class="oe_button_box" name="button_box">
                    <button name="action_view_invoices" type="object" class="oe_stat_button"
                            icon="fa-file-text-o" invisible="invoice_count == 0">
                        <field name="invoice_count" widget="statinfo" string="Facturas"/>
                    </button>
                    <button name="action_open_credit" type="object" class="oe_stat_button"
                            icon="fa-pencil-square-o" invisible="credit_count == 0">
                        <field name="credit_count" widget="statinfo" string="Notas de crédito"/>
                    </button>
                </div>

                <div class="oe_title mb-4">
                    <div class="text-muted mb-1">NOTA DE CRÉDITO AGRUPADA</div>
                    <h1><field name="name" readonly="1"/></h1>
                    <p class="text-muted">Selecciona las facturas del proveedor y define el importe a acreditar.</p>
                </div>

                <group>
                    <group string="Proveedor y compañía">
                        <field name="partner_id" readonly="state != 'draft'" domain="[('is_purchase_contact', '=', True), ('distributed_notes', '=', True)]" options="{'no_create': True}" placeholder="Selecciona un proveedor"/>
                        <field name="company_id" string="Compañía" readonly="state != 'draft'" groups="base.group_multi_company"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" string="Moneda" readonly="state != 'draft'" options="{'no_create': True}"/>
                    </group>
                    <group string="Datos de la nota">
                        <field name="journal_id" readonly="state != 'draft'" domain="[('type', '=', 'purchase'), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
                        <field name="date" readonly="state != 'draft'"/>
                        <field name="reason" readonly="state != 'draft'" placeholder="Por ejemplo: bonificación del proveedor"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="status" invisible="state != 'cancel'">
                    <strong>Agrupación cancelada.</strong>
                    Puedes restablecer esta agrupación a borrador para cambiar los importes o la
                    selección de facturas. Al generar nuevamente, se crearán nuevas notas;
                    las anteriores permanecerán canceladas.
                </div>
                <div class="alert alert-info d-flex gap-2" role="status" invisible="state != 'draft'">
                    <i class="fa fa-info-circle mt-1" aria-hidden="true"/>
                    <div>
                        Se generará una nota por cada factura seleccionada, con contabilización y conciliación automáticas.
                        Los importes incluyen impuestos y se distribuyen proporcionalmente entre las líneas de cada factura.
                    </div>
                </div>
                <div class="alert alert-success" role="status" invisible="state != 'generated'">
                    <i class="fa fa-check-circle me-1" aria-hidden="true"/>
                    Las notas de crédito fueron generadas y conciliadas con sus facturas.
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4 mb-3">
                    <div>
                        <h3 class="mb-1">Facturas del proveedor</h3>
                        <span class="text-muted">Facturas con pago parcial. Ajusta el importe de las que deseas incluir.</span>
                    </div>
                    <button name="action_toggle_invoice_selection" type="object" class="btn btn-secondary"
                            invisible="state != 'draft' or not line_ids">
                        <i class="fa fa-check-square-o me-1" aria-hidden="true"/>
                        <field name="selection_toggle_label" readonly="1" nolabel="1" class="oe_inline"/>
                    </button>
                </div>
                <field name="line_ids" readonly="state != 'draft'">
                    <list editable="bottom" create="0" delete="0" decoration-muted="not selected">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="selected"/>
                        <field name="invoice_id" readonly="1" force_save="1"/>
                        <field name="residual"/>
                        <field name="amount" readonly="not selected" force_save="1"/>
                        <field name="invoice_total" readonly="1"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer oe_right mt-3">
                    <field name="invoice_count" string="Facturas seleccionadas" readonly="1"/>
                    <field name="amount_total" widget="monetary" class="oe_subtotal_footer_separator" readonly="1"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="vendor_credit_group_list" model="ir.ui.view">
        <field name="name">vendor.credit.group.list</field>
        <field name="model">vendor.credit.group</field>
        <field name="arch" type="xml">
            <list string="Notas de crédito agrupadas">
                <field name="date"/>
                <field name="reason"/>
                <field name="partner_id" domain="[('distributed_notes', '=', True)]"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" optional="hide"/>
                <field name="amount_total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'generated'" decoration-muted="state == 'cancel'"/>
                <field name="credit_count" string="Notas de crédito"/>
            </list>
        </field>
    </record>
    <record id="vendor_credit_group_company_rule" model="ir.rule">
        <field name="name">Notas agrupadas: compañías permitidas</field>
        <field name="model_id" ref="model_vendor_credit_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="vendor_credit_group_line_company_rule" model="ir.rule">
        <field name="name">Líneas de notas agrupadas: compañías permitidas</field>
        <field name="model_id" ref="model_vendor_credit_group_line"/>
        <field name="domain_force">[('group_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="vendor_credit_wizard_action" model="ir.actions.act_window">
        <field name="name">Nota de crédito agrupada</field>
        <field name="res_model">vendor.credit.group</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>
    <menuitem id="vendor_credit_wizard_menu" name="Nota de crédito agrupada" parent="account.menu_finance_payables" action="vendor_credit_wizard_action" sequence="5" groups="account.group_account_invoice"/>
    <record id="account_move_vendor_credit_sources" model="ir.ui.view">
        <field name="name">account.move.vendor.credit.sources</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Facturas de origen" invisible="move_type != 'in_refund' or not vendor_credit_source_ids">
                    <field name="vendor_credit_source_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
