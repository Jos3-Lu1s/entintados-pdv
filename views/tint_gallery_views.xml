<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="tint_gallery_view_list" model="ir.ui.view">
        <field name="name">tint.gallery.list</field>
        <field name="model">tint.gallery</field>
        <field name="arch" type="xml">
            <list string="Galerías de fórmulas">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="kind" />
                <field name="color_count" string="Colores" />
                <field name="formula_count" string="Fórmulas" />
            </list>
        </field>
    </record>

    <record id="tint_gallery_view_form" model="ir.ui.view">
        <field name="name">tint.gallery.form</field>
        <field name="model">tint.gallery</field>
        <field name="arch" type="xml">
            <form string="Galería de fórmulas">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archivada"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_formulas"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-flask"
                        >
                            <field name="formula_count" widget="statinfo" string="Fórmulas" />
                        </button>
                        <button
                            name="action_open_formulas"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-paint-brush"
                        >
                            <field name="color_count" widget="statinfo" string="Colores" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="p. ej. Galería Milenium" />
                        </h1>
                        <h3>
                            <field name="code" placeholder="MIL" />
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="kind" />
                        </group>
                        <group>
                            <!-- El orden se ajusta arrastrando en la lista. -->
                            <field name="sequence" invisible="1" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="kind != 'legacy'"
                    >
                        Una galería histórica agrupa colores que ya no están en la
                        carta comercial pero que se siguen reproduciendo bajo pedido.
                    </div>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tint_gallery_view_search" model="ir.ui.view">
        <field name="name">tint.gallery.search</field>
        <field name="model">tint.gallery</field>
        <field name="arch" type="xml">
            <search string="Buscar galería">
                <field name="name" />
                <field name="code" />
                <separator />
                <filter name="own" string="Propias" domain="[('kind', '=', 'own')]" />
                <filter
                    name="competitor"
                    string="De competencia"
                    domain="[('kind', '=', 'competitor')]"
                />
                <filter
                    name="legacy"
                    string="Históricas"
                    domain="[('kind', '=', 'legacy')]"
                />
                <separator />
                <filter
                    name="inactive"
                    string="Archivadas"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        name="group_kind"
                        string="Origen"
                        domain="[]"
                        context="{'group_by': 'kind'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="tint_gallery_action" model="ir.actions.act_window">
        <field name="name">Galerías</field>
        <field name="res_model">tint.gallery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tint_gallery_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre una galería</p>
            <p>
                Una galería agrupa las fórmulas según su origen: el catálogo
                propio, el de un fabricante de la competencia, los colores
                descontinuados que aún se reproducen, o los desarrollos internos.
            </p>
            <p>
                No confundir con las colecciones, que agrupan colores en cartas
                comerciales. Un mismo color puede tener fórmulas distintas en
                varias galerías.
            </p>
        </field>
    </record>

</odoo>
