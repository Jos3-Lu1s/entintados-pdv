<odoo>
    <record id="sales_collection_report" model="account.report">
        <field name="name">Cobranza por vendedor</field>
        <field name="custom_handler_model_id" ref="model_account_sales_collection_report_handler"/>
        <field name="filter_date_range" eval="False"/>
        <field name="default_opening_date_filter">today</field>
        <field name="filter_partner" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_show_draft" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_hierarchy">never</field>
        <field name="load_more_limit">80</field>
        <field name="column_ids">
            <record id="sales_collection_column_invoice_date" model="account.report.column">
                <field name="name">Fecha</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
                <field name="sequence">10</field>
            </record>
            <record id="sales_collection_column_last_payment" model="account.report.column">
                <field name="name">Fecha último pago</field>
                <field name="expression_label">last_payment</field>
                <field name="figure_type">date</field>
                <field name="sequence">20</field>
            </record>
            <record id="sales_collection_column_total" model="account.report.column">
                <field name="name">Total</field>
                <field name="expression_label">total</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">50</field>
            </record>
            <record id="sales_collection_column_commission_margin" model="account.report.column">
                <field name="name">Margen</field>
                <field name="expression_label">commission_margin</field>
                <field name="figure_type">percentage</field>
                <field name="sequence">60</field>
            </record>
            <record id="sales_collection_column_commission_rate" model="account.report.column">
                <field name="name">Porcentaje de comisión</field>
                <field name="expression_label">commission_rate</field>
                <field name="figure_type">percentage</field>
                <field name="sequence">70</field>
            </record>
            <record id="sales_collection_column_commission_delay" model="account.report.column">
                <field name="name">Días de atraso</field>
                <field name="expression_label">commission_delay</field>
                <field name="figure_type">integer</field>
                <field name="sequence">80</field>
            </record>
            <record id="sales_collection_column_commission_goal" model="account.report.column">
                <field name="name">Meta comercial</field>
                <field name="expression_label">commission_goal</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">90</field>
            </record>
            <record id="sales_collection_column_commission_scope" model="account.report.column">
                <field name="name">Alcance</field>
                <field name="expression_label">commission_scope</field>
                <field name="figure_type">percentage</field>
                <field name="sequence">100</field>
            </record>
            <record id="sales_collection_column_commission_amount" model="account.report.column">
                <field name="name">Comisión</field>
                <field name="expression_label">commission_amount</field>
                <field name="figure_type">monetary</field>
                <field name="sequence">110</field>
            </record>
        </field>
    </record>
    <record id="action_sales_collection_report" model="ir.actions.client">
        <field name="name">Cobranza por vendedor</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('sales_collection_report')}"/>
    </record>
    <menuitem id="menu_sales_collection_report" name="Cobranza por vendedor" parent="sale.menu_sale_report"
              action="action_sales_collection_report" sequence="40"
              groups="group_sales_collection_own,-account.group_account_readonly,-account.group_account_basic"/>
</odoo>
