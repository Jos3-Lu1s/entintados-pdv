<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_credit_reason_company_rule" model="ir.rule">
        <field name="name">Motivos de clientes: compañías permitidas</field>
        <field name="model_id" ref="model_customer_credit_reason"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="customer_credit_reason_list" model="ir.ui.view">
        <field name="name">customer.credit.reason.list</field><field name="model">customer.credit.reason</field>
        <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="customer_credit_reason_form" model="ir.ui.view">
        <field name="name">customer.credit.reason.form</field><field name="model">customer.credit.reason</field>
        <field name="arch" type="xml"><form string="Motivo de crédito de cliente"><sheet><group><field name="name"/><field name="sequence"/><field name="company_id"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="customer_credit_reason_action" model="ir.actions.act_window">
        <field name="name">Motivos de notas de crédito de clientes</field><field name="res_model">customer.credit.reason</field><field name="view_mode">list,form</field>
    </record>
    <record id="customer_adjustment_reason_catalog" model="ir.ui.view">
        <field name="name">customer.adjustment.reason.catalog</field><field name="model">customer.account.adjustment</field>
        <field name="inherit_id" ref="customer_account_adjustment_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='reason']" position="before"><field name="reason_id" readonly="state != 'draft'" required="state == 'draft'" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/></xpath><xpath expr="//field[@name='reason']" position="attributes"><attribute name="string">Descripción del motivo</attribute></xpath></field>
    </record>
    <record id="customer_ticket_return_reason_catalog" model="ir.ui.view">
        <field name="name">customer.ticket.return.reason.catalog</field><field name="model">pos.accounting.return</field>
        <field name="inherit_id" ref="pos_accounting_return_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='reason']" position="before"><field name="reason_id" readonly="state != 'draft'" required="state == 'draft'" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/></xpath><xpath expr="//field[@name='reason']" position="attributes"><attribute name="string">Descripción del motivo</attribute></xpath></field>
    </record>
    <record id="customer_credit_move_reason_catalog" model="ir.ui.view">
        <field name="name">customer.credit.move.reason.catalog</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='invoice_origin']" position="after"><field name="customer_credit_reason_id" invisible="move_type != 'out_refund'" readonly="state != 'draft'" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/></xpath></field>
    </record>
    <record id="customer_credit_reversal_reason_catalog" model="ir.ui.view">
        <field name="name">customer.credit.reversal.reason.catalog</field><field name="model">account.move.reversal</field><field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='reason']" position="before"><field name="customer_credit_reason_id" invisible="move_type not in ('out_invoice', 'some_invoice')" required="move_type == 'out_invoice'" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/></xpath></field>
    </record>
</odoo>
