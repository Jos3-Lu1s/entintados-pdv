<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista -->
    <record id="view_product_schema_list" model="ir.ui.view">
        <field name="name">product.schema.list</field>
        <field name="model">product.schema</field>
        <field name="arch" type="xml">
            <list string="Esquemas de Producto">
                <field name="name" />
                <field name="product_discount" />
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_product_schema_form" model="ir.ui.view">
        <field name="name">product.schema.form</field>
        <field name="model">product.schema</field>
        <field name="arch" type="xml">
            <form string="Esquema de Producto">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="product_discount" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_product_schema" model="ir.actions.act_window">
        <field name="name">Esquemas de Producto</field>
        <field name="res_model">product.schema</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>