<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.view.form.inherit.entintados_pdv</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='partner_address_country']/../../.." position="after">
                    <div class="row g-3">

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-shopping-cart text-muted" title="Cliente"/>
                                <label for="is_customer" class="mb-0">Cliente</label>
                                <field class="mt-2" name="is_customer" widget="boolean_toggle" nolabel="1"/>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-truck text-muted" title="Proveedor"/>
                                <label for="is_supplier" class="mb-0">Proveedor</label>
                                <field class="mt-2" name="is_supplier" widget="boolean_toggle" nolabel="1"/>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-money text-muted" title="Acreedor"/>
                                <label for="is_creditor" class="mb-0">Acreedor</label>
                                <field class="mt-2" name="is_creditor" widget="boolean_toggle" nolabel="1"/>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-share-alt text-muted" title="Distribuidor"/>
                                <label for="is_distributor" class="mb-0">Distribuidor</label>
                                <field class="mt-2" name="is_distributor" widget="boolean_toggle" nolabel="1"/>
                            </div>
                        </div>

                    </div>
                </xpath>
            </field>
        </record>

        <record id="res_partner_view_search" model="ir.ui.view">
            <field name="name">res.partner.view.search.inherit.entintados_pdv</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.res_partner_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='customer']" position="replace">
                    <group>
                        <filter string="Clientes y distribuidores" name="customer"
                                domain="[('is_sales_contact', '=', True)]"
                                invisible="context.get('res_partner_search_mode') == 'supplier'"/>
                        <filter string="Clientes" name="only_customer"
                                domain="[('is_customer', '=', True)]"
                                invisible="context.get('res_partner_search_mode') == 'supplier'"/>
                        <filter string="Distribuidores" name="only_distributor"
                                domain="[('is_distributor', '!=', False)]"
                                invisible="context.get('res_partner_search_mode') == 'supplier'"/>
                    </group>
                </xpath>
                <xpath expr="//filter[@name='supplier']" position="replace">
                    <group>
                        <filter string="Proveedores y acreedores" name="supplier"
                                domain="[('is_purchase_contact', '=', True)]"
                                invisible="context.get('res_partner_search_mode') == 'customer'"/>
                        <filter string="Proveedores" name="only_supplier"
                                domain="[('is_supplier', '!=', False)]"
                                invisible="context.get('res_partner_search_mode') == 'customer'"/>
                        <filter string="Acreedores" name="only_creditor"
                                domain="[('is_creditor', '!=', False)]"
                                invisible="context.get('res_partner_search_mode') == 'customer'"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- A un contacto creado desde el menú "Clientes"/"Proveedores" de
             Contabilidad hay que marcarlo con nuestros campos también,
             o desaparecería de inmediato del filtro que acabamos de cambiar. -->
        <record id="account.res_partner_action_customer" model="ir.actions.act_window">
            <field name="domain">[('is_sales_contact', '=', True)]</field>
            <field name="context">{'search_default_customer': 1, 'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1, 'default_is_customer': True}</field>
        </record>

        <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
            <field name="domain">[('is_purchase_contact', '=', True)]</field>
            <field name="context">{'search_default_supplier': 1, 'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1, 'default_is_supplier': True}</field>
        </record>
    </data>
</odoo>
