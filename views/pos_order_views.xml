<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_collection_payments" model="ir.ui.view">
        <field name="name">pos.order.collection.payments</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoice_collection_payments" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="not invoice_collection_processed" groups="account.group_account_invoice,account.group_account_readonly">
                    <div class="o_stat_info"><span class="o_stat_text">Abonos a facturas</span></div>
                </button>
            </xpath>
            <xpath expr="//field[@name='pos_reference']" position="after">
                <field name="invoice_collection_processed" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_pos_order_form_previous_reference" model="ir.ui.view">
        <field name="name">pos.order.form.previous.reference</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_reference']" position="after">
                <field name="previous_order_reference" readonly="1" invisible="not previous_order_reference"/>
            </xpath>
        </field>
    </record>
    <record id="view_pos_order_form_credit_waiting" model="ir.ui.view">
        <field name="name">pos.order.form.credit.waiting</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible" add="credit_waiting_state" separator=" or "/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="credit_waiting_state" widget="statusbar" readonly="1"
                       invisible="not credit_waiting_state" statusbar_visible="waiting"/>
            </xpath>
        </field>
    </record>
    <record id="view_pos_order_form_entintados_invoices" model="ir.ui.view">
        <field name="name">pos.order.form.entintados.invoices</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[(@name='action_view_invoice' or @name='action_view_invoice_custom') and hasclass('oe_stat_button')]" position="attributes">
                <attribute name="name">action_view_invoice</attribute>
            </xpath>
        </field>
    </record>
        <record id="view_pos_order_split_invoice_wizard_form" model="ir.ui.view">
        <field name="name">pos.order.split.invoice.wizard.form</field>
        <field name="model">pos.order.split.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar en varias facturas">
                <group>
                    <field name="order_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount_total"/>
                    <field name="invoice_count"/>
                    <field name="amount_per_invoice"/>
                </group>
                <div class="text-muted">
                    Las cantidades de cada línea se reparten en partes iguales y la última
                    factura absorbe el redondeo. El pago de la orden se concilia con todas las facturas.
                </div>
                <footer>
                    <button string="Generar facturas" name="action_confirm" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_pos_order_form_split_invoice_button" model="ir.ui.view">
        <field name="name">pos.order.form.split.invoice.button</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_refund" invisible="1"/>
                <field name="entintados_invoice_count" invisible="1"/>
                <button name="action_open_split_invoice_wizard" type="object"
                        string="Dividir en facturas"
                        invisible="entintados_invoice_count &gt; 0 or state not in ('paid', 'done') or is_refund"/>
            </xpath>
        </field>
    </record>
</odoo>
