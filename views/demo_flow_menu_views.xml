<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_demo_flow_crm" model="ir.actions.act_window">
        <field name="name">Oportunidades de demostración</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_demo_flow', '=', True)]</field>
    </record>
    <!-- This is a CRM entry, not a separate application. Keep its existing XML ID
         so bookmarks continue to work when upgrading an existing database. -->
    <menuitem id="menu_demo_flow_crm" name="Demostraciones" parent="crm.crm_menu_sales"
              action="action_demo_flow_crm" sequence="25"
              groups="entintados_pdv.group_demo_user"/>
    <!-- Approvals and warehouse outputs already have their native entries.
         Optional references make cleanup harmless on a fresh installation. -->
    <delete model="ir.ui.menu" search="[('id', '=', ref('entintados_pdv.menu_demo_flow_approvals', False))]"/>
    <delete model="ir.ui.menu" search="[('id', '=', ref('entintados_pdv.menu_demo_flow_outputs', False))]"/>
    <delete model="ir.ui.menu" search="[('id', '=', ref('entintados_pdv.menu_demo_flow', False))]"/>
</odoo>
