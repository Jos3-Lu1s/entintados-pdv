<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Vista de lista -->
    <record id="view_lines_schema_list" model="ir.ui.view">
        <field name="name">lines.schema.list</field>
        <field name="model">lines.schema</field>
        <field name="arch" type="xml">
            <list string="Líneas de Esquema de Producto">
                <field name="name" />
                <field name="schema_id" />
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_lines_schema_form" model="ir.ui.view">
        <field name="name">lines.schema.form</field>
        <field name="model">lines.schema</field>
        <field name="arch" type="xml">
            <form string="Línea de Esquema de Producto">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="schema_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_lines_schema" model="ir.actions.act_window">
        <field name="name">Líneas de Esquema de Producto</field>
        <field name="res_model">lines.schema</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>