<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_product_line_list_inherit_availability" model="ir.ui.view">
        <field name="name">approval.product.line.list.inherit.availability</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="qty_available_branch" widget="entintados_stock_availability" readonly="1" optional="show"/>
                <field name="qty_available_company" widget="entintados_stock_availability" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="approval_product_line_list_independent_inherit_availability" model="ir.ui.view">
        <field name="name">approval.product.line.list.independent.inherit.availability</field>
        <field name="model">approval.product.line</field>
        <field name="inherit_id" ref="approvals.approval_product_line_view_tree_independent"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="qty_available_branch" widget="entintados_stock_availability" readonly="1" optional="show"/>
                <field name="qty_available_company" widget="entintados_stock_availability" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="approval_request_view_form_crm_cancellation" model="ir.ui.view">
        <field name="name">approval.request.form.crm.cancellation</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="crm_lead_id" invisible="1"/>
                <field name="can_cancel_demo" invisible="1"/>
                <field name="can_reject_demo" invisible="1"/>
                <button name="action_reject_demo" type="object" string="Rechazar y devolver a CRM" invisible="not crm_lead_id or not can_reject_demo or request_status != 'pending'" confirm="La solicitud regresará a CRM para corregir los productos. La oportunidad seguirá activa."/>
                <button name="action_cancel" type="object" string="Cancelar demostración"
                        invisible="not crm_lead_id or not can_cancel_demo or request_status in ['cancel', 'refused']"
                        confirm="Cancelar esta aprobación cancelará la demostración y marcará automáticamente la oportunidad de CRM como perdida. ¿Deseas continuar?"/>
            </xpath>
            <xpath expr="//button[@name='action_refuse' and @data-hotkey='z']" position="attributes">
                <attribute name="invisible">crm_lead_id or request_status in ['approved', 'refused', 'cancel'] or user_status != 'pending'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel' and @data-hotkey='x']" position="attributes">
                <attribute name="invisible">crm_lead_id or request_status in ['new', 'cancel'] or request_owner_id != uid</attribute>
            </xpath>
        </field>
    </record>




    <record id="approval_request_view_form_inherit_stock" model="ir.ui.view">
        <field name="name">approval.request.view.form.inherit.stock</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_picking"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="picking_count == 0">
                    <field name="picking_count" widget="statinfo" string="Salida de Almacén"/>
                </button>
            </xpath>
        </field>
    </record>
    
    <record id="approval_request_view_form_inherit_material" model="ir.ui.view">
        <field name="name">approval.request.form.material.crm</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_crm_lead"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bullhorn"
                        invisible="not crm_lead_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Oportunidad</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
