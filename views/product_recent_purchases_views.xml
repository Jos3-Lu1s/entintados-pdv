<odoo>
    <record id="product_purchase_cost_list" model="ir.ui.view">
        <field name="name">purchase.order.line.product.cost.list</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Costos de compra por producto" create="0" edit="0" delete="0"
                  default_group_by="product_id" default_order="date_approve desc, id desc">
                <field name="product_id" string="Producto" widget="many2one"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="order_id" string="Orden de compra"/>
                <field name="date_approve" string="Fecha de confirmación"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="product_uom_id" string="Unidad"/>
                <field name="currency_id" string="Moneda"/>
                <field name="price_unit" string="Precio unitario" widget="monetary"/>
                <groupby name="product_id">
                    <button type="edit" name="edit" string="Abrir producto"/>
                </groupby>
            </list>
        </field>
    </record>
    <record id="product_purchase_cost_search" model="ir.ui.view">
        <field name="name">purchase.order.line.product.cost.search</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="order_id"/>
                <group>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_supplier" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_product_purchase_costs" model="ir.actions.act_window">
        <field name="name">Costos de compra por producto</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_purchase_cost_list"/>
        <field name="search_view_id" ref="product_purchase_cost_search"/>
        <field name="domain">[('order_id.state', '=', 'purchase'), ('product_id.purchase_ok', '=', True), ('display_type', '=', False), ('is_downpayment', '=', False)]</field>
    </record>
    <record id="action_open_recent_product_purchase_costs" model="ir.actions.server">
        <field name="name">Costos de compra por producto</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = env['ir.actions.actions']._for_xml_id('entintados_pdv.action_product_purchase_costs')
action['domain'] = model._recent_product_purchase_cost_domain()
        ]]></field>
    </record>
    <menuitem id="menu_product_purchase_costs" name="Costos de compra por producto"
              parent="purchase.menu_purchase_products" action="action_open_recent_product_purchase_costs"
              sequence="30" groups="purchase.group_purchase_user"/>
    <record id="product_recent_purchases_list" model="ir.ui.view">
        <field name="name">purchase.order.product.recent.list</field>
        <field name="model">purchase.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Últimas compras" create="0" delete="0" default_order="date_approve desc, id desc">
                <field name="name" string="Orden de compra"/>
                <field name="date_approve" string="Confirmada el"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" string="Total de la orden"/>
            </list>
        </field>
    </record>
    <record id="product_template_recent_purchases_form" model="ir.ui.view">
        <field name="name">product.template.recent.purchases.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_recent_purchases" type="object" class="oe_stat_button"
                        icon="fa-history" string="Últimas compras" invisible="not purchase_ok"
                        groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>
    <record id="product_variant_recent_purchases_form" model="ir.ui.view">
        <field name="name">product.product.recent.purchases.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_recent_purchases" type="object" class="oe_stat_button"
                        icon="fa-history" string="Últimas compras" invisible="not purchase_ok"
                        groups="purchase.group_purchase_user"/>
            </xpath>
        </field>
    </record>
</odoo>
