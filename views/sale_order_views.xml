<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.entintados_pdv</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="attributes">
                <attribute name="class" add="w-100" separator=" "/>
                <attribute name="style">max-width: 100%;</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <h2 class="text-muted fs-5 mt-1 mb-2 w-100">
                    <field name="quotation_ref" placeholder="p. ej. Pintura exterior fachada edificio..." class="w-100 d-block" style="width: 100% !important;" readonly="state == 'cancel'"/>
                </h2>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>

            <!-- Los precios ya se recalculan al cambiar la tarifa: "Actualizar precios" no se ofrece. -->
            <xpath expr="//button[@name='action_update_prices']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']" position="before">
                <field name="price_unit_edit_locked" invisible="1"/>
                <field name="discount_edit_locked" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_open_discount_wizard'][not(@disabled)]" position="attributes">
                <attribute name="invisible">locked or state == 'cancel' or discount_edit_locked</attribute>
            </xpath>
            <xpath expr="//button[@name='action_open_discount_wizard'][@disabled]" position="attributes">
                <attribute name="invisible">not (locked or state == 'cancel') or discount_edit_locked</attribute>
            </xpath>
            <!-- Pantalla pequeña: la línea se edita en este form, no en la lista. Sin estos campos
                 el cliente no los envía y el servidor toma el descuento del acuerdo como manual. -->
            <xpath expr="//field[@name='order_line']/form/field[@name='technical_price_unit']" position="after">
                <field name="pricing_rule_type" invisible="1" force_save="1"/>
                <field name="pricing_rule_id" invisible="1" force_save="1"/>
                <field name="technical_discount" invisible="1" force_save="1"/>
                <field name="price_origin_label" invisible="1" force_save="1"/>
                <field name="manual_discount_allowed" invisible="1"/>
                <field name="combo_price_snapshot" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <label for="price_unit"/>
                <div class="o_row" name="price_unit_origin">
                    <field name="price_origin" nolabel="1" widget="price_origin_icon" readonly="1" force_save="1" invisible="is_downpayment"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[@name='price_unit_origin']/field[@name='price_origin']" position="before">
                <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[@name='discount']/parent::t" position="after">
                <field name="pricing_rule_origin" string="Origen Acuerdo" readonly="1" force_save="1" invisible="not pricing_rule_origin" widget="badge" decoration-success="pricing_rule_type == 'fixed_price'" decoration-info="pricing_rule_type in ('product', 'line', 'scheme', 'global')" decoration-warning="pricing_rule_type in ('manual', 'promo')"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban/field[@name='currency_id']" position="after">
                <field name="pricing_rule_type"/>
                <field name="price_origin_label"/>
                <field name="is_downpayment"/>
                <field name="combo_price_snapshot"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//field[@name='price_unit']" position="after">
                <field name="price_origin" widget="price_origin_icon" invisible="is_downpayment"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//field[@name='discount']/ancestor::t[1]" position="after">
                <div invisible="not pricing_rule_origin">
                    <field name="pricing_rule_origin" widget="badge" decoration-success="pricing_rule_type == 'fixed_price'" decoration-info="pricing_rule_type in ('product', 'line', 'scheme', 'global')" decoration-warning="pricing_rule_type in ('manual', 'promo')"/>
                </div>
            </xpath>
            <!-- Mismos readonly que la lista. -->
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or pricing_rule_type == 'fixed_price' or parent.price_unit_edit_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="attributes">
                <attribute name="readonly">not manual_discount_allowed or parent.discount_edit_locked</attribute>
            </xpath>

            <xpath expr="//list/field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or pricing_rule_type == 'fixed_price' or parent.price_unit_edit_locked</attribute>
            </xpath>
            <!-- force_save: el servidor no recalcula el origen si `price_unit` viene en los valores. -->
            <xpath expr="//list/field[@name='price_unit']" position="after">
                <field name="price_origin" nolabel="1" widget="price_origin_icon" readonly="1" force_save="1" width="24px" invisible="is_downpayment"/>
                <field name="price_origin_label" column_invisible="True" force_save="1"/>
                <field name="combo_price_snapshot" column_invisible="True"/>
            </xpath>
            <xpath expr="//list/field[@name='discount']" position="attributes">
                <attribute name="readonly">not manual_discount_allowed or parent.discount_edit_locked</attribute>
            </xpath>
            <xpath expr="//list/field[@name='discount']" position="before">
                <field name="manual_discount_allowed" column_invisible="True"/>
                <field name="technical_discount" column_invisible="True"/>
            </xpath>
            <xpath expr="//list/field[@name='discount']" position="after">
                <field name="pricing_rule_type" column_invisible="True"/>
                <field name="pricing_rule_id" column_invisible="True"/>
                <field name="pricing_rule_origin" string="Origen Acuerdo" readonly="1" force_save="1" optional="show" widget="badge" decoration-success="pricing_rule_type == 'fixed_price'" decoration-info="pricing_rule_type in ('product', 'line', 'scheme', 'global')" decoration-warning="pricing_rule_type in ('manual', 'promo')"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_inherit_quotation_ref" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.quotation.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="quotation_ref" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_quotation_ref" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.quotation.ref</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="quotation_ref" string="Referencia / Concepto" filter_domain="[('quotation_ref', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>
