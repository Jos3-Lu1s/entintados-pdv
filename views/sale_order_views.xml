<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.entintados_pdv</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_sales_contact', '=', True)]</attribute>
                <attribute name="context">{'default_is_customer': True, 'entintados_partner_scope': 'customer'}</attribute>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//list/field[@name='discount']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//list/field[@name='discount']" position="after">
                <field name="pricing_rule_type" column_invisible="True"/>
                <field name="pricing_rule_origin" string="Origen Acuerdo" readonly="1" optional="show" widget="badge" decoration-success="pricing_rule_type == 'fixed_price'" decoration-info="pricing_rule_type in ('product', 'line', 'scheme', 'global')" decoration-warning="pricing_rule_type == 'promo'"/>
            </xpath>
        </field>
    </record>
</odoo>
