<odoo>
    <record id="rule_sale_credit_request_company" model="ir.rule">
        <field name="name">Autorizaciones de Ventas por sucursal activa</field>
        <field name="model_id" ref="approvals.model_approval_request"/>
        <field name="domain_force">['|', ('sale_credit_move_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="sale_order_form_credit_advance" model="ir.ui.view">
        <field name="name">sale.order.form.credit.advance</field>
        <field name="model">sale.order</field>
        <field name="active" eval="True"/>
        <field name="inherit_id" ref="entintados_pdv.sale_order_form_tint"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(sale_loyalty.sale_loyalty_coupon_wizard_action)d'][not(@disabled)]" position="before">
                <button name="action_sale_cash_advance" type="object" string="Recibir anticipo"
                        class="btn btn-secondary" groups="account.group_account_invoice"
                        invisible="state not in ['draft', 'sent'] or locked"/>
            </xpath>
        </field>
    </record>
    <record id="sale_cash_advance_form" model="ir.ui.view">
        <field name="name">sale.cash.advance.form</field>
        <field name="model">sale.cash.advance</field>
        <field name="arch" type="xml">
            <form string="Recibir anticipo">
                <group>
                    <field name="order_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button name="action_create_invoice" type="object" string="Crear factura de anticipo" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="account_move_form_sale_credit" model="ir.ui.view">
        <field name="name">account.move.form.sale.credit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="sale_credit_status" invisible="not sale_credit_status"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="sale_credit_stage" widget="statusbar" statusbar_visible="draft,credit_pending,posted"
                       invisible="sale_credit_stage != 'credit_pending'"/>
                <field name="sale_credit_needs_review" invisible="1"/>
                <button name="action_request_sale_credit" type="object" string="Solicitar autorización de crédito"
                        invisible="state != 'draft' or not sale_credit_needs_review or sale_credit_stage == 'credit_pending'" groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible" add="sale_credit_stage == 'credit_pending'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_post'][1]" position="attributes">
                <attribute name="invisible" add="sale_credit_stage == 'credit_pending'" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_post'][2]" position="attributes">
                <attribute name="invisible" add="sale_credit_stage == 'credit_pending'" separator=" or "/>
            </xpath>
        </field>
    </record>
    <record id="approval_request_form_sale_credit" model="ir.ui.view">
        <field name="name">approval.request.form.sale.credit</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="attributes">
                <attribute name="readonly" add="sale_credit_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//header/field[@name='request_status']" position="attributes">
                <attribute name="invisible" add="sale_credit_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//header/field[@name='request_status']" position="after">
                <field name="request_status" string="Estado" widget="badge" readonly="1"
                       invisible="not sale_credit_move_id"
                       decoration-warning="request_status == 'pending'"
                       decoration-success="request_status == 'approved'"
                       decoration-danger="request_status == 'refused'"/>
            </xpath>
            <xpath expr="//field[@name='reference']" position="after">
                <field name="sale_credit_move_id" invisible="not sale_credit_move_id" options="{'no_open': True}"/>
                <field name="company_id" string="Sucursal" invisible="not sale_credit_move_id" readonly="1"/>
            </xpath>
            <xpath expr="//header/button[@name='action_draft']" position="attributes">
                <attribute name="invisible" add="sale_credit_move_id" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel' and @data-hotkey='x']" position="attributes">
                <attribute name="invisible" add="sale_credit_move_id" separator=" or "/>
            </xpath>
        </field>
    </record>
    <record id="account_move_form_customer_advance_cash" model="ir.ui.view">
        <field name="name">account.move.form.customer.advance.cash</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_mx_edi.account_move_form_inherit_l10n_mx_edi"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_mx_edi_payment_policy']" position="attributes">
                <attribute name="readonly" add="move_type == 'out_invoice' and is_advance_invoice" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
