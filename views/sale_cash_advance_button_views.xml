<odoo>
    <record id="sale_order_form_credit_advance" model="ir.ui.view">
        <field name="name">sale.order.form.credit.advance</field>
        <field name="model">sale.order</field>
        <field name="active" eval="True"/>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']//button[@name='action_open_discount_wizard'][not(@disabled) and not(ancestor::field[@name='order_line'])]" position="before">
                <button name="action_sale_cash_advance" type="object" string="Recibir anticipo"
                        class="btn btn-secondary" groups="account.group_account_invoice"
                        invisible="state not in ['draft', 'sent'] or locked"/>
            </xpath>
        </field>
    </record>
</odoo>
