<odoo>
    <record id="sale_tint_formula_picker_list" model="ir.ui.view">
        <field name="name">sale.tint.formula.picker.list</field>
        <field name="model">tint.color.formula</field>
        <field name="arch" type="xml">
            <list string="Elige la presentación del color" create="0" edit="0" delete="0">
                <field name="color_id"/>
                <field name="base_type_id"/>
                <field name="size_id"/>
                <field name="line_scheme_id"/>
                <field name="total_points_display" string="Puntos por envase"/>
            </list>
        </field>
    </record>
    <record id="sale_tint_wizard_form" model="ir.ui.view">
        <field name="name">sale.tint.wizard.form</field>
        <field name="model">sale.tint.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar entintado">
                <sheet>
                    <field name="order_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="unit_price" invisible="1"/>
                    <field name="total_price" invisible="1"/>
                    <div class="mb-4">
                        <h2><i class="fa fa-paint-brush me-2"/>Agrega un color a tu cotización</h2>
                        <p class="text-muted mb-0">Busca el color por nombre o código, elige su presentación y revisa los productos antes de agregarlo.</p>
                    </div>
                    <group>
                        <group string="1. Elige el color">
                            <field name="gallery_id" placeholder="Todas las cartas" options="{'no_create': True, 'no_open': True}"/>
                            <field name="color_id" placeholder="Nombre o código del color…" domain="[('has_formula', '=', True)] + ([('gallery_id', '=', gallery_id)] if gallery_id else [])" options="{'no_create': True, 'no_open': True}"/>
                            <field name="formula_id" placeholder="Selecciona base y presentación…" domain="[('color_id', '=', color_id)] if color_id else []" options="{'no_create': True, 'no_open': True}" context="{'list_view_ref': 'entintados_pdv.sale_tint_formula_picker_list'}"/>
                            <field name="color_code" invisible="not formula_id"/>
                        </group>
                        <group string="2. Selecciona la pintura">
                            <field name="base_type_id" readonly="1"/>
                            <field name="size_id" readonly="1"/>
                            <field name="line_id" readonly="1" invisible="not line_id"/>
                            <field name="base_id" placeholder="Base compatible con la fórmula…" domain="[('sale_ok', '=', True), ('tint_role', '=', 'base'), ('tint_base_type_id', '=', base_type_id), ('tint_size_id', '=', size_id)] + ([('lines_product_id', '=', line_id)] if line_id else [])" options="{'no_create': True, 'no_open': True}"/>
                            <field name="quantity"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="formula_id and base_id">Selecciona una fórmula y su base para ver el desglose y el precio.</div>
                    <div invisible="not formula_id or not base_id">
                        <h3 class="mt-3">3. Revisa tu entintado</h3>
                        <field name="preview_html" widget="html" nolabel="1" readonly="1"/>
                        <group>
                            <group string="Fórmula por envase">
                                <field name="recipe" nolabel="1" readonly="1"/>
                            </group>
                            <group class="bg-light rounded p-3">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="fw-bold fs-4"/>
                            </group>
                        </group>
                    </div>
                    <p class="text-muted small mb-0">Se agregará la base con su código y nombre. La descripción mostrará únicamente el código y nombre del color. Los colorantes se descuentan al validar la salida.</p>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Agregar a la cotización" class="btn-primary" invisible="not formula_id or not base_id or quantity &lt;= 0"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="sale_order_form_tint" model="ir.ui.view">
        <field name="name">sale.order.form.tint</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="before">
                <button name="action_add_tint" type="object" string="Agregar entintado" class="btn btn-secondary mb-2" invisible="state not in ['draft', 'sent'] or locked"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="tint_display_name" column_invisible="True"/>
                <field name="tint_color_description" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form" position="inside">
                <field name="tint_display_name" invisible="1"/>
                <field name="tint_color_description" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban/field[@name='currency_id']" position="after">
                <field name="tint_display_name"/>
                <field name="tint_color_description"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//field[@name='product_id'][not(@widget)]" position="before">
                <field name="tint_display_name" class="fw-bold" invisible="not tint_display_name"/>
                <field name="tint_color_description" class="text-muted fst-italic" invisible="not tint_display_name"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//field[@name='name']" position="attributes">
                <attribute name="invisible" add="tint_display_name" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//field[@name='product_id'][not(@widget)]" position="attributes">
                <attribute name="invisible">tint_display_name</attribute>
            </xpath>
        </field>
    </record>
</odoo>
