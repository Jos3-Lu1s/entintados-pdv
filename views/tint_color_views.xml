<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ====================== Colores ====================== -->

    <record id="tint_color_view_list" model="ir.ui.view">
        <field name="name">tint.color.list</field>
        <field name="model">tint.color</field>
        <field name="arch" type="xml">
            <list string="Colores">
                <field name="code" />
                <field name="name" />
                <field
                    name="base_type_ids"
                    widget="many2many_tags"
                    string="Bases"
                    optional="show"
                />
                <field name="formula_count" string="Fórmulas" />
            </list>
        </field>
    </record>

    <record id="tint_color_view_form" model="ir.ui.view">
        <field name="name">tint.color.form</field>
        <field name="model">tint.color</field>
        <field name="arch" type="xml">
            <form string="Color">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archivado"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="p. ej. Rojo Cardenal" />
                        </h1>
                        <h3>
                            <field name="code" placeholder="p. ej. D-0001" />
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field
                                name="base_type_ids"
                                widget="many2many_tags"
                                string="Bases con fórmula"
                            />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Fórmulas" name="formulas">
                            <field name="formula_ids" nolabel="1">
                                <list decoration-danger="not fits">
                                    <field name="base_type_id" />
                                    <field name="size_id" />
                                    <field name="total_points" />
                                    <field name="total_points_display" string="Total" />
                                    <field name="capacity_display" string="Capacidad" />
                                    <field name="remaining_points" string="Holgura" />
                                    <field name="fits" string="Cabe" />
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tint_color_view_search" model="ir.ui.view">
        <field name="name">tint.color.search</field>
        <field name="model">tint.color</field>
        <field name="arch" type="xml">
            <search string="Buscar color">
                <field name="name" />
                <field name="code" />
                <field name="base_type_ids" string="Tipo de base" />
                <separator />
                <filter
                    name="without_formula"
                    string="Sin fórmula"
                    domain="[('formula_ids', '=', False)]"
                />
                <separator />
                <filter
                    name="inactive"
                    string="Archivados"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="tint_color_action" model="ir.actions.act_window">
        <field name="name">Colores</field>
        <field name="res_model">tint.color</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tint_color_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre un color</p>
            <p>
                Un color se captura una sola vez y puede tener varias fórmulas,
                una por cada combinación de tipo de base y presentación.
            </p>
        </field>
    </record>

</odoo>
