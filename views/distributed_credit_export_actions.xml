<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_distributed_credit_excel_selected" model="ir.actions.server">
        <field name="name">Excel: notas seleccionadas</field>
        <field name="model_id" ref="model_vendor_credit_group"/>
        <field name="binding_model_id" ref="model_vendor_credit_group"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_distributed_credits_xlsx()</field>
    </record>
    <record id="action_distributed_credit_excel_all" model="ir.actions.server">
        <field name="name">Excel: todas las notas</field>
        <field name="model_id" ref="model_vendor_credit_group"/>
        <field name="binding_model_id" ref="model_vendor_credit_group"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = model.action_export_distributed_credits_xlsx(all_records=True)</field>
    </record>
</odoo>
