<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="tint_size_view_list" model="ir.ui.view">
        <field name="name">tint.size.list</field>
        <field name="model">tint.size</field>
        <field name="arch" type="xml">
            <list string="Presentaciones">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="volume_liters" />
                <field name="capacity_count" string="Capacidades" />
            </list>
        </field>
    </record>

    <record id="tint_size_view_form" model="ir.ui.view">
        <field name="name">tint.size.form</field>
        <field name="model">tint.size</field>
        <field name="arch" type="xml">
            <form string="Presentación">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archivado"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="p. ej. Galón" />
                        </h1>
                        <h3>
                            <field name="code" placeholder="G" />
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="volume_liters" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Capacidad por tipo de base" name="capacities">
                            <field name="capacity_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="base_type_id" />
                                    <field name="max_points" />
                                    <field name="max_points_display" string="Notación" />
                                    <field name="theoretical_points" optional="show" />
                                    <field name="is_consistent" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tint_size_action" model="ir.actions.act_window">
        <field name="name">Presentaciones</field>
        <field name="res_model">tint.size</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre una presentación</p>
            <p>
                El volumen en litros se usa para verificar la consistencia de la
                matriz de capacidad de colorante.
            </p>
        </field>
    </record>

</odoo>
