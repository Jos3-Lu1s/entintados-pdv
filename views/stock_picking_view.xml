<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <delete model="ir.ui.view" id="stock_picking_formula_material_view"/>
    <record id="stock_picking_material_cost_columns" model="ir.ui.view">
        <field name="name">stock.picking.material.cost.columns</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list" position="inside">
                <field name="material_cost_currency_id" column_invisible="1"/>
                <field name="material_unit_cost" widget="monetary" options="{'currency_field': 'material_cost_currency_id'}" readonly="1" optional="show"/>
                <field name="material_total_cost" widget="monetary" options="{'currency_field': 'material_cost_currency_id'}" readonly="1" sum="Total de costos" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="stock_picking_view_form_crm_demo_cancellation" model="ir.ui.view">
        <field name="name">stock.picking.form.crm.demo.cancellation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_crm_demo_output" invisible="1"/>
                <field name="can_cancel_demo" invisible="1"/>
                <button name="action_cancel" type="object" string="Cancelar demostración" groups="base.group_user"
                        invisible="not is_crm_demo_output or not can_cancel_demo or state not in ('assigned', 'confirmed', 'draft', 'waiting')"
                        confirm="Cancelar esta salida de material marcará automáticamente la oportunidad de CRM como perdida. ¿Deseas continuar?"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel' and @data-hotkey='x']" position="attributes">
                <attribute name="invisible">is_crm_demo_output or state not in ('assigned', 'confirmed', 'draft', 'waiting')</attribute>
            </xpath>
        </field>
    </record>

    <record id="stock_picking_view_form_inherit_crm" model="ir.ui.view">
        <field name="name">stock.picking.form.crm.lead</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="invisible">is_material_output_type</attribute>
            </xpath> -->
            <xpath expr="//button[@name='button_validate'][hasclass('oe_highlight')]" position="attributes">
                <attribute name="invisible">state in ('draft', 'confirmed', 'done', 'cancel') or is_material_output_type</attribute>
            </xpath>
            
            <!-- Botón con class="o_btn_validate" -->
            <xpath expr="//button[@name='button_validate'][hasclass('o_btn_validate')]" position="attributes">
                <attribute name="invisible">state in ('waiting', 'assigned', 'done', 'cancel') or is_material_output_type</attribute>
            </xpath>
            <xpath expr="//button[@name='button_validate']" position="after">
                <button name="action_audit_approve_material" string="Autorizar" type="object"
                        class="btn-primary"
                        invisible="not is_material_auditor or material_approval_state != 'to_audit' or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_audit_refuse_material" string="Rechazar solicitud" confirm="La solicitud regresará a CRM para corregir los productos. La oportunidad seguirá activa." type="object"
                        class="btn-secondary"
                        invisible="not is_material_auditor or material_approval_state != 'to_audit' or state in ('done', 'cancel')"/>
                <!-- <field name="material_approval_state" widget="statusbar" statusbar_visible="to_approve,approved,refused"/> -->
            </xpath>

            <!-- <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="invisible">(is_material_output_type and material_approval_state != 'to_approve') or (is_material_output_type and state == 'waiting') </attribute>
            </xpath> -->

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_approval_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-thumbs-o-up"
                    invisible="not approval_request_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Aprobación
                        </span>
                    </div>
                </button>
                <button
                    name="action_view_crm_lead"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-star"
                    invisible="not crm_lead_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Oportunidad
                        </span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='note']" position="after">
                <page string="Evidencias" name="material_evidence" invisible="not is_crm_demo_output">
                    <field name="can_validate_material_evidence" invisible="1"/>
                    <field name="validate_delivery" invisible="1"/>
                    <field name="validate_material_use" invisible="1"/>
                    <field name="document_filename" invisible="1" readonly="validate_delivery"/>
                    <group string="Evidencia de entrega de material">
                        <field name="document_file" widget="binary" filename="document_filename" readonly="validate_delivery"/>

                        <field name="evidence_attachment_ids"
                           widget="many2many_binary" readonly="validate_delivery == True" />
                    </group>
                    <button string="Validar entrega" type="object" name="action_validate_delivery" class="btn-primary" confirm="¿Está seguro de que desea validar la entrega? Esta acción no se puede deshacer."
                            invisible="not can_validate_material_evidence or validate_delivery or state not in ('confirmed', 'assigned', 'done')"/>

                    
                    <div name="material_use_evidence_section" class="d-flex flex-column gap-3 mt-4 w-100">
                        <separator string="Evidencia de uso de material"/>
                        <div class="alert alert-warning mb-0" role="alert" invisible="validate_delivery">
                            Primero debes validar y confirmar la entrega del material.
                            Hasta entonces no podrás cargar ni validar evidencias de uso.
                        </div>
                        <div class="clearfix w-100">
                            <field name="evidence_use_attachment_ids"
                               widget="many2many_binary" nolabel="1" class="d-block w-100"
                               readonly="not validate_delivery or validate_material_use"/>
                        </div>
                        <button string="Validar uso de material" type="object" name="action_validate_material_use" class="btn-primary align-self-start" confirm="¿Está seguro de que desea validar el uso de material? Esta acción no se puede deshacer."
                            invisible="not can_validate_material_evidence or validate_material_use or not validate_delivery"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
