<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_picking_view_form_inherit_crm" model="ir.ui.view">
        <field name="name">stock.picking.form.crm.lead</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_audit_approve_material" string="Validar (Auditoría)" type="object"
                        class="btn-primary"
                        invisible="not is_material_auditor or material_approval_state != 'to_audit'"/>
                <button name="action_audit_refuse_material" string="Rechazar (Auditoría)" type="object"
                        class="btn-secondary"
                        invisible="not is_material_auditor or material_approval_state != 'to_audit'"/>
                <!-- <field name="material_approval_state" widget="statusbar" statusbar_visible="to_approve,approved,refused"/> -->
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_approval_request"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-thumbs-o-up"
                    invisible="not approval_request_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Aprobación
                        </span>
                    </div>
                </button>
                <button
                    name="action_view_crm_lead"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-star"
                    invisible="not crm_lead_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Oportunidad
                        </span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='note']" position="after">
                <page string="Evidencias" name="material_evidence" invisible="not is_material_output_type">
                    <group>
                        
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>