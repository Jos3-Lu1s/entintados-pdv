<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_picking_view_form_inherit_crm" model="ir.ui.view">
        <field name="name">stock.picking.form.crm.lead</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve_material"
                        string="Aprobar y Firmar Salida"
                        type="object"
                        class="btn-primary"
                        invisible="material_approval_state == 'approved' or not is_material_approver"/>
                <button name="action_refuse_material"
                        string="Rechazar Salida"
                        type="object"
                        class="btn-secondary"
                        invisible="material_approval_state != 'to_approve' or not is_material_approver"/>
                <!-- <field name="material_approval_state" widget="statusbar" statusbar_visible="to_approve,approved,refused"/> -->
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_crm_lead"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-star"
                    invisible="not crm_lead_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">
                            Oportunidad
                        </span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//page[@name='note']" position="after">
                <page string="Aprobación y Firma del Gerente" name="material_approval_signature"  invisible="not is_material_output_type">
                    <group>
                        <group string="Estado de Autorización">
                            <field name="material_approval_state" readonly="1"/>
                            <field name="material_approver_id" readonly="1"/>
                            <field name="signature_date" readonly="1"/>
                        </group>
                        <group string="Firma Digital">
                            <field name="signature" widget="signature" readonly="material_approval_state == 'approved' and not is_material_approver"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>