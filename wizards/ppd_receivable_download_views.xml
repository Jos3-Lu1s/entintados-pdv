<odoo>
    <record id="ppd_receivable_download_form" model="ir.ui.view">
        <field name="name">ppd.receivable.download.form</field>
        <field name="model">ppd.receivable.download</field>
        <field name="arch" type="xml">
            <form string="Descargar cuentas por cobrar PPD">
                <group>
                    <field name="report_options" invisible="1"/>
                    <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_download" type="object" string="Descargar PDF" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
