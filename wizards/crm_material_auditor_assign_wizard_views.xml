<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crm_material_auditor_assign_wizard_form" model="ir.ui.view">
        <field name="name">crm.material.auditor.assign.wizard.form</field>
        <field name="model">crm.material.auditor.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar auditor(es)">
                <field name="approval_request_id" invisible="1"/>
                <field name="auditor_department_id" invisible="1"/>
                <sheet>
                    <div class="text-center mb-3">
                        <h4>Asignar auditor(es)</h4>
                    </div>
                    <p class="text-muted mb-3">
                        Antes de aprobar esta solicitud, selecciona uno o más
                        auditores del departamento de Auditoría responsables de
                        validar la salida de material.
                    </p>
                    <group>
                        <field name="employee_ids"
                               widget="many2many_tags"
                               domain="[('department_id', '=', auditor_department_id)]"
                               placeholder="Selecciona auditores..."
                               nolabel="1"
                               colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Aprobar" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_material_auditor_assign_wizard" model="ir.actions.act_window">
        <field name="name">Asignar auditor(es)</field>
        <field name="res_model">crm.material.auditor.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>