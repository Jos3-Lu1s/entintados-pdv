<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_stock_lookup_form" model="ir.ui.view">
        <field name="name">product.stock.lookup.form</field><field name="model">product.stock.lookup</field>
        <field name="arch" type="xml">
            <form string="Existencias por almacén">
                <group>
                    <field name="product_tmpl_id" invisible="1"/>
                    <field name="order_product_ids" invisible="1"/>
                    <field name="product_id" placeholder="Busca por código, nombre o código de barras…" options="{'no_create': True, 'no_open': True}"
                           domain="[('is_storable', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)] + ([('id', 'in', order_product_ids)] if sale_order_id else []) + ([('product_tmpl_id', '=', product_tmpl_id)] if product_tmpl_id else [])"/>
                    <field name="product_uom_id" options="{'no_open': True}"/>
                    <field name="sale_order_id" invisible="not sale_order_id" options="{'no_open': True}"/>
                    <field name="order_warehouse_id" invisible="not sale_order_id" options="{'no_open': True}"/>
                    <field name="requested_qty" invisible="not sale_order_id"/>
                    <field name="company_id" groups="base.group_multi_company" readonly="sale_order_id" options="{'no_create': True}" domain="[('id', 'in', context.get('allowed_company_ids', []))]"/>
                    <field name="company_id" invisible="1"/>
                    <field name="warehouse_id" options="{'no_create': True, 'no_open': True}" domain="[('company_id', '=', company_id)]"/>
                    <field name="only_available"/>
                </group>
                <div style="max-height:22rem; overflow-y:auto;">
                    <field name="line_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0" open_form_view="0" decoration-muted="available &lt;= 0">
                            <field name="warehouse_id" options="{'no_open': True}"/>
                            <field name="on_hand" sum="Existencia física"/>
                            <field name="reserved" sum="Reservado"/>
                            <field name="available" sum="Disponible"/>
                        </list>
                    </field>
                </div>
                <p class="text-muted small">Disponible = existencia física menos lo reservado, en la unidad del producto. La consulta muestra solo almacenes accesibles de la compañía seleccionada.</p>
                <footer>
                    <button name="action_refresh" type="object" string="Actualizar" class="btn-secondary"/>
                    <button string="Cerrar" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_product_stock_lookup" model="ir.actions.act_window">
        <field name="name">Consulta de inventario por producto</field>
        <field name="res_model">product.stock.lookup</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="product_stock_lookup_form"/>
        <field name="target">new</field>
        <field name="context">{'default_product_id': False, 'default_product_tmpl_id': False, 'default_sale_order_id': False, 'dialog_size': 'medium'}</field>
    </record>
    <menuitem id="menu_product_stock_lookup" name="Consulta de inventario"
              parent="stock.menu_stock_inventory_control" action="action_product_stock_lookup"
              sequence="35" groups="stock.group_stock_user"/>
    <record id="menu_product_stock_lookup" model="ir.ui.menu"><field name="active" eval="False"/></record>
    <record id="sale_order_product_stock_lookup" model="ir.ui.view">
        <field name="name">sale.order.product.stock.lookup</field><field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_check_branch_stock" type="object" string="Disponibilidad por sucursal"
                        groups="sales_team.group_sale_salesman,stock.group_stock_user"/>
            </xpath>
        </field>
    </record>
    <record id="product_stock_lookup_button" model="ir.ui.view">
        <field name="name">product.template.stock.lookup</field><field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_stock_by_warehouse" type="object" class="oe_stat_button" icon="fa-cubes"
                        invisible="not is_storable" groups="sales_team.group_sale_salesman,stock.group_stock_user">
                    <div class="o_stat_info"><span class="o_stat_text">Por almacén</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
