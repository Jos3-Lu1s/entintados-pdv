<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="crm_field_visit_confirm_wizard_form" model="ir.ui.view">
        <field name="name">crm.field.visit.confirm.wizard.form</field>
        <field name="model">crm.field.visit.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Visita de campo ya registrada">
                <field name="lead_id" invisible="1"/>
                <p>
                    Ya existe una actividad de <b>Visita de campo</b> en esta oportunidad.
                    ¿Deseas registrar otra?
                </p>
                <footer>
                    <button string="Registrar otra" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
