<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_tint" model="ir.module.category">
        <field name="name">Entintados</field>
        <field name="sequence" eval="20" />
    </record>
    <record id="privilege_tint" model="res.groups.privilege">
        <field name="name">Entintados</field>
        <field name="category_id" ref="entintados_pdv.module_category_tint" />
    </record>
    <record id="group_tint_manager" model="res.groups">
        <field name="name">Administrador de catálogo</field>
        <field name="privilege_id" ref="privilege_tint" />
        <field
            name="comment"
        >Administra tipos de base, presentaciones y la matriz de capacidad de colorante</field>
    </record>

    <record id="category_financial_risk" model="ir.module.category">
        <field name="name">Financial Risk</field>
        <field name="sequence" eval="99" />
    </record>
    <record id="privilege_financial_risk" model="res.groups.privilege">
        <field name="name">Financial Risk</field>
        <field name="category_id" ref="base.module_category_accounting" />
    </record>
    <record id="group_account_financial_risk_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_financial_risk" />
        <field name="comment">Read only access to financial risk info</field>
    </record>
    <record id="group_account_financial_risk_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_financial_risk" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('entintados_pdv.group_account_financial_risk_user'))]"
        />
        <field
            name="comment"
        >Can edit risk limit and overpass partner risk exceptions</field>
    </record>
</odoo>
