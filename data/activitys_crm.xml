<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_activity_type_create_quotation" model="mail.activity.type">
            <field name="name">Creación de cotización</field>
            <field name="category">default</field>
            <field name="icon">fa-file-text-o</field>
            <field name="summary">Creacion de la cotizacion relacionada</field>
        </record>

        <record id="mail_activity_type_confirm_quotation" model="mail.activity.type">
            <field name="name">Confirmar cotización</field>
            <field name="category">default</field>
            <field name="icon">fa-check</field>
            <field name="summary">Confirmación de la orden de venta</field>
        </record>

        <record id="mail_activity_type_demo" model="mail.activity.type">
            <field name="name">Demo</field>
            <field name="category">meeting</field>
            <field name="icon">fa-users</field>
            <field name="summary">Programación de demostración</field>
        </record>


        <!-- Modificar actividad estándar SIN pasar por ir.model.data -->
        <function model="mail.activity.type" name="write">
            <function model="mail.activity.type" name="search">
                <value eval="[('id', '=', ref('mail.mail_activity_data_meeting'))]"/>
            </function>
            <value eval="{'name': 'Visita de campo'}"/>
        </function>

    </data>  
</odoo>