<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
      Matriz de capacidad maxima de colorante: 7 tipos de base x 3
      presentaciones = 21 combinaciones.

      Los valores provienen de la tabla del fabricante y se almacenan
      de forma explicita, no calculada, porque la tabla puede tener
      excepciones que no sigan la relacion lineal. La relacion
      `puntos por litro x litros` se verifica en las pruebas
      (tests/test_tint_capacity.py) y en el campo `is_consistent`.

      Este archivo se genera de forma programatica a partir de la tabla
      original para descartar errores de captura.

      TODO antes de salida a produccion: cambiar a noupdate="1".
    -->
    <data>

        <!-- W: 24 puntos por litro -->
        <record id="tint_cap_w_l" model="tint.base.capacity">
            <field name="base_type_id" ref="tint_base_type_w" />
            <field name="size_id" ref="tint_size_liter" />
            <field name="max_points">24</field>  <!-- 24 Pts. -->
        </record>
