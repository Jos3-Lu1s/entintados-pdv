<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
      Secuencia de códigos de color.

      Se carga con noupdate="1" para que una actualización de módulo no
      reinicie el contador de una base en operación.
    -->
    <data noupdate="1">

        <record id="seq_tint_color_code" model="ir.sequence">
            <field name="name">Entintado: código de color</field>
            <field name="code">tint.color.code</field>
            <field name="prefix">D</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>

    </data>
</odoo>
