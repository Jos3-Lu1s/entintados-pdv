<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Tipo / categoría de aprobación -->
        <record id="approval_category_salida_material" model="approval.category">
            <field name="name">Solicitud de salida de material</field>
            <field name="approval_type">stock_out</field>
            <field name="description">Autorización para solicitudes de salida.</field>
            <field name="requirer_document">optional</field>
            <field name="has_partner">required</field>
            <field name="has_date">required</field>
            <field name="has_product">required</field>
            <field name="has_quantity">required</field>
        </record>

        <!-- Solicitud de aprobación -->
        <record id="approval_request_salida_material_demo" model="approval.request">
            <field name="name">Solicitud de salida de material</field>

            <field
                name="category_id"
                ref="approval_category_salida_material"
            />

            <field
                name="request_owner_id"
                ref="base.user_admin"
            />
        </record>

    </data>
</odoo>