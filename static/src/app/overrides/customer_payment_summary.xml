<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.HidePaymentInvoiceToggle" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>
    <t t-name="entintados_pdv.PaymentSummaryLayout" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('center-content')]" position="attributes">
            <attribute name="class" add="o-entintados-payment-layout" separator=" "/>
        </xpath>
    </t>
    <t t-name="entintados_pdv.CustomerPaymentSummary" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//section" position="replace">
            <section t-if="currentOrder" class="o-customer-payment-summary" aria-label="Resumen de compra">
                <t t-set="summary" t-value="customerPaymentSummary"/>
                <header class="p-3 border-bottom">
                    <h4 class="mb-1">Resumen de compra</h4>
                    <t t-if="currentOrder.getPartner()" t-call="entintados_pdv.CustomerContactInfo">
                        <t t-set="partner" t-value="currentOrder.getPartner()"/>
                    </t>
                    <div t-else="">Público en general</div>
                </header>
                <div class="o-customer-purchase-lines table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead><tr><th>Producto</th><th class="text-end">Cant.</th><th class="text-end">Precio unit.</th><th class="text-end">Descuento / promoción</th><th t-if="summary.showMargins" class="text-end">Margen interno</th><th class="text-end">Importe</th></tr></thead>
                        <tbody>
                            <tr t-foreach="summary.rows" t-as="row" t-key="row.id">
                                <td><span t-esc="row.name"/><small t-if="row.color" class="d-block text-muted">Color: <t t-esc="row.color"/></small></td>
                                <td class="text-end text-nowrap"><t t-esc="row.quantity"/> <small t-esc="row.unit"/></td>
                                <td class="text-end text-nowrap" t-esc="env.utils.formatCurrency(row.unitPrice)"/>
                                <td class="text-end text-nowrap" t-esc="env.utils.formatCurrency(row.saving)"/>
                                <td t-if="summary.showMargins" class="text-end text-nowrap">
                                    <t t-esc="row.margin === null ? '—' : env.utils.formatCurrency(row.margin)"/>
                                    <span t-if="row.marginPercent !== null" class="ms-1">(<t t-esc="formatMarginPercent(row.marginPercent)"/>%)</span>
                                </td>
                                <td class="text-end text-nowrap fw-bold" t-esc="env.utils.formatCurrency(row.amount)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <footer class="p-3 border-top">
                    <small class="text-muted">Precios e importes de productos antes de impuestos.</small>
                    <div t-if="showPaymentInvoiceOptions" class="o-customer-invoice-options table-responsive mt-2 mb-3">
                        <table class="table table-sm table-bordered mb-0 align-middle" t-att-class="{'o-has-payment-term': showPaymentTerm}" aria-label="Datos de facturación">
                            <thead><tr><th><label for="payment_invoice_usage">Uso</label></th><th><label for="payment_invoice_public">Público en general</label></th><th><label for="payment_invoice_count">Número de facturas</label></th><th t-if="showPaymentTerm"><label for="payment_invoice_term">Términos de pago</label></th></tr></thead>
                            <tbody><tr>
                                <td><select id="payment_invoice_usage" class="form-select form-select-sm" t-on-change="changePaymentInvoiceUsage">
                                    <option t-foreach="pos.config._l10n_mx_edi_usage || []" t-as="usage" t-key="usage.value"
                                            t-att-value="usage.value" t-att-selected="usage.value === paymentInvoiceUsage" t-esc="usage.name"/>
                                </select></td>
                                <td><select id="payment_invoice_public" class="form-select form-select-sm" t-on-change="changePaymentInvoicePublic">
                                    <option value="0" t-att-selected="!currentOrder.l10n_mx_edi_cfdi_to_public">No</option>
                                    <option value="1" t-att-selected="!!currentOrder.l10n_mx_edi_cfdi_to_public">Sí</option>
                                </select></td>
                                <td><input id="payment_invoice_count" type="number" min="1" step="1"
                                           class="form-control form-control-sm" t-att-value="paymentInvoiceSplitCount"
                                           t-att-disabled="!canSplitPaymentInvoice" t-on-change="changePaymentInvoiceSplitCount"/></td>
                                <td t-if="showPaymentTerm">
                                    <select id="payment_invoice_term" class="form-select form-select-sm" t-on-change="changePaymentTerm">
                                        <option value="" t-att-selected="!currentOrder.pos_payment_term_id">
                                            <t t-esc="defaultPaymentTerm?.name || 'Plazo predeterminado'"/>
                                        </option>
                                        <option t-foreach="paymentTermOptions" t-as="term" t-key="term.id" t-att-value="term.id"
                                                t-att-selected="term.id === currentOrder.pos_payment_term_id?.id" t-esc="term.name"/>
                                    </select>
                                </td>
                            </tr></tbody>
                        </table>
                    </div>
                    <dl class="o-customer-price-breakdown mb-0 mt-2">
                        <dt>Importe antes de descuentos</dt><dd t-esc="env.utils.formatCurrency(summary.gross)"/>
                        <dt>Descuentos <small t-if="summary.discountRates" class="text-muted">(<t t-esc="summary.discountRates"/> por producto)</small></dt><dd t-esc="env.utils.formatCurrency(-summary.discounts)"/>
                        <dt>Promociones <small t-if="summary.promotionRates" class="text-muted">(<t t-esc="summary.promotionRates"/> por producto)</small></dt><dd t-esc="env.utils.formatCurrency(-summary.promotions)"/>
                        <dt>Subtotal</dt><dd t-esc="env.utils.formatCurrency(summary.subtotal)"/>
                        <t t-foreach="summary.taxes" t-as="tax" t-key="tax_index">
                            <dt t-esc="tax.name"/><dd t-esc="env.utils.formatCurrency(tax.amount)"/>
                        </t>
                        <t t-if="!summary.taxes.length"><dt>Impuestos</dt><dd t-esc="env.utils.formatCurrency(summary.tax)"/></t>
                        <t t-if="!currentOrder.currency.isZero(summary.rounding)"><dt>Redondeo</dt><dd t-esc="env.utils.formatCurrency(summary.rounding)"/></t>
                        <dt class="o-customer-total">Total a pagar</dt><dd class="o-customer-total" t-esc="env.utils.formatCurrency(summary.total)"/>
                    </dl>
                </footer>
            </section>
        </xpath>
    </t>
</templates>
