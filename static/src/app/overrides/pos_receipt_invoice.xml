<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.ReceiptInvoice" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[contains(@t-on-click, 'doFullPrint')]/parent::div" position="before">
            <button t-if="receiptInvoiceIds.length" type="button"
                    class="btn btn-lg btn-secondary w-100 py-3" t-on-click="downloadReceiptInvoice">
                <i class="fa fa-download me-1" aria-hidden="true"/>
                <t t-if="receiptInvoiceIds.length > 1">Descargar facturas</t>
                <t t-else="">Descargar factura</t>
            </button>
        </xpath>
        <xpath expr="//button[contains(@t-on-click, 'doFullPrint')]/parent::div" position="attributes">
            <attribute name="t-if">!receiptInvoiceIds.length</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-container')]" position="before">
            <div t-if="receiptInvoiceIds.length"
                 class="d-flex flex-grow-1 flex-lg-grow-0 w-100 w-lg-50 bg-200 overflow-hidden">
                <iframe t-att-src="receiptInvoicePreviewUrl" title="Vista previa de la factura"
                        class="flex-fill w-100 border-0" style="min-height: 18rem;"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-container')]" position="attributes">
            <attribute name="t-if">!receiptInvoiceIds.length</attribute>
        </xpath>
    </t>
</templates>
