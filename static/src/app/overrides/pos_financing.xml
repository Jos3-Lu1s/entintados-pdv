<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.DeferredPaymentButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <div t-if="appliedCustomerAdvance gt 0" class="alert alert-success mb-0 mt-2" role="status">
                Saldo a favor aplicado: <strong t-esc="env.utils.formatCurrency(appliedCustomerAdvance)"/>
            </div>
            <div t-if="isCollectingCustomerAdvance" class="alert alert-info mb-0 mt-2" role="status">
                <strong>Recibir anticipo del cliente</strong>
                <div>El dinero cobrado quedará como saldo a su favor para próximas compras.</div>
            </div>
            <div class="d-flex flex-column gap-2 mt-2" t-if="canOfferDeferredPayment">
                <t t-set="creditApproval" t-value="currentOrder.uiState.creditApproval"/>
                <t t-set="creditApproved" t-value="creditApproval and !creditApprovalAmountsChanged and ['approved', 'used'].includes(creditApproval.state)"/>
                <t t-set="creditRefused" t-value="creditApproval and !creditApprovalAmountsChanged and creditApproval.state === 'refused'"/>
                <div t-if="creditApproval" class="alert mb-0" t-att-class="creditApproved ? 'alert-success' : (creditRefused ? 'alert-danger' : 'alert-warning')" role="status">
                    <div>
                        <t t-if="creditApproved">
                            <i class="fa fa-check-circle me-2" aria-hidden="true"/>
                            <strong>Aprobada</strong> ·
                            <span t-esc="creditApproval.name"/>
                        </t>
                        <t t-elif="creditRefused">
                            <i class="fa fa-times-circle me-2" aria-hidden="true"/>
                            <strong>Rechazada</strong> ·
                            <span t-esc="creditApproval.name"/>
                        </t>
                        <t t-else="">
                            <div t-if="creditApprovalAmountsChanged"><strong>Monto modificado. Actualiza la autorización.</strong></div>
                            <div t-elif="creditApproval.revised">
                                Monto actualizado de <strong t-esc="env.utils.formatCurrency(creditApproval.previous_credit_amount)"/>
                                a <strong t-esc="env.utils.formatCurrency(creditApproval.credit_amount)"/>.
                            </div>
                            El cliente <strong t-esc="currentOrder.getPartner()?.name || currentOrder.getPartner()?.display_name || ''"/>
                            excede el límite de crédito permitido. El departamento correspondiente debe autorizar la solicitud
                            <strong t-esc="creditApproval.name"/> con un monto de
                            <strong t-esc="env.utils.formatCurrency(creditApproval.credit_amount)"/>.
                        </t>
                    </div>
                    <button t-if="currentOrder.uiState.creditApproval.state === 'pending' or creditApprovalAmountsChanged" class="btn btn-secondary mt-2"
                            t-on-click="() => this.setDeferredPayment('credit')">Revisar autorización</button>
                </div>
                <div t-if="currentOrder.pos_payment_flow === 'ppd_partial' or currentOrder.pos_payment_flow === 'credit'" class="alert alert-info mb-0" role="status">
                    <t t-esc="deferredPaymentSummary"/>
                </div>
            </div>
        </xpath>
    </t>
    <t t-name="entintados_pdv.CollectOutstandingInvoice" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="pos.cashier._role != 'minimal'" t-att-class="buttonClass" t-on-click="() => this.onClickCollectOutstandingInvoice()">
                <i class="fa fa-money me-1"/>Cobrar saldo pendiente
            </button>
        </xpath>
    </t>
</templates>
