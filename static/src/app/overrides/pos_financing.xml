<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.DeferredPaymentButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <div t-if="appliedCustomerAdvance gt 0" class="alert alert-success mb-0 mt-2" role="status">
                Saldo a favor aplicado: <strong t-esc="env.utils.formatCurrency(appliedCustomerAdvance)"/>
            </div>
            <div t-if="isCollectingCustomerAdvance" class="alert alert-info mb-0 mt-2" role="status">
                <strong>Recibir anticipo del cliente</strong>
                <div>El dinero cobrado quedará como saldo a su favor para próximas compras.</div>
            </div>
            <div class="d-flex flex-column gap-2 mt-2" t-if="canOfferDeferredPayment">
                <button class="btn btn-secondary btn-lg py-2 text-wrap" t-on-click="() => this.selectDeferredPayment()">
                    <i class="fa fa-credit-card me-2"/>Opciones de pago
                </button>
                <div t-if="currentOrder.pos_payment_flow === 'ppd_partial' or currentOrder.pos_payment_flow === 'credit'" class="alert alert-info mb-0" role="status">
                    <t t-esc="deferredPaymentSummary"/>
                </div>
            </div>
        </xpath>
    </t>
    <t t-name="entintados_pdv.CollectOutstandingInvoice" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="pos.cashier._role != 'minimal'" t-att-class="buttonClass" t-on-click="() => this.onClickCollectOutstandingInvoice()">
                <i class="fa fa-money me-1"/>Cobrar saldo pendiente
            </button>
        </xpath>
    </t>
</templates>
