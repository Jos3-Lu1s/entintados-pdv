<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="entintados_pdv.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension" owl="1">
        <xpath expr="//li[@t-if='vals.discount']" position="replace">
            <li t-if="vals.pricingRuleType === 'promo'" class="price-per-unit pricing-rule-indicator promo-indicator" t-att-class="{'text-success': vals.isDisplay}">
                <i class="fa fa-tag pe-1"/>
                <t t-esc="vals.pricingRuleOrigin"/>
                <span t-if="vals.isReceipt and vals.discount"> -<t t-esc="vals.discount"/>%</span>
            </li>
            <li t-elif="vals.pricingRuleOrigin and vals.pricingRuleType === 'fixed_price'" class="price-per-unit pricing-rule-indicator">
                <i class="fa fa-tag pe-1"/>
                <t t-esc="vals.pricingRuleOrigin"/>
            </li>
            <li t-elif="vals.pricingRuleOrigin and vals.discount" class="price-per-unit pricing-rule-indicator">
                <i class="fa fa-tag pe-1"/>
                <t t-esc="vals.pricingRuleOrigin"/>
                <t t-if="vals.isReceipt"> <span>sobre</span> <t t-esc="vals.noDiscountPrice"/></t>
            </li>
            <li t-elif="vals.isReceipt and vals.discount" class="price-per-unit">
                <i class="fa fa-tag pe-1"/><em><t t-esc="vals.discount"/>% </em> discount off on <t t-esc="vals.noDiscountPrice"/>
            </li>
        </xpath>
        <xpath expr="//div[hasclass('product-name')]/span[hasclass('qty')]" position="after">
            <span t-if="props.mode === 'receipt' and props.line.product_id?.default_code"
                  class="product-ref text-nowrap pe-2 x-small">[<t t-out="props.line.product_id.default_code"/>]</span>
        </xpath>
    </t>
</templates>
