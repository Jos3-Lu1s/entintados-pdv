<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="entintados_pdv.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li[@t-if='vals.discount']" position="replace">
            <li t-if="vals.pricingRuleType === 'promo'" class="price-per-unit pricing-rule-indicator promo-indicator" t-att-class="vals.isDisplay and vals.pricingRuleColor">
                <span class="cursor-pointer" role="button" t-on-click.stop="() => this.onSelectLinePromotion(props.line)" title="Cambiar o ver las promociones de la línea">
                    <i t-attf-class="fa {{vals.pricingRuleIcon}} pe-1"/>
                    <t t-esc="vals.pricingRuleOrigin"/>
                </span>
                <t t-if="vals.isReceipt">
                    <span t-if="vals.discount"> -<t t-esc="vals.discount"/>%</span>
                    <span t-if="vals.noDiscountPrice"> sobre <t t-esc="vals.noDiscountPrice"/></span>
                </t>
            </li>
            <li t-elif="vals.pricingRuleOrigin and vals.pricingRuleType === 'fixed_price'" class="price-per-unit pricing-rule-indicator" t-att-class="vals.isDisplay and vals.pricingRuleColor">
                <i t-attf-class="fa {{vals.pricingRuleIcon}} pe-1"/>
                <t t-esc="vals.pricingRuleOrigin"/>
            </li>
            <li t-elif="vals.pricingRuleOrigin and (vals.pricingRuleType === 'manual' or vals.discount)" class="price-per-unit pricing-rule-indicator" t-att-class="vals.isDisplay and vals.pricingRuleColor">
                <i t-attf-class="fa {{vals.pricingRuleIcon}} pe-1"/>
                <t t-esc="vals.pricingRuleOrigin"/>
                <t t-if="vals.isReceipt"> <span>sobre</span> <t t-esc="vals.noDiscountPrice"/></t>
            </li>
            <li t-elif="vals.isReceipt and vals.discount" class="price-per-unit">
                <i class="fa fa-tag pe-1"/><t t-esc="vals.discount"/>% de descuento sobre <t t-esc="vals.noDiscountPrice"/>
            </li>
            <li t-elif="vals.discount" class="price-per-unit">
                <i class="fa fa-tag pe-1"/>
                <t t-esc="vals.discountBadge"/>
            </li>
        </xpath>
        <xpath expr="//div[hasclass('product-name')]/span[hasclass('qty')]" position="after">
            <span t-if="props.mode === 'receipt' and props.line.product_id?.default_code"
                  class="product-ref text-nowrap pe-2 x-small">[<t t-out="props.line.product_id.default_code"/>]</span>
            <span t-if="props.mode !== 'receipt' and this.canHavePromotion(props.line)"
                  class="o-line-promo-star cursor-pointer ms-1 px-1"
                  role="button"
                  t-on-click.stop="() => this.onSelectLinePromotion(props.line)"
                  t-att-title="this.getPromotionButtonTitle(props.line)">
                <i t-attf-class="fa #{this.isPromotionStarFilled(props.line) ? 'fa-star text-primary' : 'fa-star-o text-muted'}"/>
            </span>
        </xpath>
        <xpath expr="//div[hasclass('product-price')]" position="before">
            <span t-if="props.mode === 'display' and vals.priceOriginIcon"
                  role="button"
                  tabindex="0"
                  class="o_pos_price_origin_icon d-flex align-items-center cursor-pointer px-1 me-1"
                  t-att-title="vals.priceOriginTitle + (vals.priceOriginDetail ? ' — ' + vals.priceOriginDetail : '')"
                  t-att-aria-label="vals.priceOriginTitle"
                  t-on-click.stop="(ev) => this.onPriceOriginClick(ev, props.line)">
                <i role="img" t-attf-class="fa fa-fw {{vals.priceOriginIcon}} {{vals.priceOriginColor}}"/>
            </span>
        </xpath>
    </t>

    <t t-name="entintados_pdv.PosPriceOriginPopover">
        <div class="o_pos_price_origin_popover p-2" style="max-width: 320px;">
            <div class="fw-bold" t-esc="props.title"/>
            <div t-if="props.detail" class="text-muted small mt-1" t-esc="props.detail"/>
        </div>
    </t>
</templates>
