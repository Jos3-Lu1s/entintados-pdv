<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.PartnerAdvanceBalance" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('partner-line-balance')]" position="inside">
            <div class="text-success fw-bold" t-if="props.partner.customer_advance_available gt 0">
                Saldo a favor: <t t-esc="env.utils.formatCurrency(props.partner.customer_advance_available)"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('company-field')]" position="after">
            <div class="text-success fw-bold" t-if="props.partner.customer_advance_available gt 0">
                Saldo a favor: <t t-esc="env.utils.formatCurrency(props.partner.customer_advance_available)"/>
            </div>
        </xpath>
    </t>
    <t t-name="entintados_pdv.AdvanceControls" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="pos.config.advance_risk_enabled" t-att-class="buttonClass" t-on-click="() => this.onClickAdvances()">
                <i class="fa fa-money me-1"/>Anticipo
            </button>
        </xpath>
    </t>
</templates>
