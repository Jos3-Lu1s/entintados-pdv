<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="entintados_pdv.PromoTogglePopup">
        <Dialog title="props.title">
            <div class="promo-toggle-popup p-2">
                <!-- Resumen de estado actual -->
                <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center">
                    <i class="fa fa-info-circle fa-lg me-2"/>
                    <div>
                        <t t-if="isCurrentPromo">
                            Rige actualmente: <strong>Promoción</strong> en las líneas elegibles de la orden.
                        </t>
                        <t t-else="">
                            Rigen actualmente: <strong>Acuerdos Comerciales</strong> pactados con el cliente.
                        </t>
                    </div>
                </div>

                <p class="text-muted mb-3">
                    Selecciona qué esquema de descuento deseas aplicar a los productos de esta venta:
                </p>

                <!-- Opción 1: Aplicar Promoción -->
                <div class="card p-3 mb-3 shadow-sm cursor-pointer border-2"
                     t-att-class="{'border-warning bg-light': isCurrentPromo, 'border-secondary-subtle': !isCurrentPromo}"
                     role="button"
                     t-on-click="() => this.selectMode('promo')">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="mb-0 text-dark">
                            <i class="fa fa-tags text-warning me-2"/>
                            <t t-esc="promoName"/>
                        </h5>
                        <span t-if="isCurrentPromo" class="badge bg-warning text-dark">
                            <i class="fa fa-check me-1"/>Aplicada
                        </span>
                    </div>
                    <p class="mb-1 text-secondary small">
                        Aplica <strong class="text-dark"><t t-esc="promoDiscount"/>% de descuento promocional</strong> en los productos elegibles del pedido.
                    </p>
                    <div class="text-end">
                        <button class="btn btn-sm btn-outline-warning text-dark font-weight-bold"
                                t-on-click.stop="() => this.selectMode('promo')">
                            Aplicar Promoción
                        </button>
                    </div>
                </div>

                <!-- Opción 2: Aplicar Acuerdos del Cliente -->
                <div class="card p-3 mb-3 shadow-sm cursor-pointer border-2"
                     t-att-class="{'border-primary bg-light': isCurrentAgreements, 'border-secondary-subtle': !isCurrentAgreements}"
                     role="button"
                     t-on-click="() => this.selectMode('commercial_agreements')">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="mb-0 text-dark">
                            <i class="fa fa-handshake-o text-primary me-2"/>
                            Acuerdos Comerciales del Cliente
                        </h5>
                        <span t-if="isCurrentAgreements" class="badge bg-primary text-white">
                            <i class="fa fa-check me-1"/>Aplicada
                        </span>
                    </div>
                    <p class="mb-1 text-secondary small">
                        Aplica los descuentos convenidos con <strong class="text-dark"><t t-esc="partnerName"/></strong> por producto, línea de producto, esquema o descuento global.
                    </p>
                    <div class="text-end">
                        <button class="btn btn-sm btn-outline-primary font-weight-bold"
                                t-on-click.stop="() => this.selectMode('commercial_agreements')">
                            Aplicar Acuerdos
                        </button>
                    </div>
                </div>

                <!-- Protección de precios fijos y colorantes -->
                <div class="text-muted small mt-2 d-flex align-items-center">
                    <i class="fa fa-shield me-2 text-success"/>
                    <span>Los Precios Fijos acordados y los colorantes formulados se mantienen protegidos e inalterables en ambas opciones.</span>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cerrar sin cambios
                </button>
            </t>
        </Dialog>
    </t>

</templates>
