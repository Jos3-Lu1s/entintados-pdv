<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Oculta el toggle de factura nativo en los botones de pago -->
    <t t-name="entintados_pdv.HidePaymentInvoiceToggle" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>
    </t>

    <!-- Clase de layout personalizado para la pantalla de pagos -->
    <t t-name="entintados_pdv.PaymentSummaryLayout" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('center-content')]" position="attributes">
            <attribute name="class" add="o-entintados-payment-layout" separator=" "/>
        </xpath>
    </t>

    <!-- Inserción del componente de resumen de compra -->
    <t t-name="entintados_pdv.PaymentScreenDueOverride" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//section" position="replace">
            <CustomerPaymentSummary currentOrder="currentOrder"/>
        </xpath>
    </t>
</templates>
