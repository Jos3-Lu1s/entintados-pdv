<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t
        t-name="entintados_pdv.ControlButtonsExtension"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >

        <!-- Botón visible directamente en escritorio -->
        <xpath
            expr="//button[hasclass('more-btn')]"
            position="before"
        >
            <button
                t-if="!props.showRemainingButtons and !this.pos.isSmallProductScreen"
                class="btn btn-secondary btn-lg flex-shrink-0"
                t-on-click="() => this.openTintColorScreen()"
                title="Seleccionar color"
            >
                <i
                    class="fa fa-paint-brush me-2"
                    role="img"
                    aria-label="Colores"
                />

                <span>Colores</span>
            </button>
        </xpath>

        <!-- Botón dentro del menú Más -->
        <xpath
            expr="//div[hasclass('control-buttons-modal')]"
            position="inside"
        >
            <button
                t-att-class="buttonClass"
                t-on-click="() => this.openTintColorScreen()"
            >
                <i
                    class="fa fa-paint-brush me-2"
                    role="img"
                    aria-label="Colores"
                />

                <span>Colores</span>
            </button>
        </xpath>

    </t>

</templates>