<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Pestañas de navegación y alternador de vista -->
    <t t-name="entintados_pdv.ProductScreenTintTabs" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="before">
            <div class="o-tint-tabs d-flex align-items-center gap-2 p-2 flex-shrink-0">
                <button class="btn btn-sm text-nowrap"
                        t-att-class="tintUi.tab === 'products' ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="() => this.setTintTab('products')">
                    <i class="fa fa-th-large me-1" role="img" aria-label="Productos"/>
                    Productos
                </button>
                <button class="btn btn-sm text-nowrap"
                        t-att-class="tintUi.tab === 'tint' ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="() => this.setTintTab('tint')">
                    <i class="fa fa-paint-brush me-1" role="img" aria-label="Entintados"/>
                    Entintados
                </button>

                <!-- Indicador y botón para cambiar de galería -->
                <div t-if="tintUi.tab === 'tint' and tintUi.galleryId"
                     class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
                    <span class="badge bg-info-subtle text-info-emphasis text-nowrap">Galería</span>
                    <span class="fw-bold text-truncate" style="max-width: 18rem;">
                        <t t-if="tintSelectedGallery and tintSelectedGallery.code">[<t t-esc="tintSelectedGallery.code"/>] </t>
                        <t t-esc="tintSelectedGallery and tintSelectedGallery.name"/>
                    </span>
                    <button class="btn btn-sm btn-outline-secondary text-nowrap"
                            t-on-click="() => this.changeTintGallery()">
                        <i class="fa fa-exchange me-1" role="img" aria-label="Cambiar galería"/>
                        Cambiar galería
                    </button>
                </div>

                <!-- Alternador de vista cuadrícula / lista -->
                <div t-if="tintUi.tab === 'products'" class="btn-group btn-group-sm ms-auto flex-shrink-0" role="group" aria-label="Vista de productos">
                    <button class="btn"
                            t-att-class="tintUi.viewMode === 'grid' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setProductViewMode('grid')"
                            title="Cuadrícula">
                        <i class="fa fa-th-large" role="img" aria-label="Cuadrícula"/>
                    </button>
                    <button class="btn"
                            t-att-class="tintUi.viewMode === 'list' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setProductViewMode('list')"
                            title="Lista">
                        <i class="fa fa-bars" role="img" aria-label="Lista"/>
                    </button>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="attributes">
            <attribute name="t-attf-class">{{ tintUi.tab === 'tint' ? 'd-none' : '' }}</attribute>
        </xpath>

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="after">
            <TintPanel t-if="tintUi.tab === 'tint'" uiState="tintUi"/>
        </xpath>

        <!-- Oculta la cuadrícula nativa en modo lista -->
        <xpath expr="//div[@t-on-scroll='onScroll']" position="attributes">
            <attribute name="t-attf-class">{{ tintUi.tab !== 'tint' and tintUi.viewMode === 'list' ? 'd-none' : '' }}</attribute>
        </xpath>

        <!-- Tabla de productos en modo lista -->
        <xpath expr="//div[hasclass('search-more-button')]" position="before">
            <div t-if="tintUi.tab !== 'tint' and tintUi.viewMode === 'list'"
                 class="o-tint-list flex-grow-1 overflow-y-auto px-2 pb-2">
                <TintTable t-if="pos.productsToDisplay.length" columns="productListColumns">
                    <t t-set-slot="rows">
                        <tr t-foreach="pos.productsToDisplay" t-as="product" t-key="product.id"
                            class="o-tint-row-tr"
                            t-on-click="() => this.addProductToOrder(product)">
                            <td class="o-tint-td-img">
                                <img t-if="pos.config.show_product_images and getProductImage(product)"
                                     class="o-tint-list-img"
                                     t-att-src="getProductImage(product)"
                                     t-att-alt="getProductName(product)"
                                     draggable="false"/>
                            </td>
                            <td>
                                <span class="fw-semibold" t-esc="getProductName(product)"/>
                                <span t-if="state.quantityByProductTmplId[product.id]"
                                      class="badge bg-primary ms-2"
                                      t-esc="state.quantityByProductTmplId[product.id]"/>
                            </td>
                            <td class="text-muted text-nowrap" t-esc="product.default_code or '—'"/>
                            <td class="text-muted text-nowrap" t-esc="product.uom_id and product.uom_id.name or ''"/>
                            <td class="text-end fw-bold text-nowrap" t-esc="tintRowPriceFormatted(product)"/>
                        </tr>
                    </t>
                </TintTable>
                <div t-else="" class="h-100 d-flex flex-column align-items-center justify-content-center text-muted py-5">
                    <i class="fa fa-search fa-3x mb-3 text-secondary"/>
                    <h5>No se encontraron productos</h5>
                </div>
            </div>
        </xpath>

    </t>

    <!-- Banner indicador del color activo seleccionado -->
    <t t-name="entintados_pdv.ProductScreenActiveTintBanner" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ControlButtons" position="before">
            <t t-set="activeOrder" t-value="pos.getOrder()"/>
            <div t-if="activeOrder and activeOrder.uiState and activeOrder.uiState.selectedTintColor" class="o-active-tint-banner">
                <div class="d-flex align-items-center">
                    <span class="tint-sample" t-att-style="'background-color:' + (activeOrder.uiState.selectedTintColor.html_color || '#9E9E9E')"/>
                    <div>
                        <strong>Color seleccionado: </strong>
                        <span class="fw-bold me-1">
                            <t t-esc="activeOrder.uiState.selectedTintColor.code ? '[' + activeOrder.uiState.selectedTintColor.code + '] ' : ''"/>
                            <t t-esc="activeOrder.uiState.selectedTintColor.name"/>
                        </span>
                        <small class="text-warning d-block d-sm-inline ms-sm-2">
                            (Selecciona ahora un producto base de pintura)
                        </small>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-light ms-3" t-on-click="() => this.clearSelectedTintColor()" title="Cancelar selección de color">
                    <i class="fa fa-times me-1"/> Cancelar
                </button>
            </div>
        </xpath>
    </t>

</templates>
