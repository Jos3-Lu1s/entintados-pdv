<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
      Pestañas de la pantalla de productos.

      La pestaña intercambia el COMPONENTE, no los datos: se le añade `d-none`
      al contenedor nativo de la grilla y se renderiza `TintPanel` como
      hermano. Así no hay que sobreescribir `productsToDisplay` ni
      `addProductToOrder`, ni hacer que nada finja ser un producto.
    -->
    <t t-name="entintados_pdv.ProductScreenTintTabs" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="before">
            <div class="o-tint-tabs d-flex gap-2 px-2 pt-2 flex-shrink-0">
                <button class="btn btn-sm text-nowrap"
                        t-att-class="tintUi.tab === 'products' ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="() => this.setTintTab('products')">
                    <i class="fa fa-th-large me-1" role="img" aria-label="Productos"/>
                    Productos
                </button>
                <button class="btn btn-sm text-nowrap"
                        t-att-class="tintUi.tab === 'tint' ? 'btn-primary' : 'btn-outline-secondary'"
                        t-on-click="() => this.setTintTab('tint')">
                    <i class="fa fa-paint-brush me-1" role="img" aria-label="Entintados"/>
                    Entintados
                </button>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="attributes">
            <attribute name="t-attf-class">{{ tintUi.tab === 'tint' ? 'd-none' : '' }}</attribute>
        </xpath>

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="after">
            <TintPanel t-if="tintUi.tab === 'tint'"/>
        </xpath>

    </t>

    <!-- Banner del color activo mientras el cajero busca la base a entintar -->
    <t t-name="entintados_pdv.ProductScreenActiveTintBanner" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ControlButtons" position="before">
            <t t-set="activeOrder" t-value="pos.getOrder()"/>
            <div t-if="activeOrder and activeOrder.uiState and activeOrder.uiState.selectedTintColor" class="o-active-tint-banner">
                <div class="d-flex align-items-center">
                    <span class="tint-sample" t-att-style="'background-color:' + (activeOrder.uiState.selectedTintColor.html_color || '#9E9E9E')"/>
                    <div>
                        <strong>Color seleccionado: </strong>
                        <span class="fw-bold me-1">
                            <t t-esc="activeOrder.uiState.selectedTintColor.code ? '[' + activeOrder.uiState.selectedTintColor.code + '] ' : ''"/>
                            <t t-esc="activeOrder.uiState.selectedTintColor.name"/>
                        </span>
                        <small class="text-warning d-block d-sm-inline ms-sm-2">
                            (Selecciona ahora un producto base de pintura)
                        </small>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-light ms-3" t-on-click="() => this.clearSelectedTintColor()" title="Cancelar selección de color">
                    <i class="fa fa-times me-1"/> Cancelar
                </button>
            </div>
        </xpath>
    </t>

</templates>
