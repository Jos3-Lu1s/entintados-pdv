<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="entintados_pdv.TintPanel">
        <div class="o-tint-panel d-flex flex-column flex-grow-1 overflow-hidden">

            <!-- Barra superior / Filtros -->
            <div t-if="hasCatalog and (state.colorId or searchTerm)" class="flex-shrink-0 border rounded bg-view m-2 p-3">

                <!-- Sin color seleccionado: búsqueda activa -->
                <div t-if="!state.colorId">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <small t-if="searchTerm" class="text-muted">
                            Buscando color: «<t t-esc="searchTerm"/>»
                        </small>
                    </div>
                </div>

                <!-- Color seleccionado: filtros en cascada -->
                <div t-else="">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle border flex-shrink-0"
                              t-attf-style="width: 1.25rem; height: 1.25rem; background-color: {{ selectedColor and selectedColor.html_color or '#E0E0E0' }};"/>
                        <span class="fw-bold text-truncate">
                            <t t-if="selectedColor and selectedColor.code">[<t t-esc="selectedColor.code"/>] </t>
                            <t t-esc="selectedColor and selectedColor.name"/>
                        </span>
                        <button class="btn btn-sm btn-outline-secondary text-nowrap ms-auto"
                                t-on-click="() => this.clearFilters()">
                            Limpiar filtros
                        </button>
                        <button class="btn btn-sm btn-outline-secondary text-nowrap"
                                t-on-click="() => this.clearColor()">
                            Cambiar color
                        </button>
                    </div>

                    <div t-foreach="levels" t-as="level" t-key="level.key"
                         class="d-flex align-items-center gap-2 mb-1">
                        <small class="text-muted text-nowrap" style="width: 6.5rem;"
                               t-esc="level.label"/>
                        <div t-if="level.options.length" class="d-flex flex-wrap gap-1">
                            <button t-foreach="level.options" t-as="opt" t-key="opt.record.id"
                                    class="btn btn-sm text-nowrap"
                                    t-att-class="level.selected === opt.record.id ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.selectLevel(level.key, opt.record.id)">
                                <t t-esc="opt.record.name"/>
                                <span class="badge bg-secondary bg-opacity-50 ms-1" t-esc="opt.count"/>
                            </button>
                        </div>
                        <small t-else="" class="text-muted fst-italic">
                            —
                        </small>
                    </div>
                </div>

            </div>

            <!-- Contenido -->
            <div class="flex-grow-1 overflow-auto px-2 pb-2">

                <div t-if="missingModels.length" class="alert alert-danger" role="alert">
                    <strong>Modelos que no existen en el cliente:</strong>
                    <t t-esc="missingModels.map(m => m.label).join(', ')"/>.
                    <div class="mt-1">
                        Falta registrarlos en <code>_load_pos_data_models</code>
                        (<code>pos_session.py</code>) o en <code>tint_models.js</code>.
                    </div>
                </div>

                <div t-if="emptyModels.length" class="alert alert-warning" role="alert">
                    <strong>Modelos cargados pero sin registros:</strong>
                    <t t-esc="emptyModels.map(m => m.label).join(', ')"/>.
                    <div class="mt-1">
                        El cliente conoce el modelo, así que el problema está del lado del
                        servidor. Dos causas, en este orden:
                    </div>
                    <ol class="mb-0 mt-1">
                        <li>
                            El servidor no recargó el Python. Añadir <code>pos.load.mixin</code>
                            exige reiniciar Odoo con <code>-u entintados_pdv</code>; no basta
                            con refrescar el navegador ni reabrir la sesión.
                        </li>
                        <li>
                            No hay registros que cargar. Compruébalo en
                            <em>Entintados → Configuración</em>.
                        </li>
                    </ol>
                </div>

                <div t-if="formulasWithoutGallery" class="alert alert-warning" role="alert">
                    <strong>
                        <t t-esc="formulasWithoutGallery"/> de <t t-esc="formulaCount"/> fórmulas
                        no tienen galería.
                    </strong>
                    <div class="mt-1">
                        Asígnala en <em>Entintados → Carta de color → Fórmulas</em>, campo
                        <em>Galería</em>, o el filtrado no tiene por dónde empezar.
                    </div>
                </div>

                <t t-if="hasCatalog">

                    <!-- Tabla de colores -->
                    <t t-if="!state.colorId">
                        <TintTable t-if="colors.length" columns="colorColumns">
                            <t t-set-slot="rows">
                                <tr t-foreach="colors" t-as="color" t-key="color.id"
                                    class="o-tint-row-tr"
                                    t-on-click="() => this.selectColor(color.id)">
                                    <td class="o-tint-td-swatch">
                                        <span class="rounded-circle border d-inline-block align-middle"
                                              t-attf-style="width: 1.5rem; height: 1.5rem; background-color: {{ color.html_color or '#E0E0E0' }};"/>
                                    </td>
                                    <td class="text-nowrap">
                                        <span t-if="color.code" class="badge bg-secondary" t-esc="color.code"/>
                                        <span t-else="" class="text-muted">—</span>
                                    </td>
                                    <td class="fw-semibold" t-esc="color.name"/>
                                </tr>
                            </t>
                        </TintTable>
                        <div t-else=""
                             class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-search fa-3x mb-3 text-secondary"/>
                            <h5>Ningún color coincide</h5>
                            <p class="mb-0">Ajusta el término de búsqueda.</p>
                        </div>
                    </t>

                    <!-- Tabla de bases del color seleccionado -->
                    <t t-else="">

                        <div t-if="unsellableCount" class="alert alert-warning" role="alert">
                            <strong>
                                <t t-esc="unsellableCount"/>
                                <t t-if="unsellableCount === 1"> fórmula sin producto base</t>
                                <t t-else=""> fórmulas sin producto base</t>
                                para este color.
                            </strong>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <div class="fw-bold small">La fórmula pide</div>
                                    <ul class="mb-0 small">
                                        <li t-foreach="missingCombos" t-as="combo" t-key="combo"
                                            t-esc="combo"/>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <div class="fw-bold small">
                                        Bases que conoce la caja
                                        (<t t-esc="loadedBases.length"/>)
                                    </div>
                                    <ul t-if="loadedBases.length" class="mb-0 small">
                                        <li t-foreach="loadedBases" t-as="base" t-key="base.id">
                                            <t t-esc="base.combo"/>
                                            <span class="text-muted"> — <t t-esc="base.name"/></span>
                                        </li>
                                    </ul>
                                    <div t-else="" class="small">
                                        Ninguna. Los productos base no están llegando al POS:
                                        revisa <em>Disponible en PdV</em> y <em>Puede venderse</em>
                                        en su ficha.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div t-if="state.loadingFormulas and !cards.length"
                             class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-spinner fa-spin fa-3x mb-3 text-secondary"/>
                            <h5>Cargando fórmulas…</h5>
                        </div>

                        <TintTable t-elif="cards.length" columns="baseColumns">
                            <t t-set-slot="rows">
                                <tr t-foreach="cards" t-as="card" t-key="card.key"
                                    class="o-tint-row-tr"
                                    t-on-click="() => this.addCard(card)">
                                    <td class="fw-semibold" t-esc="card.baseProduct.display_name"/>
                                    <td class="text-muted small">
                                        <t t-esc="card.baseType and card.baseType.name"/>
                                        <t t-if="card.size"> · <t t-esc="card.size.name"/></t>
                                        <t t-if="!galleryFilterActive and card.gallery"> · <t t-esc="card.gallery.name"/></t>
                                    </td>
                                    <td class="text-end text-muted text-nowrap"
                                        t-esc="formatPoints(card.totalPoints)"/>
                                    <td class="text-end fw-bold text-nowrap"
                                        t-esc="formatPrice(card.price)"/>
                                </tr>
                            </t>
                        </TintTable>

                        <div t-else=""
                             class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-filter fa-3x mb-3 text-secondary"/>
                            <h5 t-if="searchTerm">Ninguna base coincide con «<t t-esc="searchTerm"/>»</h5>
                            <h5 t-else="">No hay bases para esta combinación</h5>
                            <p class="mb-0">
                                <t t-if="searchTerm">Limpia el buscador de arriba, </t>
                                <t t-else="">Quita algún filtro o </t>
                                cambia de color.
                            </p>
                        </div>

                    </t>

                </t>

            </div>

        </div>
    </t>

</templates>
