<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="entintados_pdv.TintColorScreen">

        <div class="tint-color-screen d-flex flex-column h-100">

            <div class="d-flex align-items-center gap-2 p-2 bg-white border-bottom">
                <button
                    class="btn btn-secondary btn-lg flex-shrink-0"
                    t-on-click="() => this.goBack()"
                >
                    <i class="fa fa-arrow-left me-2"/>
                    Regresar
                </button>

                <input
                    type="text"
                    class="form-control form-control-lg flex-grow-1"
                    placeholder="Buscar por código o nombre de color..."
                    t-model="state.search"
                />
            </div>

            <div class="flex-grow-1 overflow-auto p-3">

                <div
                    t-if="colors.length"
                    class="tint-color-grid"
                >
                    <button
                        t-foreach="colors"
                        t-as="color"
                        t-key="color.id"
                        class="tint-color-card text-start border shadow-sm rounded-3 overflow-hidden p-3 bg-white d-flex flex-column justify-content-between"
                        t-on-click="() => this.selectColor(color)"
                    >
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span t-if="color.code" class="badge bg-secondary fs-6">
                                <t t-esc="color.code"/>
                            </span>
                            <i class="fa fa-paint-brush text-primary fs-5" role="img"/>
                        </div>

                        <div>
                            <strong
                                class="d-block text-dark text-truncate fs-5"
                                t-esc="color.name"
                            />
                            <small t-if="color.base_type_summary" class="text-muted d-block text-truncate mt-1">
                                Bases: <t t-esc="color.base_type_summary"/>
                            </small>
                        </div>
                    </button>
                </div>

                <div
                    t-else=""
                    class="h-100 d-flex flex-column align-items-center justify-content-center text-muted"
                >
                    <i class="fa fa-paint-brush fa-3x mb-3 text-secondary"/>
                    <h4>No se encontraron colores registrados</h4>
                </div>

            </div>

        </div>

    </t>

</templates>