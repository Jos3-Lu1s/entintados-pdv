<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="entintados_pdv.OrderReceiptExtendido"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension"
       owl="1">

        <!-- Ejemplo: agregar un mensaje debajo del encabezado -->
        <xpath expr="//Orderline" position="attributes">
            <attribute name="t-if">line.product_id.tint_role !== 'colorant'</attribute>
        </xpath>

    </t>
</templates>