<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Pestañas de navegación y alternador de vista -->
    <t t-name="entintados_pdv.ProductScreenTintTabs" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="before">
            <div class="o-tint-tabs d-flex align-items-center justify-content-between p-2 flex-shrink-0 border-bottom bg-view min-w-0 w-100">
                <!-- Segmented Control Principal: Productos / Entintados -->
                <div class="o-tint-segmented-control bg-light p-1 rounded-pill border d-inline-flex">
                    <button class="btn btn-sm rounded-pill px-3 py-1 text-nowrap fw-semibold transition-all d-flex align-items-center gap-1"
                            t-att-class="tintUi.tab === 'products' ? 'btn-white bg-white text-dark shadow-xs border-0' : 'text-secondary-emphasis border-0 bg-transparent'"
                            t-on-click="() => this.setTintTab('products')">
                        <i class="fa fa-th-large"/>
                        <span>Productos</span>
                    </button>
                    <button class="btn btn-sm rounded-pill px-3 py-1 text-nowrap fw-semibold transition-all d-flex align-items-center gap-1"
                            t-att-class="tintUi.tab === 'tint' ? 'btn-white bg-white text-primary shadow-xs border-0' : 'text-secondary-emphasis border-0 bg-transparent'"
                            t-on-click="() => this.setTintTab('tint')">
                        <i class="fa fa-paint-brush"/>
                        <span>Entintados</span>
                    </button>
                </div>

                <!-- Acciones contextuales según pestaña activa -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <!-- Vista Productos: Alternador Cuadrícula / Lista -->
                    <div t-if="tintUi.tab === 'products'" class="btn-group btn-group-sm rounded-pill border bg-light p-1" role="group" aria-label="Vista de productos">
                        <button class="btn btn-sm rounded-pill px-3 py-1 border-0 d-flex align-items-center gap-1"
                                t-att-class="tintUi.viewMode === 'grid' ? 'bg-white text-dark shadow-xs fw-semibold' : 'text-secondary-emphasis bg-transparent'"
                                t-on-click="() => this.setProductViewMode('grid')"
                                title="Vista en cuadrícula">
                            <i class="fa fa-th-large"/>
                            <span class="d-none d-md-inline small">Cuadrícula</span>
                        </button>
                        <button class="btn btn-sm rounded-pill px-3 py-1 border-0 d-flex align-items-center gap-1"
                                t-att-class="tintUi.viewMode === 'list' ? 'bg-white text-dark shadow-xs fw-semibold' : 'text-secondary-emphasis bg-transparent'"
                                t-on-click="() => this.setProductViewMode('list')"
                                title="Vista en lista">
                            <i class="fa fa-bars"/>
                            <span class="d-none d-md-inline small">Lista</span>
                        </button>
                    </div>

                    <!-- Vista Entintados: Botón Crear Color -->
                    <div t-if="tintUi.tab === 'tint'" class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 shadow-xs d-flex align-items-center gap-1 text-nowrap"
                                t-on-click="() => this.onClickCreateColorFromTab()">
                            <i class="fa fa-plus-circle"/>
                            <span>Crear Color</span>
                        </button>
                    </div>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="attributes">
            <attribute name="t-attf-class">{{ tintUi.tab === 'tint' ? 'd-none' : '' }}</attribute>
        </xpath>

        <xpath expr="//div[hasclass('rightpane')]/div[hasclass('position-relative')]" position="after">
            <TintPanel t-if="tintUi.tab === 'tint'" uiState="tintUi"/>
        </xpath>

        <!-- Oculta la cuadrícula nativa en modo lista -->
        <xpath expr="//div[@t-on-scroll='onScroll']" position="attributes">
            <attribute name="t-attf-class">{{ tintUi.tab !== 'tint' and tintUi.viewMode === 'list' ? 'd-none' : '' }}</attribute>
        </xpath>

        <!-- Tabla de productos en modo lista -->
        <xpath expr="//div[hasclass('search-more-button')]" position="before">
            <div t-if="tintUi.tab !== 'tint' and tintUi.viewMode === 'list'"
                 class="o-tint-list d-flex flex-column flex-grow-1 min-h-0 px-2 pb-2 overflow-hidden">
                <TintTable t-if="pos.productsToDisplay.length" columns="productListColumns">
                    <t t-set-slot="rows">
                        <tr t-foreach="pos.productsToDisplay" t-as="product" t-key="product.id"
                            class="o-tint-row-tr"
                            t-on-click="() => this.addProductToOrder(product)">
                            <td class="py-2 text-nowrap">
                                <span class="text-secondary-emphasis font-monospace small" t-esc="product.default_code or '—'"/>
                            </td>
                            <td class="py-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-dark" t-esc="getProductName(product)"/>
                                    <span t-if="state.quantityByProductTmplId[product.id]"
                                          class="badge rounded-pill bg-primary-subtle text-primary fw-bold px-2 py-1"
                                          style="font-size: 0.65rem;"
                                          t-esc="state.quantityByProductTmplId[product.id]"/>
                                    <span t-if="product.tint_role === 'base'" class="text-info small fw-semibold">Base</span>
                                    <span t-elif="product.tint_role === 'colorant'" class="text-warning-emphasis small fw-semibold">Colorante</span>
                                </div>
                            </td>
                            <td class="py-2 text-nowrap">
                                <span class="text-secondary-emphasis small" t-esc="product.uom_id and product.uom_id.name or '—'"/>
                            </td>
                            <td class="py-2 text-end fw-bold text-nowrap text-dark fs-6" t-esc="tintRowPriceFormatted(product)"/>
                        </tr>
                    </t>
                </TintTable>
                <div t-else="" class="h-100 flex-grow-1 d-flex flex-column align-items-center justify-content-center o-tint-empty-state py-5">
                    <i class="fa fa-search fa-3x mb-3 text-secondary"/>
                    <h5>No se encontraron productos</h5>
                </div>
            </div>
        </xpath>

    </t>

    <!-- Banner indicador del color activo seleccionado -->
    <t t-name="entintados_pdv.ProductScreenActiveTintBanner" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ControlButtons" position="before">
            <t t-set="activeOrder" t-value="pos.getOrder()"/>
            <div t-if="activeOrder and activeOrder.uiState and activeOrder.uiState.selectedTintColor"
                 class="o-active-tint-banner d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1">
                    <i class="fa fa-paint-brush text-white fs-5 flex-shrink-0" role="img"/>
                    <div class="min-w-0">
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                            <strong class="text-white text-nowrap">Color seleccionado:</strong>
                            <span class="fw-bold text-white text-truncate">
                                <t t-esc="activeOrder.uiState.selectedTintColor.code ? '[' + activeOrder.uiState.selectedTintColor.code + '] ' : ''"/>
                                <t t-esc="activeOrder.uiState.selectedTintColor.name"/>
                            </span>
                        </div>
                        <small class="text-warning d-block">
                            (Selecciona ahora un producto base de pintura)
                        </small>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-light flex-shrink-0 ms-auto"
                        t-on-click="() => this.clearSelectedTintColor()"
                        title="Cancelar selección de color">
                    <i class="fa fa-times me-1"/> Cancelar
                </button>
            </div>
        </xpath>
    </t>

</templates>
