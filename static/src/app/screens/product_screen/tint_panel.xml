<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="entintados_pdv.TintPanel">
        <div class="o-tint-panel d-flex flex-column flex-grow-1 overflow-hidden">

            <!-- Filtros de base y color seleccionado -->
            <div t-if="ui.colorId" class="flex-shrink-0 border rounded bg-view mx-2 mb-2 p-3">
                <div class="d-flex align-items-center gap-2" t-att-class="{ 'mb-2': levels.length }">
                    <i class="fa fa-paint-brush text-primary" role="img"/>
                    <span class="fw-bold text-truncate">
                        <t t-if="selectedColor and selectedColor.code"><span class="badge bg-secondary me-1"><t t-esc="selectedColor.code"/></span></t>
                        <t t-esc="selectedColor and selectedColor.name"/>
                    </span>
                    <button t-if="hasActiveFilters" class="btn btn-sm btn-outline-secondary text-nowrap ms-auto"
                            t-on-click="() => this.clearFilters()">
                        Limpiar filtros
                    </button>
                    <button class="btn btn-sm btn-outline-secondary text-nowrap"
                            t-att-class="{ 'ms-auto': !hasActiveFilters }"
                            t-on-click="() => this.clearColor()">
                        Cambiar color
                    </button>
                </div>

                <div t-foreach="levels" t-as="level" t-key="level.key"
                     class="d-flex align-items-center gap-2 mb-1">
                    <small class="text-muted text-nowrap" style="width: 6.5rem;"
                           t-esc="level.label"/>
                    <div class="d-flex flex-wrap gap-1">
                        <button t-foreach="level.options" t-as="opt" t-key="opt.record.id"
                                class="btn btn-sm text-nowrap"
                                t-att-class="level.selected === opt.record.id ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.selectLevel(level.key, opt.record.id)">
                            <t t-esc="opt.record.name"/>
                            <span class="badge ms-1"
                                  t-att-class="level.selected === opt.record.id ? 'bg-white text-primary fw-bold' : 'bg-secondary text-dark'"
                                  t-esc="opt.count"/>
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex-grow-1 overflow-auto px-2 pb-2">

                <div t-if="missingModels.length" class="alert alert-danger" role="alert">
                    <strong>Modelos que no existen en el cliente:</strong>
                    <t t-esc="missingModels.map(m => m.label).join(', ')"/>.
                    <div class="mt-1">
                        Falta registrarlos en <code>_load_pos_data_models</code>
                        (<code>pos_session.py</code>) o en <code>tint_models.js</code>.
                    </div>
                </div>

                <div t-if="formulasWithoutGallery" class="alert alert-warning" role="alert">
                    <strong>
                        <t t-esc="formulasWithoutGallery"/> de <t t-esc="formulaCount"/> fórmulas
                        no tienen galería.
                    </strong>
                    <div class="mt-1">
                        Asígnala en <em>Entintados → Carta de color → Fórmulas</em>, campo
                        <em>Galería</em>, o el filtrado no tiene por dónde empezar.
                    </div>
                </div>

                <t t-if="galleryOptions.length">

                    <!-- Paso 1: Selección de galería -->
                    <t t-if="!ui.galleryId">
                        <div class="px-1 pb-2 pt-1">
                            <small class="text-muted fw-semibold d-block mb-2">
                                Elige una galería para empezar:
                            </small>
                            <div class="d-flex flex-wrap gap-2">
                                <button t-foreach="galleryOptions" t-as="gallery" t-key="gallery.id"
                                        class="btn btn-outline-primary text-nowrap"
                                        t-on-click="() => this.selectGallery(gallery.id)">
                                    <i class="fa fa-folder-open-o me-1" role="img" aria-label="Galería"/>
                                    <t t-if="gallery.code">[<t t-esc="gallery.code"/>] </t>
                                    <t t-esc="gallery.name"/>
                                </button>
                            </div>
                        </div>
                    </t>

                    <!-- Paso 2: Selección de color -->
                    <t t-elif="!ui.colorId">
                        <div t-if="ui.loadingColors and !colors.length"
                             class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-spinner fa-spin fa-3x mb-3 text-secondary"/>
                            <h5>Cargando colores…</h5>
                        </div>

                        <TintTable t-elif="colors.length" columns="colorColumns">
                            <t t-set-slot="rows">
                                <tr t-foreach="colors" t-as="color" t-key="color.id"
                                    class="o-tint-row-tr"
                                    t-on-click="() => this.selectColor(color.id)">
                                    <td class="text-nowrap">
                                        <span t-if="color.code" class="badge bg-secondary" t-esc="color.code"/>
                                        <span t-else="" class="text-muted">—</span>
                                    </td>
                                    <td class="fw-semibold" t-esc="color.name"/>
                                    <td class="text-nowrap text-muted small">
                                        <t t-if="selectedGallery and selectedGallery.code">[<t t-esc="selectedGallery.code"/>] </t>
                                        <t t-esc="selectedGallery and selectedGallery.name"/>
                                    </td>
                                    <td class="text-muted small">
                                        <t t-if="color.base_type_summary" t-esc="color.base_type_summary"/>
                                        <span t-else="">—</span>
                                    </td>
                                </tr>
                            </t>
                        </TintTable>

                        <div t-else=""
                             class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-search fa-3x mb-3 text-secondary"/>
                            <h5 t-if="searchTerm">Ningún color coincide con «<t t-esc="searchTerm"/>»</h5>
                            <h5 t-else="">Esta galería no tiene colores</h5>
                            <p class="mb-0">
                                <t t-if="searchTerm">Ajusta el término de búsqueda o </t>
                                <t t-else="">Prueba otra galería o </t>
                                revisa las fórmulas de esta galería.
                            </p>
                        </div>
                    </t>

                    <!-- Paso 3: Selección de base -->
                    <t t-else="">

                        <div t-if="unsellableCount" class="alert alert-warning" role="alert">
                            <strong>
                                <t t-esc="unsellableCount"/>
                                <t t-if="unsellableCount === 1"> fórmula sin producto base</t>
                                <t t-else=""> fórmulas sin producto base</t>
                                para este color.
                            </strong>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <div class="fw-bold small">La fórmula pide</div>
                                    <ul class="mb-0 small">
                                        <li t-foreach="missingCombos" t-as="combo" t-key="combo"
                                            t-esc="combo"/>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <div class="fw-bold small">
                                        Bases que conoce la caja
                                        (<t t-esc="loadedBases.length"/>)
                                    </div>
                                    <ul t-if="loadedBases.length" class="mb-0 small">
                                        <li t-foreach="loadedBases" t-as="base" t-key="base.id">
                                            <t t-esc="base.combo"/>
                                            <span class="text-muted"> — <t t-esc="base.name"/></span>
                                        </li>
                                    </ul>
                                    <div t-else="" class="small">
                                        Ninguna. Los productos base no están llegando al POS:
                                        revisa <em>Disponible en PdV</em> y <em>Puede venderse</em>
                                        en su ficha.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div t-if="ui.loadingFormulas and !cards.length"
                             class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-spinner fa-spin fa-3x mb-3 text-secondary"/>
                            <h5>Cargando fórmulas…</h5>
                        </div>

                        <TintTable t-elif="cards.length" columns="baseColumns">
                            <t t-set-slot="rows">
                                <tr t-foreach="cards" t-as="card" t-key="card.key"
                                    class="o-tint-row-tr"
                                    t-on-click="() => this.addCard(card)">
                                    <td class="text-nowrap">
                                        <span t-if="card.baseProduct.default_code" class="badge bg-secondary" t-esc="card.baseProduct.default_code"/>
                                        <span t-else="" class="text-muted">—</span>
                                    </td>
                                    <td class="fw-semibold" t-esc="card.baseProduct.display_name"/>
                                    <td class="text-muted small text-nowrap">
                                        <t t-if="card.baseType and card.baseType.name" t-esc="card.baseType.name"/>
                                        <span t-else="" class="text-muted">—</span>
                                    </td>
                                    <td class="text-muted small text-nowrap">
                                        <t t-if="card.size and card.size.name" t-esc="card.size.name"/>
                                        <span t-else="" class="text-muted">—</span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span class="text-muted" t-esc="formatPoints(card.totalPoints)"/>
                                        <small t-if="card.totalPoints >= 48" class="text-muted ms-1">
                                            (<t t-esc="card.totalPoints"/> Pts.)
                                        </small>
                                    </td>
                                    <td class="text-end fw-bold text-nowrap"
                                        t-esc="formatPrice(card.price)"/>
                                </tr>
                            </t>
                        </TintTable>

                        <div t-else=""
                             class="h-100 d-flex flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-filter fa-3x mb-3 text-secondary"/>
                            <h5 t-if="searchTerm">Ninguna base coincide con «<t t-esc="searchTerm"/>»</h5>
                            <h5 t-else="">No hay bases para esta combinación</h5>
                            <p class="mb-0">
                                <t t-if="searchTerm">Limpia el buscador de arriba, </t>
                                <t t-else="">Quita algún filtro o </t>
                                cambia de color.
                            </p>
                        </div>

                    </t>

                </t>

                <div t-else="" class="alert alert-warning" role="alert">
                    <strong>No hay galerías cargadas en la caja.</strong>
                    <div class="mt-1">
                        Crea al menos una galería en <em>Entintados → Configuración</em> y
                        reinicia la sesión de POS.
                    </div>
                </div>

            </div>

        </div>
    </t>

</templates>
