<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.ProductScreenCustomerRequired"
       t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('rightpane')]" position="attributes">
            <attribute name="class" add="position-relative" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('rightpane')]" position="inside">
            <div t-if="pos.getOrder()?.partner_id" class="px-3 py-1 small text-muted" role="status">
                Vendedor: <span t-esc="pos.getOrder().partner_id.sale_owner_name || 'Sin vendedor asignado'"/>
            </div>
            <div t-if="!pos.getOrder()?.partner_id and !pos.scanning"
                 class="o-pos-customer-gate position-absolute bg-view d-flex flex-column align-items-center justify-content-center text-center p-4"
                 role="region"
                 aria-label="Cliente requerido">
                <i class="fa fa-user-circle-o fa-4x text-muted opacity-50" aria-hidden="true"/>
                <h3 class="mt-3 mb-2">Selecciona un cliente para empezar</h3>
                <p class="o-pos-customer-gate-text text-muted mb-4">
                    Los precios, convenios y fórmulas de color dependen del cliente de la orden.
                </p>
                <button class="o-pos-customer-gate-btn btn btn-primary btn-lg px-5 py-3"
                        t-on-click="() => pos.selectPartner()">
                    <i class="fa fa-user me-2" aria-hidden="true"/>Seleccionar cliente
                </button>
                <small class="text-muted mt-3">
                    <i class="fa fa-barcode me-1" aria-hidden="true"/>También puedes escanear la tarjeta del cliente
                </small>
            </div>
        </xpath>
    </t>
</templates>
