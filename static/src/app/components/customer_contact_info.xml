<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.CustomerContactInfo">
        <div t-if="partner" class="o-pos-contact-info small" aria-label="Información del cliente">
            <t t-set="info" t-value="partner.pos_contact_info || {}"/>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <strong class="text-break" t-esc="partner.name"/>
                <span t-if="partner.is_credit or (partner.commercial_partner_id and partner.commercial_partner_id.is_credit)"
                      class="badge rounded-pill text-bg-primary" title="Cliente con condición de pago a crédito">
                    <i class="fa fa-credit-card me-1" aria-hidden="true"/>Crédito
                </span>
                <span t-if="info.reference" class="badge text-bg-light border">Clave: <t t-esc="info.reference"/></span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                <strong t-if="info.vat" class="badge bg-light text-dark border fs-6 text-wrap text-break">
                    RFC: <t t-esc="info.vat"/>
                </strong>
                <span class="text-muted">Vendedor: <t t-esc="info.salesperson || partner.sale_owner_name || 'Sin vendedor asignado'"/></span>
                <span t-if="partner.total_due !== undefined and partner.total_due !== null"
                      class="text-nowrap border-start ps-2">
                    <span class="text-muted">Deuda actual: </span>
                    <strong t-esc="env.utils.formatCurrency(partner.total_due)"/>
                </span>
                <span class="text-nowrap border-start ps-2">
                    <span class="text-muted">Límite de crédito autorizado: </span>
                    <strong t-if="info.credit_authorized"><t t-esc="info.credit_limit_text"/> <t t-esc="info.credit_currency"/></strong>
                    <strong t-else="" class="text-muted">Sin crédito autorizado</strong>
                </span>
                <span t-if="partner.customer_advance_available !== undefined and partner.customer_advance_available !== null"
                      class="text-nowrap border-start ps-2">
                    <span class="text-muted">Anticipo disponible (saldo a favor): </span>
                    <strong class="text-success" t-esc="env.utils.formatCurrency(partner.customer_advance_available)"/>
                </span>
            </div>
            <details class="mt-2" t-if="info.address || info.fiscal_regime || info.invoice || info.delivery">
                <summary class="text-primary">Direcciones y datos fiscales</summary>
                <div class="text-break pt-2">
                    <p t-if="info.address" class="mb-1"><strong>Dirección: </strong><t t-esc="info.address"/></p>
                    <p t-if="info.fiscal_regime" class="mb-2"><strong>Régimen fiscal: </strong><t t-esc="info.fiscal_regime"/></p>
                    <div class="row g-2">
                        <div t-if="info.invoice" class="col-12 col-md-6">
                            <strong class="d-block">Dirección de factura</strong>
                            <span class="d-block" t-esc="info.invoice.name"/>
                            <span class="text-muted" t-esc="info.invoice.address || 'Sin dirección registrada'"/>
                        </div>
                        <div t-if="info.delivery" class="col-12 col-md-6">
                            <strong class="d-block">Dirección de entrega</strong>
                            <span class="d-block" t-esc="info.delivery.name"/>
                            <span class="text-muted" t-esc="info.delivery.address || 'Sin dirección registrada'"/>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Direcciones predeterminadas del contacto.</small>
                </div>
            </details>
        </div>
    </t>
</templates>
