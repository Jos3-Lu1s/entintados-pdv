<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="entintados_pdv.TintFormulaPopup">
        <Dialog title="props.title" size="'lg'">
            <div class="entintado-popup p-2">

                <!-- Información de base y presentación -->
                <div class="d-flex align-items-center gap-2 mb-2 text-muted">
                    <i class="fa fa-flask" role="img"/>
                    <span>
                        <t t-esc="baseType and baseType.name or '—'"/>
                        <t t-if="size"> · <t t-esc="size.name"/></t>
                    </span>
                    <span t-if="capacityPoints" class="badge text-bg-light ms-auto">
                        Capacidad: <t t-esc="formatPoints(capacityPoints)"/>
                    </span>
                </div>

                <!-- Búsqueda de color y botón para crear nuevo color -->
                <div class="d-flex gap-2 mb-2">
                    <input type="text" class="form-control"
                           t-model="state.search"
                           placeholder="Buscar color por nombre o código…"/>
                    <button class="btn btn-outline-primary text-nowrap"
                            type="button"
                            t-on-click="openCreateColor">
                        <i class="fa fa-plus-circle me-1" role="img"/> Nuevo Color
                    </button>
                </div>

                <div class="row g-2">
                    <!-- Lista de colores -->
                    <div class="col-5">
                        <div class="list-group entintado-color-list"
                             style="max-height: 340px; overflow-y: auto;">
                            <button t-foreach="availableColors" t-as="color" t-key="color.id"
                                    type="button"
                                    class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                    t-att-class="{ active: color.id === state.colorId }"
                                    t-on-click="() => this.selectColor(color.id)">
                                <i class="fa fa-paint-brush text-primary flex-shrink-0" role="img"/>
                                <span class="text-truncate">
                                    <t t-if="color.code"><span class="badge bg-secondary me-1"><t t-esc="color.code"/></span></t>
                                    <t t-esc="color.name"/>
                                </span>
                            </button>
                            <div t-if="!availableColors.length"
                                 class="list-group-item text-muted fst-italic">
                                No hay colores con fórmula para esta base y presentación.
                            </div>
                        </div>
                    </div>

                    <!-- Detalle de fórmula seleccionada -->
                    <div class="col-7">
                        <div t-if="!selectedFormula"
                             class="text-muted fst-italic p-3 text-center">
                            Elige un color para ver su fórmula.
                        </div>

                        <div t-if="selectedFormula" class="border rounded p-3 bg-light">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h6 class="fw-bold mb-0 text-primary">
                                    <t t-esc="selectedColor.name"/>
                                </h6>
                                <span t-if="selectedColor.code" class="badge text-bg-secondary">
                                    <t t-esc="selectedColor.code"/>
                                </span>
                            </div>

                            <div class="small text-muted mb-3">
                                <span>Base: <strong><t t-esc="baseType ? baseType.name : '—'"/></strong></span>
                                <span class="ms-2">Presentación: <strong><t t-esc="size ? size.name : '—'"/></strong></span>
                                <span t-if="selectedFormula.gallery_id" class="ms-2">
                                    Galería: <strong><t t-esc="selectedFormula.gallery_id.name"/></strong>
                                </span>
                            </div>

                            <!-- Tabla de dosis de colorantes -->
                            <table class="table table-sm table-bordered bg-white mb-2">
                                <thead class="table-light">
                                    <tr>
                                        <th>Colorante</th>
                                        <th class="text-end" style="width: 100px;">Dosis</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doses" t-as="dose" t-key="dose.id || dose.name">
                                        <td><t t-esc="dose.name"/></td>
                                        <td class="text-end fw-semibold">
                                            <t t-esc="formatPoints(dose.points)"/>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td>Total colorante</td>
                                        <td class="text-end text-primary">
                                            <t t-esc="formatPoints(totalPoints)"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- Resumen de costo y precio de venta -->
                            <div class="card border mb-2 bg-white shadow-sm">
                                <div class="card-body py-2 px-3">
                                    <table class="table table-borderless table-sm mb-0">
                                        <tbody>
                                            <tr class="border-bottom">
                                                <td>Costo del entintado (<code class="text-muted small">cost_min</code>)</td>
                                                <td class="text-end fw-semibold"><t t-esc="formatCurrency(selectedFormulaCostMin)"/></td>
                                            </tr>
                                            <tr>
                                                <td>Precio de venta (<code class="text-muted small">cost_max</code>)</td>
                                                <td class="text-end fw-bold text-success"><t t-esc="formatCurrency(selectedFormulaCostMax)"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Validación de capacidad -->
                            <div t-if="capacityPoints" class="d-flex justify-content-between align-items-center mb-2 small">
                                <span>Capacidad del envase:</span>
                                <strong><t t-esc="formatPoints(capacityPoints)"/></strong>
                            </div>
                            <div t-if="capacityPoints and remainingPoints &lt; 0"
                                 class="alert alert-danger py-1 px-2 mb-2 small">
                                <i class="fa fa-exclamation-triangle me-1" role="img"/>
                                Excede la capacidad por <t t-esc="formatPoints(-remainingPoints)"/>.
                            </div>

                            <!-- Confirmación de extracción previa -->
                            <div t-if="requiresExtraction" class="alert alert-warning py-2 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           id="extractionCheck"
                                           t-model="state.extractionDone"/>
                                    <label class="form-check-label small fw-bold" for="extractionCheck">
                                        Confirmar extracción de <t t-esc="extractionLiters.toFixed(1)"/> L antes de entintar
                                    </label>
                                </div>
                                <div t-if="baseType.operator_note" class="text-muted small mt-1">
                                    <t t-esc="baseType.operator_note"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm" t-att-disabled="!canConfirm">
                    Guardar entintado
                </button>
                <button class="btn btn-secondary" t-on-click="cancel">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>

</templates>
