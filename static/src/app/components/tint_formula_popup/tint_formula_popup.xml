<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="entintados_pdv.TintFormulaPopup">
        <Dialog title="props.title" size="'lg'">
            <div class="entintado-popup p-2">

                <!-- Pestañas de navegación -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link"
                                t-att-class="{ active: state.activeTab === 'tint' }"
                                t-on-click="() => this.setTab('tint')">
                            <i class="fa fa-flask me-1" role="img"/> Entintado
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link"
                                t-att-class="{ active: state.activeTab === 'create_color' }"
                                t-on-click="() => this.setTab('create_color')">
                            <i class="fa fa-plus-circle me-1" role="img"/> Crear Color
                        </button>
                    </li>
                </ul>

                <!-- Pestaña: Entintado -->
                <div t-if="state.activeTab === 'tint'">
                    <!-- Información de base y presentación -->
                    <div class="d-flex align-items-center gap-2 mb-2 text-muted">
                        <i class="fa fa-flask" role="img"/>
                        <span>
                            <t t-esc="baseType and baseType.name or '—'"/>
                            <t t-if="size"> · <t t-esc="size.name"/></t>
                        </span>
                        <span t-if="capacityPoints" class="badge text-bg-light ms-auto">
                            Capacidad: <t t-esc="formatPoints(capacityPoints)"/>
                        </span>
                    </div>

                    <!-- Búsqueda de color -->
                    <input type="text" class="form-control mb-2"
                           t-model="state.search"
                           placeholder="Buscar color por nombre o código…"/>

                    <div class="row g-2">
                        <!-- Lista de colores -->
                        <div class="col-5">
                            <div class="list-group entintado-color-list"
                                 style="max-height: 340px; overflow-y: auto;">
                                <button t-foreach="availableColors" t-as="color" t-key="color.id"
                                        type="button"
                                        class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                        t-att-class="{ active: color.id === state.colorId }"
                                        t-on-click="() => this.selectColor(color.id)">
                                    <i class="fa fa-paint-brush text-primary flex-shrink-0" role="img"/>
                                    <span class="text-truncate">
                                        <t t-if="color.code"><span class="badge bg-secondary me-1"><t t-esc="color.code"/></span></t>
                                        <t t-esc="color.name"/>
                                    </span>
                                </button>
                                <div t-if="!availableColors.length"
                                     class="list-group-item text-muted fst-italic">
                                    No hay colores con fórmula para esta base y presentación.
                                </div>
                            </div>
                        </div>

                        <!-- Detalle de fórmula seleccionada -->
                        <div class="col-7">
                            <div t-if="!selectedFormula"
                                 class="text-muted fst-italic p-3 text-center">
                                Elige un color para ver su fórmula.
                            </div>

                            <div t-if="selectedFormula" class="border rounded p-3 bg-light">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="fw-bold mb-0 text-primary">
                                        <t t-esc="selectedColor.name"/>
                                    </h6>
                                    <span t-if="selectedColor.code" class="badge text-bg-secondary">
                                        <t t-esc="selectedColor.code"/>
                                    </span>
                                </div>

                                <div class="small text-muted mb-3">
                                    <span>Base: <strong><t t-esc="baseType ? baseType.name : '—'"/></strong></span>
                                    <span class="ms-2">Presentación: <strong><t t-esc="size ? size.name : '—'"/></strong></span>
                                    <span t-if="selectedFormula.gallery_id" class="ms-2">
                                        Galería: <strong><t t-esc="selectedFormula.gallery_id.name"/></strong>
                                    </span>
                                </div>

                                <!-- Tabla de dosis de colorantes -->
                                <table class="table table-sm table-bordered bg-white mb-2">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Colorante</th>
                                            <th class="text-end" style="width: 100px;">Dosis</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doses" t-as="dose" t-key="dose.id || dose.name">
                                            <td><t t-esc="dose.name"/></td>
                                            <td class="text-end fw-semibold">
                                                <t t-esc="formatPoints(dose.points)"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td>Total colorante</td>
                                            <td class="text-end text-primary">
                                                <t t-esc="formatPoints(totalPoints)"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>

                                <!-- Resumen de costo y precio de venta -->
                                <div class="card border mb-2 bg-white shadow-sm">
                                    <div class="card-body py-2 px-3">
                                        <table class="table table-borderless table-sm mb-0">
                                            <tbody>
                                                <tr class="border-bottom">
                                                    <td>Costo del entintado (<code class="text-muted small">cost_min</code>)</td>
                                                    <td class="text-end fw-semibold"><t t-esc="formatCurrency(selectedFormulaCostMin)"/></td>
                                                </tr>
                                                <tr>
                                                    <td>Precio de venta (<code class="text-muted small">cost_max</code>)</td>
                                                    <td class="text-end fw-bold text-success"><t t-esc="formatCurrency(selectedFormulaCostMax)"/></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Validación de capacidad -->
                                <div t-if="capacityPoints" class="d-flex justify-content-between align-items-center mb-2 small">
                                    <span>Capacidad del envase:</span>
                                    <strong><t t-esc="formatPoints(capacityPoints)"/></strong>
                                </div>
                                <div t-if="capacityPoints and remainingPoints &lt; 0"
                                     class="alert alert-danger py-1 px-2 mb-2 small">
                                    <i class="fa fa-exclamation-triangle me-1" role="img"/>
                                    Excede la capacidad por <t t-esc="formatPoints(-remainingPoints)"/>.
                                </div>

                                <!-- Confirmación de extracción previa -->
                                <div t-if="requiresExtraction" class="alert alert-warning py-2 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               id="extractionCheck"
                                               t-model="state.extractionDone"/>
                                        <label class="form-check-label small fw-bold" for="extractionCheck">
                                            Confirmar extracción de <t t-esc="extractionLiters.toFixed(1)"/> L antes de entintar
                                        </label>
                                    </div>
                                    <div t-if="baseType.operator_note" class="text-muted small mt-1">
                                        <t t-esc="baseType.operator_note"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pestaña: Registrar nuevo color -->
                <div t-if="state.activeTab === 'create_color'" class="entintado-tab-content">
                    <div t-if="state.createColorError" class="alert alert-danger py-2 mb-3">
                        <t t-esc="state.createColorError"/>
                    </div>
                    <div t-if="state.createColorSuccess" class="alert alert-success py-2 mb-3">
                        <t t-esc="state.createColorSuccess"/>
                    </div>

                    <!-- Datos básicos del color -->
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label fw-bold">Nombre del Color <span class="text-danger">*</span></label>
                            <input type="text" class="form-control"
                                   t-model="state.newColorName"
                                   placeholder="Ej: Azul Rey, Rojo Pasión…"/>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-bold">Código</label>
                            <input type="text" class="form-control"
                                   t-model="state.newColorCode"
                                   placeholder="Autogenerado si está vacío"/>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Notas</label>
                            <textarea class="form-control" rows="2"
                                      t-model="state.newColorNotes"
                                      placeholder="Detalles u observaciones opcionales sobre este color…"></textarea>
                        </div>
                    </div>

                    <!-- Configuración de fórmula asociada -->
                    <div class="border rounded p-3 bg-light mt-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0 text-primary">
                                <i class="fa fa-flask me-1" role="img"/> Configuración de Fórmula Inicial
                            </h6>
                            <span t-if="newCapacityPoints" class="badge text-bg-secondary">
                                Capacidad máx: <t t-esc="formatPoints(newCapacityPoints)"/>
                            </span>
                        </div>

                        <!-- Selección de galería, base y presentación -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold mb-1">Galería <span class="text-danger">*</span></label>
                                <select class="form-select form-select-sm" t-model="state.newGalleryId">
                                    <option value="">— Seleccionar Galería —</option>
                                    <option t-foreach="galleries" t-as="g" t-key="g.id" t-att-value="g.id">
                                        <t t-esc="g.name"/> <t t-if="g.code">(<t t-esc="g.code"/>)</t>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold mb-1">Tipo de Base</label>
                                <select class="form-select form-select-sm" t-model="state.newBaseTypeId">
                                    <option value="">— Seleccionar Base —</option>
                                    <option t-foreach="baseTypes" t-as="b" t-key="b.id" t-att-value="b.id">
                                        <t t-esc="b.name"/> <t t-if="b.code">(<t t-esc="b.code"/>)</t>
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold mb-1">Presentación</label>
                                <select class="form-select form-select-sm" t-model="state.newSizeId">
                                    <option value="">— Seleccionar Presentación —</option>
                                    <option t-foreach="sizes" t-as="s" t-key="s.id" t-att-value="s.id">
                                        <t t-esc="s.name"/>
                                    </option>
                                </select>
                            </div>
                        </div>

                        <!-- Agregar colorante -->
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-bold mb-1">Colorante</label>
                                <select class="form-select form-select-sm" t-model="state.selectedColorantId">
                                    <option value="">— Seleccionar colorante —</option>
                                    <option t-foreach="colorants" t-as="c" t-key="c.id" t-att-value="c.id">
                                        <t t-esc="c.display_name or c.name"/>
                                    </option>
                                </select>
                            </div>
                            <div class="col-3">
                                <label class="form-label small fw-bold mb-1">Dosis (Pts)</label>
                                <input type="number" min="0.01" step="any" class="form-control form-control-sm"
                                       t-model="state.newColorantPoints"/>
                            </div>
                            <div class="col-3">
                                <button type="button" class="btn btn-sm btn-outline-primary w-100"
                                        t-on-click="addColorantLine"
                                        t-att-disabled="!state.selectedColorantId">
                                    <i class="fa fa-plus me-1" role="img"/> Agregar
                                </button>
                            </div>
                        </div>

                        <!-- Tabla de dosis de la fórmula -->
                        <div t-if="state.newFormulaLines.length" class="table-responsive">
                            <table class="table table-sm table-bordered bg-white mb-2">
                                <thead>
                                    <tr class="table-light">
                                        <th>Colorante</th>
                                        <th class="text-end" style="width: 130px;">Dosis</th>
                                        <th class="text-center" style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.newFormulaLines" t-as="line" t-key="line_index">
                                        <td><t t-esc="line.colorantName"/></td>
                                        <td class="text-end">
                                            <span class="badge text-bg-info me-1"><t t-esc="formatPoints(line.points)"/></span>
                                            <small class="text-muted"><t t-esc="line.points"/> Pts.</small>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                                    t-on-click="() => this.removeColorantLine(line_index)">
                                                <i class="fa fa-trash" role="img"/>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td>Total Dosis</td>
                                        <td class="text-end">
                                            <t t-esc="formatPoints(newFormulaTotalPoints)"/>
                                            <small class="text-muted ms-1">(<t t-esc="newFormulaTotalPoints"/> Pts.)</small>
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- Resumen de costo y precio de venta -->
                            <div class="row g-2 mt-2 pt-2 border-top">
                                <div class="col-6">
                                    <div class="p-2 rounded bg-light border">
                                        <small class="text-muted d-block fw-semibold">Costo estimado (<code class="text-secondary">cost_min</code>)</small>
                                        <span class="fs-6 fw-bold text-dark"><t t-esc="formatCurrency(newFormulaCostMin)"/></span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 rounded bg-light border">
                                        <small class="text-muted d-block fw-semibold">Precio de venta estimado (<code class="text-secondary">cost_max</code>)</small>
                                        <span class="fs-6 fw-bold text-success"><t t-esc="formatCurrency(newFormulaCostMax)"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div t-else="" class="text-muted fst-italic small">
                            (Opcional) Agrega los colorantes y dosis en puntos para registrar la fórmula de este color sobre la base actual.
                        </div>
                    </div>

                </div>

            </div>

            <t t-set-slot="footer">
                <t t-if="state.activeTab === 'tint'">
                    <button class="btn btn-primary" t-on-click="confirm" t-att-disabled="!canConfirm">
                        Guardar entintado
                    </button>
                    <button class="btn btn-secondary" t-on-click="cancel">
                        Cancelar
                    </button>
                </t>
                <t t-if="state.activeTab === 'create_color'">
                    <button class="btn btn-success" t-on-click="saveNewColor" t-att-disabled="state.isCreatingColor || !state.newColorName.trim()">
                        <i class="fa fa-save me-1" role="img"/> Guardar Color
                    </button>
                    <button class="btn btn-secondary" t-on-click="() => this.setTab('tint')">
                        Volver
                    </button>
                </t>
            </t>
        </Dialog>
    </t>

</templates>
