<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="entintados_pdv.TintFormulaPopup">
        <Dialog title="props.title" size="'lg'">
            <div class="entintado-formula-modal p-1">

                <!-- Franja de contexto del producto base -->
                <div class="o-tint-context-strip d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 px-3 mb-3 rounded-3 border bg-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center gap-1 small text-dark fw-semibold">
                            <i class="fa fa-flask text-primary" role="img"/>
                            <span>Base: <strong class="text-primary"><t t-esc="baseType and baseType.name or '—'"/></strong></span>
                        </div>
                        <div t-if="size" class="d-flex align-items-center gap-1 small text-dark fw-semibold border-start ps-3">
                            <i class="fa fa-cube text-dark" role="img"/>
                            <span>Presentación: <strong class="text-dark"><t t-esc="size.name"/></strong></span>
                        </div>
                    </div>
                    <div t-if="capacityPoints" class="d-flex align-items-center gap-1">
                        <span class="badge rounded-pill bg-white text-dark border px-2 py-1 shadow-xs">
                            <i class="fa fa-tachometer me-1"/> Capacidad máx: <strong><t t-esc="formatPoints(capacityPoints)"/></strong> <span class="text-secondary-emphasis fw-normal ms-1">(<t t-esc="capacityPoints"/> Pts)</span>
                        </span>
                    </div>
                </div>

                <!-- Barra de búsqueda de color y acción de crear nuevo color -->
                <div class="row g-2 mb-3 align-items-center">
                    <div class="col">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white text-secondary-emphasis border-end-0">
                                <i class="fa fa-search"/>
                            </span>
                            <input type="text" class="form-control ps-2 border-start-0"
                                   t-model="state.search"
                                   placeholder="Buscar color por nombre o código…"/>
                            <button t-if="state.search" class="btn btn-outline-secondary border-start-0" type="button" t-on-click="() => this.state.search = ''">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 text-nowrap shadow-xs"
                                type="button"
                                t-on-click="openCreateColor">
                            <i class="fa fa-plus-circle" role="img"/>
                            <span>Nuevo Color</span>
                        </button>
                    </div>
                </div>

                <!-- Contenedor Maestro-Detalle -->
                <div class="row g-3">
                    <!-- Columna Izquierda: Lista de Colores Compatibles -->
                    <div class="col-md-5">
                        <div class="o-tint-card h-100 d-flex flex-column">
                            <div class="o-tint-card-header d-flex align-items-center justify-content-between py-2 px-3">
                                <span class="o-tint-card-title small mb-0">Colores Compatibles</span>
                                <span class="badge bg-light text-dark border text-xxs">
                                    <t t-esc="availableColors.length"/> disponibles
                                </span>
                            </div>
                            <div class="o-tint-card-body p-2 flex-grow-1 overflow-y-auto entintado-color-list-card-body o-tint-scroll-touch" style="max-height: 380px;">
                                <div class="list-group list-group-flush entintado-color-list gap-1">
                                    <button t-foreach="availableColors" t-as="color" t-key="color.id"
                                            type="button"
                                            class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-2 rounded-2 border"
                                            t-att-class="{ 'active text-white border-primary shadow-xs': color.id === state.colorId }"
                                            t-on-click="() => this.selectColor(color.id)">
                                        <div class="d-flex align-items-center gap-2 overflow-hidden">
                                            <i class="fa fa-paint-brush flex-shrink-0"
                                               t-att-class="color.id === state.colorId ? 'text-white' : 'text-primary'"/>
                                            <div class="text-truncate">
                                                <div class="fw-semibold text-truncate"><t t-esc="color.name"/></div>
                                                <div t-if="color.code" class="text-xxs"
                                                     t-att-class="color.id === state.colorId ? 'text-white-50' : 'text-secondary-emphasis'">
                                                    Código: <t t-esc="color.code"/>
                                                </div>
                                            </div>
                                        </div>
                                        <i t-if="color.id === state.colorId" class="fa fa-check-circle fs-6 ms-2" role="img"/>
                                    </button>

                                    <!-- Estado vacío de búsqueda -->
                                    <div t-if="!availableColors.length" class="text-center py-4 px-2 o-tint-empty-state">
                                        <i class="fa fa-search fa-2x mb-2 text-secondary"/>
                                        <p class="small mb-2">No hay fórmulas compatibles para esta base y tamaño.</p>
                                        <button type="button" class="btn btn-xs btn-outline-primary" t-on-click="openCreateColor">
                                            <i class="fa fa-plus me-1"/> Crear este color
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Columna Derecha: Detalle de la Fórmula Seleccionada -->
                    <div class="col-md-7">
                        <!-- Sin selección -->
                        <div t-if="!selectedFormula" class="o-tint-card h-100 d-flex flex-column align-items-center justify-content-center text-center p-4 bg-light border-dashed">
                            <div class="o-tint-header-icon bg-white text-secondary-emphasis mb-2 shadow-xs" style="width: 3rem; height: 3rem; font-size: 1.25rem;">
                                <i class="fa fa-hand-pointer-o"/>
                            </div>
                            <h6 class="text-dark fw-bold mb-1">Selecciona un Color</h6>
                            <p class="text-secondary-emphasis small mb-0" style="max-width: 280px;">
                                Elige un color de la lista lateral para cargar su fórmula de dosificación y especificaciones de costo.
                            </p>
                        </div>

                        <!-- Fórmula seleccionada -->
                        <div t-if="selectedFormula" class="o-tint-card h-100 d-flex flex-column">
                            <!-- Encabezado de la Fórmula -->
                            <div class="o-tint-card-header d-flex align-items-center justify-content-between py-2 px-3">
                                <div>
                                    <h6 class="o-tint-card-title text-primary mb-0">
                                        <t t-esc="selectedColor.name"/>
                                    </h6>
                                    <div class="text-xxs text-secondary-emphasis mt-0 d-flex gap-2">
                                        <span t-if="selectedFormula.gallery_id">Galería: <strong><t t-esc="selectedFormula.gallery_id.name"/></strong></span>
                                        <span>Base: <strong><t t-esc="baseType ? baseType.name : '—'"/></strong></span>
                                        <span>Presentación: <strong><t t-esc="size ? size.name : '—'"/></strong></span>
                                    </div>
                                </div>
                                <span t-if="selectedColor.code" class="badge rounded-pill bg-light text-dark border px-2 py-1 font-monospace">
                                    <t t-esc="selectedColor.code"/>
                                </span>
                            </div>

                            <div class="o-tint-card-body p-3 flex-grow-1 overflow-y-auto">
                                <!-- Medidor de Capacidad de Envase -->
                                <div t-if="capacityPoints" class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-semibold text-secondary-emphasis">
                                            Capacidad utilizada:
                                            <strong t-att-class="isOverCapacity ? 'text-danger' : 'text-primary'">
                                                <t t-esc="formatPoints(totalPoints)"/> / <t t-esc="formatPoints(capacityPoints)"/>
                                            </strong>
                                        </span>
                                        <span class="small fw-bold" t-att-class="isOverCapacity ? 'text-danger' : (capacityPercent > 90 ? 'text-warning' : 'text-success')">
                                            <t t-esc="capacityPercent.toFixed(1)"/>%
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 7px;">
                                        <div class="progress-bar transition-all" role="progressbar"
                                             t-att-style="'width: ' + Math.min(capacityPercent, 100) + '%;'"
                                             t-att-class="isOverCapacity ? 'bg-danger' : (capacityPercent > 90 ? 'bg-warning' : 'bg-primary')"/>
                                    </div>
                                    <div t-if="isOverCapacity" class="alert alert-danger py-1 px-2 mt-2 mb-0 small d-flex align-items-center gap-1 rounded-2">
                                        <i class="fa fa-exclamation-triangle" role="img"/>
                                        <span>Excede la capacidad del envase por <strong t-esc="formatPoints(totalPoints - capacityPoints)"/>.</span>
                                    </div>
                                </div>

                                <!-- Tabla de Dosificación -->
                                <div class="o-tint-table-wrapper rounded-3 border overflow-hidden mb-3">
                                    <table class="table table-sm table-hover mb-0 align-middle">
                                        <thead class="table-light border-bottom">
                                            <tr>
                                                <th class="ps-3 py-2 text-dark text-uppercase text-xs fw-bold">Colorante</th>
                                                <th class="text-end pe-3 py-2 text-dark text-uppercase text-xs fw-bold" style="width: 130px;">Dosis</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="doses" t-as="dose" t-key="dose.id || dose.name" class="o-tint-dose-row">
                                                <td class="ps-3 fw-semibold text-dark">
                                                    <i class="fa fa-tint text-primary me-2"/>
                                                    <t t-esc="dose.name"/>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <span class="badge rounded-pill bg-primary-subtle text-primary fw-bold px-2 py-1 me-1">
                                                        <t t-esc="formatPoints(dose.points)"/>
                                                    </span>
                                                    <small class="text-secondary-emphasis">(<t t-esc="dose.points"/> Pts)</small>
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot class="table-light border-top">
                                            <tr class="fw-bold">
                                                <td class="ps-3 text-dark">Total Colorantes</td>
                                                <td class="text-end pe-3">
                                                    <span class="text-primary fs-6 me-1"><t t-esc="formatPoints(totalPoints)"/></span>
                                                    <small class="text-secondary-emphasis">(<t t-esc="totalPoints"/> Pts)</small>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                <!-- Resumen Financiero -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="o-tint-kpi-card p-2 rounded-3 border bg-white shadow-xs">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <small class="text-secondary-emphasis fw-semibold">Costo entintado</small>
                                                <span class="badge rounded-pill bg-light text-secondary-emphasis border text-xxs px-2">cost_min</span>
                                            </div>
                                            <div class="fs-6 fw-bold text-dark">
                                                <t t-esc="formatCurrency(selectedFormulaCostMin)"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="o-tint-kpi-card p-2 rounded-3 border bg-white shadow-xs">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <small class="text-secondary-emphasis fw-semibold">Precio de venta</small>
                                                <span class="badge rounded-pill bg-success-subtle text-success border text-xxs px-2">cost_max</span>
                                            </div>
                                            <div class="fs-6 fw-bold text-success">
                                                <t t-esc="formatCurrency(selectedFormulaCostMax)"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div t-if="presentationRange and (presentationRange.price_min or presentationRange.price_max)" class="col-12">
                                        <div class="p-2 rounded-3 border bg-light shadow-xs d-flex align-items-center justify-content-between">
                                            <small class="text-secondary-emphasis fw-semibold">Rango de línea</small>
                                            <span class="text-dark fw-bold small font-monospace">
                                                <t t-if="presentationRange.price_min">Mín: <t t-esc="formatCurrency(presentationRange.price_min)"/></t>
                                                <t t-if="presentationRange.price_min and presentationRange.price_max"> · </t>
                                                <t t-if="presentationRange.price_max">Máx: <t t-esc="formatCurrency(presentationRange.price_max)"/></t>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Requisito Operativo de Extracción Previa -->
                                <div t-if="requiresExtraction" class="alert alert-warning p-2 mb-0 rounded-3 border-warning d-flex flex-column gap-1">
                                    <div class="form-check d-flex align-items-center gap-2 mb-0">
                                        <input class="form-check-input mt-0" type="checkbox"
                                               id="formulaExtractionCheck"
                                               t-model="state.extractionDone"/>
                                        <label class="form-check-label small fw-bold text-dark cursor-pointer" for="formulaExtractionCheck">
                                            Confirmar extracción previa de <span class="text-danger"><t t-esc="extractionLiters.toFixed(1)"/> L</span>
                                        </label>
                                    </div>
                                    <div t-if="baseType.operator_note" class="text-dark small ps-4">
                                        <i class="fa fa-info-circle me-1"/> <t t-esc="baseType.operator_note"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Footer con Botones -->
            <t t-set-slot="footer">
                <div class="d-flex w-100 align-items-center justify-content-between">
                    <button class="btn btn-outline-secondary px-3" t-on-click="cancel">
                        Cancelar
                    </button>
                    <button class="btn btn-primary px-4 d-flex align-items-center gap-2 shadow-sm"
                            t-on-click="confirm"
                            t-att-disabled="!canConfirm">
                        <i class="fa fa-check" role="img"/>
                        <span>Guardar Entintado</span>
                    </button>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
