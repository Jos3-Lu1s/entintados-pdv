<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.CustomerContactInfo">
        <t t-set="partner" t-value="props.partner || partner"/>
        <div t-if="partner" class="o-pos-contact-info" aria-label="Información del cliente">
            <t t-set="info" t-value="partner.pos_contact_info || {}"/>
            
            <!-- Encabezado del contacto: Nombre, Identificadores y Vendedor -->
            <div class="o-contact-header d-flex flex-wrap align-items-center justify-content-between gap-2 pb-1">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="o-contact-avatar-box d-flex align-items-center justify-content-center rounded-circle flex-shrink-0">
                        <i class="fa fa-user" aria-hidden="true"/>
                    </div>
                    <strong class="fs-6 text-dark text-break fw-bold" t-esc="partner.name"/>
                    <span t-if="partner.is_credit or (partner.commercial_partner_id and partner.commercial_partner_id.is_credit)"
                          class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle"
                          title="Cliente con condición de pago a crédito">
                        <i class="fa fa-credit-card me-1" aria-hidden="true"/>Crédito
                    </span>
                    <span t-if="info.reference" class="badge rounded-pill bg-light text-secondary border font-monospace" title="Clave de cliente">
                        <i class="fa fa-tag me-1 text-muted" aria-hidden="true"/>Clave: <t t-esc="info.reference"/>
                    </span>
                    <span t-if="info.vat" class="badge rounded-pill bg-light text-secondary border font-monospace" title="Registro Federal de Contribuyentes">
                        <i class="fa fa-id-card-o me-1 text-muted" aria-hidden="true"/>RFC: <t t-esc="info.vat"/>
                    </span>
                </div>
                <div class="o-contact-salesperson badge bg-light text-secondary border fw-normal d-flex align-items-center gap-1 shadow-xs">
                    <i class="fa fa-user-circle-o text-muted" aria-hidden="true"/>
                    <span class="text-muted">Vendedor:</span>
                    <span class="text-dark fw-semibold" t-esc="info.salesperson || partner.sale_owner_name || 'Sin vendedor asignado'"/>
                </div>
            </div>

            <!-- Matriz de Indicadores Financieros / Estados de Saldo -->
            <div class="o-contact-metrics d-flex flex-wrap align-items-stretch gap-1 gap-sm-2 mt-1">
                <!-- Anticipo Disponible a Favor -->
                <div t-if="partner.customer_advance_available !== undefined and partner.customer_advance_available !== null"
                     class="o-metric-card d-flex align-items-center gap-1 gap-sm-2 px-2 py-1 rounded-2 border"
                     t-att-class="partner.customer_advance_available > 0 ? 'o-metric-advance-positive' : 'bg-light text-secondary'">
                    <i class="fa fa-money" aria-hidden="true"/>
                    <div class="small lh-1">
                        <span class="text-muted me-1">Anticipo:</span>
                        <span class="font-monospace fw-bold"
                              t-att-class="partner.customer_advance_available > 0 ? 'text-success' : 'text-dark'"
                              t-esc="env.utils.formatCurrency(partner.customer_advance_available)"/>
                    </div>
                </div>

                <!-- Deuda Actual / Saldo Vencido -->
                <div t-if="partner.total_due !== undefined and partner.total_due !== null"
                     class="o-metric-card d-flex align-items-center gap-1 gap-sm-2 px-2 py-1 rounded-2 border"
                     t-att-class="partner.total_due > 0 ? 'o-metric-debt-positive' : 'bg-light text-secondary'">
                    <i class="fa fa-exclamation-circle text-danger" t-if="partner.total_due > 0" aria-hidden="true"/>
                    <i class="fa fa-check-circle text-success" t-else="" aria-hidden="true"/>
                    <div class="small lh-1">
                        <span class="text-muted me-1">Deuda:</span>
                        <span class="font-monospace fw-bold"
                              t-att-class="partner.total_due > 0 ? 'text-danger' : 'text-dark'"
                              t-esc="env.utils.formatCurrency(partner.total_due)"/>
                    </div>
                </div>

                <!-- Límite de Crédito -->
                <div class="o-metric-card d-flex align-items-center gap-1 gap-sm-2 px-2 py-1 rounded-2 border bg-light text-secondary">
                    <i class="fa fa-shield text-muted" aria-hidden="true"/>
                    <div class="small lh-1">
                        <span class="text-muted me-1">Límite:</span>
                        <span t-if="info.credit_authorized" class="font-monospace fw-semibold text-dark">
                            <t t-esc="info.credit_limit_text"/> <t t-esc="info.credit_currency"/>
                        </span>
                        <span t-else="" class="text-muted fst-italic">Sin crédito autorizado</span>
                    </div>
                </div>
            </div>

            <!-- Cajón Desplegable de Direcciones y Régimen Fiscal -->
            <details class="o-contact-details mt-1" t-if="info.address || info.fiscal_regime || info.invoice || info.delivery">
                <summary class="d-inline-flex align-items-center gap-1 small fw-semibold text-primary">
                    <i class="fa fa-chevron-right o-details-arrow" aria-hidden="true"/>
                    <span>Direcciones y datos fiscales</span>
                </summary>
                <div class="o-contact-details-content bg-light rounded-3 p-2 mt-2 border shadow-xs text-break">
                    <div class="row g-2">
                        <div t-if="info.fiscal_regime or info.address" class="col-12">
                            <div class="p-2 bg-white rounded-2 border small">
                                <div t-if="info.fiscal_regime" class="mb-1">
                                    <span class="text-secondary fw-semibold">Régimen fiscal:</span>
                                    <span class="text-dark ms-1" t-esc="info.fiscal_regime"/>
                                </div>
                                <div t-if="info.address">
                                    <span class="text-secondary fw-semibold">Dirección:</span>
                                    <span class="text-dark ms-1" t-esc="info.address"/>
                                </div>
                            </div>
                        </div>
                        <div t-if="info.invoice" class="col-12 col-md-6">
                            <div class="p-2 bg-white rounded-2 border h-100 small">
                                <div class="fw-bold text-secondary d-flex align-items-center gap-1 mb-1">
                                    <i class="fa fa-file-text-o text-secondary" aria-hidden="true"/>Dirección de factura
                                </div>
                                <span class="d-block text-dark fw-semibold" t-esc="info.invoice.name"/>
                                <span class="text-muted" t-esc="info.invoice.address || 'Sin dirección registrada'"/>
                            </div>
                        </div>
                        <div t-if="info.delivery" class="col-12 col-md-6">
                            <div class="p-2 bg-white rounded-2 border h-100 small">
                                <div class="fw-bold text-secondary d-flex align-items-center gap-1 mb-1">
                                    <i class="fa fa-truck text-secondary" aria-hidden="true"/>Dirección de entrega
                                </div>
                                <span class="d-block text-dark fw-semibold" t-esc="info.delivery.name"/>
                                <span class="text-muted" t-esc="info.delivery.address || 'Sin dirección registrada'"/>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2 fst-italic">Direcciones predeterminadas registradas para el contacto.</small>
                </div>
            </details>
        </div>
    </t>
</templates>
