<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="entintados_pdv.CustomerPaymentSummary">
        <section t-if="currentOrder" class="o-customer-payment-summary" aria-label="Resumen de compra">
            <t t-set="summary" t-value="customerPaymentSummary"/>
            
            <header class="o-summary-header px-3 py-2 border-bottom bg-white flex-shrink-0">
                <h5 class="mb-1 fw-bold text-dark">Resumen de compra</h5>
                <t t-if="currentOrder.getPartner()">
                    <CustomerContactInfo partner="currentOrder.getPartner()"/>
                </t>
                <div t-else="" class="text-muted small py-1">
                    <i class="fa fa-user-circle-o me-1" aria-hidden="true"/> Público en general
                </div>
            </header>

            <div class="o-customer-purchase-lines table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th class="text-start">Producto</th>
                            <th class="text-end">Cant.</th>
                            <th class="text-end">Precio unit.</th>
                            <th class="text-end">Descuento / promoción</th>
                            <th t-if="summary.showMargins" class="text-end">Margen interno</th>
                            <th class="text-end">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="summary.rows" t-as="row" t-key="row.id">
                            <td>
                                <div class="fw-semibold text-dark text-break" t-esc="row.name"/>
                                <small t-if="row.color and (!row.name or !row.name.includes(row.color))" class="d-inline-flex align-items-center text-muted mt-1">
                                    <i class="fa fa-tint me-1 text-primary" aria-hidden="true"/>Color: <t t-esc="row.color"/>
                                </small>
                            </td>
                            <td class="text-end text-nowrap">
                                <span class="fw-medium text-dark" t-esc="row.quantity"/> <small class="text-muted" t-esc="row.unit"/>
                            </td>
                            <td class="text-end text-nowrap text-muted" t-esc="env.utils.formatCurrency(row.unitPrice)"/>
                            <td class="text-end text-nowrap" t-att-class="row.saving ? 'text-success fw-medium' : 'text-muted'" t-esc="env.utils.formatCurrency(row.saving)"/>
                            <td t-if="summary.showMargins" class="text-end text-nowrap text-muted">
                                <t t-esc="row.margin === null ? '—' : env.utils.formatCurrency(row.margin)"/>
                                <small t-if="row.marginPercent !== null" class="ms-1 text-muted">(<t t-esc="formatMarginPercent(row.marginPercent)"/>%)</small>
                            </td>
                            <td class="text-end text-nowrap fw-bold text-dark" t-esc="env.utils.formatCurrency(row.amount)"/>
                        </tr>
                    </tbody>
                </table>
            </div>

            <footer class="o-summary-footer p-3 flex-shrink-0">
                <div class="row g-3 align-items-start">
                    <div t-if="showPaymentInvoiceOptions" class="col-12 col-lg-7">
                        <div class="o-customer-invoice-options border rounded bg-white p-3" t-att-class="{'o-has-payment-term': showPaymentTerm}">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="small fw-bold text-dark text-uppercase">
                                    <i class="fa fa-file-text-o text-muted me-1" aria-hidden="true"/> Datos de facturación
                                </span>
                                <small class="text-muted">Precios antes de impuestos</small>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-sm-6 col-xl-5">
                                    <label for="payment_invoice_usage" class="form-label small text-muted mb-1">Uso</label>
                                    <select id="payment_invoice_usage" class="form-select form-select-sm" t-on-change="changePaymentInvoiceUsage">
                                        <option t-foreach="pos.config._l10n_mx_edi_usage || []" t-as="usage" t-key="usage.value"
                                                t-att-value="usage.value" t-att-selected="usage.value === paymentInvoiceUsage" t-esc="usage.name"/>
                                    </select>
                                </div>
                                <div class="col-6 col-sm-3 col-xl-3">
                                    <label for="payment_invoice_public" class="form-label small text-muted mb-1">Público en general</label>
                                    <select id="payment_invoice_public" class="form-select form-select-sm" t-on-change="changePaymentInvoicePublic">
                                        <option value="0" t-att-selected="!currentOrder.l10n_mx_edi_cfdi_to_public">No</option>
                                        <option value="1" t-att-selected="!!currentOrder.l10n_mx_edi_cfdi_to_public">Sí</option>
                                    </select>
                                </div>
                                <div class="col-6 col-sm-3 col-xl-4">
                                    <label for="payment_invoice_count" class="form-label small text-muted mb-1">Número de facturas</label>
                                    <input id="payment_invoice_count" type="number" min="1" step="1"
                                           class="form-control form-control-sm" t-att-value="paymentInvoiceSplitCount"
                                           t-att-disabled="!canSplitPaymentInvoice" t-on-change="changePaymentInvoiceSplitCount"/>
                                </div>
                                <div t-if="showPaymentTerm" class="col-12 mt-2">
                                    <label for="payment_invoice_term" class="form-label small text-muted mb-1">Términos de pago</label>
                                    <select id="payment_invoice_term" class="form-select form-select-sm" t-on-change="changePaymentTerm">
                                        <option value="" t-att-selected="!currentOrder.pos_payment_term_id">
                                            <t t-esc="defaultPaymentTerm?.name || 'Plazo predeterminado'"/>
                                        </option>
                                        <option t-foreach="paymentTermOptions" t-as="term" t-key="term.id" t-att-value="term.id"
                                                t-att-selected="term.id === currentOrder.pos_payment_term_id?.id" t-esc="term.name"/>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div t-attf-class="{{ showPaymentInvoiceOptions ? 'col-12 col-lg-5' : 'col-12 col-lg-6 ms-auto' }}">
                        <div class="o-customer-price-card border rounded bg-white p-3">
                            <dl class="o-customer-price-breakdown mb-0">
                                <dt class="text-muted fw-normal">Importe antes de descuentos</dt>
                                <dd class="text-dark" t-esc="env.utils.formatCurrency(summary.gross)"/>

                                <t t-if="summary.discounts">
                                    <dt class="text-muted fw-normal">Descuentos <small t-if="summary.discountRates" class="text-muted">(<t t-esc="summary.discountRates"/> por producto)</small></dt>
                                    <dd class="text-danger" t-esc="env.utils.formatCurrency(-summary.discounts)"/>
                                </t>

                                <t t-if="summary.promotions">
                                    <dt class="text-muted fw-normal">Promociones <small t-if="summary.promotionRates" class="text-muted">(<t t-esc="summary.promotionRates"/> por producto)</small></dt>
                                    <dd class="text-success" t-esc="env.utils.formatCurrency(-summary.promotions)"/>
                                </t>

                                <dt class="text-muted fw-normal">Subtotal</dt>
                                <dd class="text-dark fw-semibold" t-esc="env.utils.formatCurrency(summary.subtotal)"/>

                                <t t-foreach="summary.taxes" t-as="tax" t-key="tax_index">
                                    <dt class="text-muted fw-normal" t-esc="tax.name"/>
                                    <dd class="text-dark" t-esc="env.utils.formatCurrency(tax.amount)"/>
                                </t>
                                <t t-if="!summary.taxes.length">
                                    <dt class="text-muted fw-normal">Impuestos</dt>
                                    <dd class="text-dark" t-esc="env.utils.formatCurrency(summary.tax)"/>
                                </t>

                                <t t-if="!currentOrder.currency.isZero(summary.rounding)">
                                    <dt class="text-muted fw-normal">Redondeo</dt>
                                    <dd class="text-dark" t-esc="env.utils.formatCurrency(summary.rounding)"/>
                                </t>

                                <dt class="o-customer-total mt-2">Total a pagar</dt>
                                <dd class="o-customer-total mt-2" t-esc="env.utils.formatCurrency(summary.total)"/>
                            </dl>
                        </div>
                        <small t-if="!showPaymentInvoiceOptions" class="text-muted d-block text-end mt-2">
                            Precios e importes de productos antes de impuestos.
                        </small>
                    </div>
                </div>
            </footer>
        </section>
    </t>
</templates>
