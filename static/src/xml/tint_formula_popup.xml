<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="entintados_pdv.TintFormulaPopup">
        <Dialog title="props.title" size="'md'">
            <div class="entintado-popup p-2">

                <label class="fw-bold">Base de pintura</label>
                <input type="text" class="form-control mb-2"
                       t-model="state.base"
                       placeholder="p. ej. Blanco mate 4L"/>

                <hr/>

                <h6 class="fw-bold">Colorantes (puntos)</h6>
                <div class="d-flex gap-2 mb-2">
                    <input type="text" class="form-control"
                           t-model="state.newName"
                           placeholder="Colorante (p. ej. Rojo óxido)"/>
                    <input type="number" class="form-control" style="max-width: 120px;"
                           t-model="state.newPoints" step="0.1" min="0"
                           placeholder="Puntos"/>
                    <button class="btn btn-primary" t-on-click="addColorant">
                        Agregar
                    </button>
                </div>

                <ul class="list-group mb-3">
                    <li t-foreach="state.colorants" t-as="c" t-key="c_index"
                        class="list-group-item d-flex justify-content-between align-items-center">
                        <span><t t-esc="c.name"/>: <strong><t t-esc="c.points"/></strong> pts</span>
                        <button class="btn btn-sm btn-outline-danger"
                                t-on-click="() => this.removeColorant(c_index)">
                            ✕
                        </button>
                    </li>
                    <li t-if="!state.colorants.length"
                        class="list-group-item text-muted fst-italic">
                        Aún no agregas colorantes.
                    </li>
                </ul>

                <div class="alert alert-info mb-0">
                    <strong>Fórmula:</strong> <t t-esc="formulaText"/>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">
                    Guardar entintado
                </button>
                <button class="btn btn-secondary" t-on-click="cancel">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>

</templates>
