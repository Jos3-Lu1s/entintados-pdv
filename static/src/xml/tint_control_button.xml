<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
      Un solo punto de extensión de los botones de control.

      Antes había dos plantillas distintas extendiendo `ControlButtons`, cada
      una con su propio botón de pincel. Dos botones con el mismo icono y
      nombres parecidos hacían imposible saber cuál se estaba pulsando.
    -->
    <t t-name="entintados_pdv.ControlButtonsTint"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <!--
          El botón «Colores» se eliminó: su función la cubre ahora la pestaña
          «Entintados» de la pantalla de productos. Queda solo el botón que
          entinta la línea base ya seleccionada en la orden.
        -->
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="!props.showRemainingButtons"
                    class="btn btn-light btn-lg lh-lg o-tint-button"
                    t-on-click="() => this.onClickTint()">
                <i class="fa fa-paint-brush me-1" role="img" aria-label="Entintado"/>
                <span>Entintado</span>
            </button>
        </xpath>

        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-att-class="buttonClass"
                    t-on-click="() => this.onClickTint()">
                <i class="fa fa-paint-brush me-2" role="img" aria-label="Entintado"/>
                <span>Entintado</span>
            </button>
        </xpath>

    </t>

</templates>
