<odoo>
    <template id="report_invoice_live">
        <t t-call="account.report_invoice_with_payments"/>
    </template>
    <record id="action_report_invoice_live" model="ir.actions.report">
        <field name="name">Vista previa de factura actual</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">entintados_pdv.report_invoice_live</field>
        <field name="report_file">entintados_pdv.report_invoice_live</field>
        <field name="attachment_use" eval="False"/>
    </record>
    <template id="report_sale_mat" inherit_id="sale.report_saleorder_document" priority="90">
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t t-set="o" t-value="doc"/>
            <t t-set="mat_invoice_layout" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='informations']" position="before">
            <t t-call="entintados_pdv.mat_document_header"/>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <t t-set="mat_lines" t-value="doc._mat_sale_lines()"/>
            <t t-set="mat_discount" t-value="any(line.discount for line in mat_lines)"/>
            <table class="mat-lines" name="mat_sale_lines">
                <thead><tr><th>Cantidad</th><th>Código</th><th style="width:40%;">Descripción</th><th t-if="mat_discount">Descuento</th><th>Valor unitario</th><th>Importe</th></tr></thead>
                <tbody><t t-foreach="mat_lines" t-as="line">
                    <tr t-if="not line.display_type">
                        <t t-set="mat_values" t-value="doc._mat_sale_line_values(line)"/>
                        <td><span t-field="line.product_uom_qty"/></td><td t-out="mat_values['code']"/><td><span t-field="line.name" t-options="{'widget':'text'}"/></td>
                        <td t-if="mat_discount"><t t-if="line.discount"><span t-field="line.discount"/>%<br/><span t-out="mat_values['discount']" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></t></td>
                        <td><span t-out="mat_values['unit']" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td><td><span t-field="line.price_subtotal"/></td>
                    </tr>
                    <tr t-else=""><td t-att-colspan="6 if mat_discount else 5"><span t-field="line.name"/></td></tr>
                </t></tbody>
            </table>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes"><attribute name="t-if">False</attribute></xpath>
        <xpath expr="//div[@name='so_total_summary']" position="before">
            <t t-set="mat_discount_amount" t-value="doc._mat_sale_discount()"/>
            <div class="mat-summary-block" style="width:100%;clear:both;">
                <table class="mat-summary"><tbody>
                    <tr t-if="mat_discount_amount"><td>Importe antes de descuentos</td><td class="text-end"><span t-out="doc.amount_untaxed + mat_discount_amount" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td></tr>
                    <tr t-if="mat_discount_amount"><td>Descuentos</td><td class="text-end"><span t-out="mat_discount_amount" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td></tr>
                    <tr><td>Importe sin impuestos</td><td class="text-end"><span t-field="doc.amount_untaxed"/></td></tr>
                    <t t-foreach="(doc.tax_totals or {}).get('subtotals', [])" t-as="subtotal"><tr t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group"><td t-out="tax_group['group_name']"/><td class="text-end"><span t-out="tax_group['tax_amount_currency']" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/></td></tr></t>
                    <tr class="o_total"><td>Total</td><td class="text-end"><span t-field="doc.amount_total"/></td></tr>
                </tbody></table>
                <div style="color:#24468d;font-weight:bold;">Importe con letra: <span t-out="doc.currency_id.amount_to_text(doc.amount_total)"/></div>
                <div class="mat-thanks" style="margin-top:6px;">Gracias por su preferencia.</div>
            </div>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="attributes"><attribute name="t-if">False</attribute></xpath>
    </template>
</odoo>
