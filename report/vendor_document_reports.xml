<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="vendor_invoice_detail_report" model="account.report">
        <field name="name">Facturas por proveedor</field>
        <field name="custom_handler_model_id" ref="model_account_vendor_document_report_handler"/>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="column_ids">
            <record id="vendor_invoice_detail_column_date" model="account.report.column">
                <field name="name">Fecha de factura</field>
                <field name="expression_label">date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="vendor_invoice_detail_column_due" model="account.report.column">
                <field name="name">Vencimiento</field>
                <field name="expression_label">due</field>
                <field name="figure_type">date</field>
            </record>
            <record id="vendor_invoice_detail_column_ref" model="account.report.column">
                <field name="name">Referencia</field>
                <field name="expression_label">ref</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vendor_invoice_detail_column_untaxed" model="account.report.column">
                <field name="name">Sin impuestos</field>
                <field name="expression_label">untaxed</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="vendor_invoice_detail_column_tax" model="account.report.column">
                <field name="name">Impuestos</field>
                <field name="expression_label">tax</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="vendor_invoice_detail_column_amount" model="account.report.column">
                <field name="name">Total factura</field>
                <field name="expression_label">amount</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="vendor_invoice_detail_column_balance" model="account.report.column">
                <field name="name">Saldo pendiente</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
    <record id="action_vendor_invoice_detail_report" model="ir.actions.client">
        <field name="name">Facturas por proveedor</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('vendor_invoice_detail_report')}"/>
    </record>
    <menuitem id="menu_vendor_invoice_detail_report" name="Facturas por proveedor"
              parent="account_vendor_invoices_section" action="action_vendor_invoice_detail_report"
              sequence="50" groups="account.group_account_invoice"/>

    <record id="vendor_payment_posting_report" model="account.report">
        <field name="name">Contabilización de pagos por proveedor</field>
        <field name="custom_handler_model_id" ref="model_account_vendor_document_report_handler"/>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="column_ids">
            <record id="vendor_payment_posting_column_date" model="account.report.column">
                <field name="name">Fecha contable</field>
                <field name="expression_label">date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="vendor_payment_posting_column_entry" model="account.report.column">
                <field name="name">Asiento</field>
                <field name="expression_label">entry</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vendor_payment_posting_column_journal" model="account.report.column">
                <field name="name">Diario</field>
                <field name="expression_label">journal</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vendor_payment_posting_column_account" model="account.report.column">
                <field name="name">Cuenta</field>
                <field name="expression_label">account</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vendor_payment_posting_column_memo" model="account.report.column">
                <field name="name">Concepto</field>
                <field name="expression_label">memo</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vendor_payment_posting_column_groups" model="account.report.column">
                <field name="name">Pago agrupado</field>
                <field name="expression_label">groups</field>
                <field name="figure_type">string</field>
            </record>
            <record id="vendor_payment_posting_column_debit" model="account.report.column">
                <field name="name">Debe</field>
                <field name="expression_label">debit</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="vendor_payment_posting_column_credit" model="account.report.column">
                <field name="name">Haber</field>
                <field name="expression_label">credit</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
    <record id="action_vendor_payment_posting_report" model="ir.actions.client">
        <field name="name">Contabilización de pagos por proveedor</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('vendor_payment_posting_report')}"/>
    </record>
    <menuitem id="menu_vendor_payment_posting_report" name="Contabilización de pagos por proveedor"
              parent="account_vendor_invoices_section" action="action_vendor_payment_posting_report"
              sequence="60" groups="account.group_account_invoice"/>
</odoo>
