<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Carta vertical a 96 dpi sin reducción: las medidas en px del
         documento coinciden con las de la hoja (816 x 1056 px). -->
    <record id="paperformat_sale_quotation" model="report.paperformat">
        <field name="name">Cotización (Carta)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">27</field>
        <field name="margin_left">9</field>
        <field name="margin_right">9</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="paperformat_sale_quotation_landscape" model="report.paperformat">
        <field name="name">Cotización (Carta horizontal)</field>
        <field name="format">Letter</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_spacing">28</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_sale_quotation"/>
    </record>

    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_sale_quotation"/>
    </record>

    <!-- Espera en el contexto: doc (en el idioma del cliente) y quotation
         (valores de sale.order._quotation_report_values). -->
    <template id="sale_quotation_layout">
        <t t-set="company" t-value="doc.company_id.sudo()"/>
        <t t-set="quotation_style" t-value="doc._quotation_report_style()"/>
        <div class="article o_sale_quotation"
             t-att-data-oe-model="doc._name"
             t-att-data-oe-id="doc.id"
             t-att-data-oe-lang="doc.env.context.get('lang')">
            <style t-out="quotation_style"/>
            <table class="o_sq_header">
                <tr>
                    <td class="o_sq_brand">
                        <div class="o_sq_card">
                            <div class="o_sq_logo">
                                <img t-att-src="doc._quotation_report_image()" alt="Pinturas Osel Centro Sur"/>
                            </div>
                            <table class="o_sq_reference">
                                <tr>
                                    <td class="o_sq_title" t-out="quotation['title']"/>
                                    <td class="o_sq_folio" t-out="doc.name"/>
                                </tr>
                            </table>
                        </div>
                    </td>
                    <td class="o_sq_company">
                        <div class="o_sq_company_name" t-out="company.name"/>
                        <div t-if="company.vat">RFC: <t t-out="company.vat"/></div>
                        <div t-out="' '.join(filter(None, [company.street, company.street2]))"/>
                        <div t-out="', '.join(filter(None, [company.zip and 'C.P. %s' % company.zip, company.city, company.country_id.name]))"/>
                        <div t-if="company.website" t-out="company.website"/>
                    </td>
                    <td class="o_sq_dates">
                        <div class="o_sq_card">
                            <div class="o_sq_band">Fecha de <t t-out="quotation['document_label']"/></div>
                            <div class="o_sq_date" t-out="quotation['date_order']"/>
                        </div>
                        <div t-if="quotation['validity']" class="o_sq_card">
                            <div class="o_sq_band">Fecha de Vigencia</div>
                            <div class="o_sq_date" t-out="quotation['validity']"/>
                        </div>
                    </td>
                </tr>
            </table>
            <t t-out="0"/>
        </div>

        <div class="footer o_sale_quotation">
            <style t-out="quotation_style"/>
            <t t-set="company_address" t-value="', '.join(filter(None, [
                company.street,
                company.street2,
                company.zip and 'C.P. %s' % company.zip,
                company.city,
                company.country_id.name,
            ]))"/>
            <table class="o_sq_footer">
                <tr>
                    <td class="o_sq_footer_mark">
                        <img class="o_sq_watermark" t-att-src="doc._quotation_report_image(watermark=True)" alt="Súper Asesor Osel"/>
                    </td>
                    <td class="o_sq_footer_company">
                        <div t-out="company.name"/>
                        <div t-if="company_address" t-out="company_address"/>
                        <div t-if="company.phone">Tel. <t t-out="company.phone"/></div>
                    </td>
                    <td class="o_sq_footer_page">
                        <span class="o_sq_footer_folio" t-out="doc.name"/>
                        · Página <span class="page"/> de <span class="topage"/>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!-- Se conserva la estructura del documento del core (solo se cambia el
         layout y se apaga su cuerpo) para que las vistas de otros módulos que
         lo heredan sigan encontrando sus nodos. -->
    <template id="report_sale_quotation" inherit_id="sale.report_saleorder_document" priority="90">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">entintados_pdv.sale_quotation_layout</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="quotation" t-value="doc._quotation_report_values()"/>
            <t t-set="currency" t-value="doc.currency_id"/>
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': currency}"/>
            <t t-call="entintados_pdv.sale_quotation_info"/>
            <t t-call="entintados_pdv.sale_quotation_lines"/>
            <t t-call="entintados_pdv.sale_quotation_totals"/>
            <t t-call="entintados_pdv.sale_quotation_closing"/>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template id="sale_quotation_info">
        <t t-set="customer" t-value="quotation['customer']"/>
        <t t-set="shipping" t-value="doc.partner_shipping_id"/>
        <table class="o_sq_info">
            <tr>
                <td class="o_sq_customer">
                    <div class="o_sq_card">
                        <div class="o_sq_band">En atención a:</div>
                        <table class="o_sq_pairs">
                            <tr t-if="customer.ref"><td>Clave</td><td t-out="customer.ref"/></tr>
                            <tr><td>Nombre</td><td class="o_sq_partner_name" t-out="customer.name"/></tr>
                            <tr t-if="doc.user_id"><td>Agente</td><td t-out="doc.user_id.name"/></tr>
                            <tr t-if="quotation['attention']"><td>Atención</td><td t-out="quotation['attention']"/></tr>
                            <tr t-if="shipping"><td>Entrega a:</td><td t-out="shipping.name"/></tr>
                            <tr t-if="quotation['regime']"><td>Régimen</td><td t-out="quotation['regime']"/></tr>
                        </table>
                    </div>
                </td>
                <td class="o_sq_contact">
                    <div class="o_sq_card">
                        <div class="o_sq_contact_name" t-out="shipping.name or customer.name"/>
                        <table class="o_sq_pairs">
                            <tr t-if="shipping.phone"><td>Teléfono:</td><td t-out="shipping.phone"/></tr>
                            <tr t-if="shipping.street or shipping.street2">
                                <td>Dirección:</td><td t-out="' '.join(filter(None, [shipping.street, shipping.street2]))"/>
                            </tr>
                            <tr t-if="shipping.zip"><td>C.P.:</td><td t-out="shipping.zip"/></tr>
                            <tr t-if="shipping.city or shipping.state_id">
                                <td>Ciudad:</td><td t-out="', '.join(filter(None, [shipping.city, shipping.state_id.code]))"/>
                            </tr>
                            <tr t-if="shipping.country_id"><td/><td t-out="shipping.country_id.name"/></tr>
                        </table>
                    </div>
                </td>
            </tr>
        </table>
        <p class="o_sq_intro">A continuación pongo a su consideración la siguiente <t t-out="quotation['document_label']"/>:</p>
    </template>

    <template id="sale_quotation_lines">
        <table class="o_sq_lines" name="sale_quotation_lines">
            <thead>
                <tr>
                    <th class="o_sq_col_qty">Cantidad</th>
                    <th class="o_sq_col_code">Código</th>
                    <th>Descripción</th>
                    <th class="o_sq_col_price o_sq_num">Valor Uni.</th>
                    <th class="o_sq_col_price o_sq_num">Importe</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="collapse_prices" t-value="False"/>
                <t t-foreach="doc._get_order_lines_to_report()" t-as="line">
                    <t t-if="line.display_type == 'line_section'">
                        <t t-set="collapse_prices" t-value="line.collapse_prices"/>
                    </t>
                    <t t-elif="line.display_type == 'line_subsection'">
                        <t t-set="collapse_prices" t-value="line.parent_id.collapse_prices or line.collapse_prices"/>
                    </t>
                    <tr t-if="line.display_type in ('line_section', 'line_subsection')" class="o_sq_section" name="sale_quotation_section">
                        <t t-set="show_total" t-value="line.collapse_composition or line.collapse_prices"/>
                        <td t-att-colspan="4 if show_total else 5" t-out="line.name"/>
                        <td t-if="show_total" class="o_sq_num" t-out="line._quotation_section_values()['total']" t-options="money"/>
                    </tr>
                    <tr t-elif="line.display_type == 'line_note'" class="o_sq_note" name="sale_quotation_note">
                        <td colspan="5"><span t-out="line.name" t-options="{'widget': 'text'}"/></td>
                    </tr>
                    <tr t-elif="line.product_type == 'combo'" class="o_sq_section" name="sale_quotation_combo">
                        <td class="o_sq_center"><span t-out="line.product_uom_qty" t-options="{'widget': 'float', 'precision': 4}"/></td>
                        <td colspan="3" t-out="line.name"/>
                        <td class="o_sq_num">
                            <t t-if="not collapse_prices" t-out="line._get_combo_totals('price_subtotal')" t-options="money"/>
                        </td>
                    </tr>
                    <tr t-else="" class="o_sq_product" name="sale_quotation_product">
                        <td class="o_sq_center"><span t-out="line.product_uom_qty" t-options="{'widget': 'float', 'precision': 4}"/></td>
                        <td class="o_sq_center o_sq_code" t-out="line._quotation_product_code()"/>
                        <td class="o_sq_desc"><span t-out="line.name" t-options="{'widget': 'text'}"/></td>
                        <td class="o_sq_num">
                            <t t-if="not collapse_prices" t-out="line._quotation_unit_price()" t-options="{'widget': 'float', 'precision': 6}"/>
                        </td>
                        <td class="o_sq_num">
                            <t t-if="not collapse_prices" t-out="line.price_subtotal" t-options="money"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="sale_quotation_totals">
        <table class="o_sq_totals" name="sale_quotation_totals">
            <tr>
                <td/>
                <td class="o_sq_totals_amounts">
                    <table class="o_sq_amounts">
                        <t>
                            <tr name="sale_quotation_gross">
                                <td class="o_sq_amount_label">Importe antes del descuento</td>
                                <td class="o_sq_num" t-out="quotation['gross']" t-options="money"/>
                            </tr>
                            <tr name="sale_quotation_discount">
                                <td class="o_sq_amount_label">Descuento</td>
                                <td class="o_sq_num" t-out="quotation['discount']" t-options="money"/>
                            </tr>
                        </t>
                        <tr class="o_sq_untaxed">
                            <td class="o_sq_amount_label">Importe sin impuestos</td>
                            <td class="o_sq_num" t-out="doc.amount_untaxed" t-options="money"/>
                        </tr>
                        <t t-foreach="(doc.tax_totals or {}).get('subtotals', [])" t-as="subtotal">
                            <tr t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group" name="sale_quotation_tax">
                                <td class="o_sq_amount_label" t-out="tax_group['group_name']"/>
                                <td class="o_sq_num" t-out="tax_group['tax_amount_currency']" t-options="money"/>
                            </tr>
                        </t>
                        <tr class="o_sq_grand">
                            <td class="o_sq_grand_label">Total <span t-out="currency.name"/></td>
                            <td class="o_sq_num o_sq_grand_value" t-out="doc.amount_total" t-options="money"/>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </template>

    <template id="sale_quotation_closing">
        <table class="o_sq_closing" name="sale_quotation_closing">
            <tr>
                <td class="o_sq_terms">
                    <div>Importe con letra: <span t-out="currency.amount_to_text(doc.amount_total)"/></div>
                    <div>
                        Gracias por su preferencia.
                        <t t-if="quotation['is_quotation'] and quotation['validity']">
                            Esta cotización es válida hasta <t t-out="quotation['validity']"/>.
                        </t>
                    </div>
                    <div name="sale_quotation_notes">
                        <span>Observaciones:</span>
                        <div t-if="not is_html_empty(doc.note)" t-field="doc.note"/>
                    </div>
                    <div t-if="doc.user_id" class="o_sq_signature" name="sale_quotation_signature">
                        Quedo a sus órdenes,
                        <div t-out="doc.user_id.name"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>
</odoo>
