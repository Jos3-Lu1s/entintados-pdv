<odoo>
    <record id="paperformat_customer_advance_pdf" model="report.paperformat">
        <field name="name">Facturas de anticipo - formato contable</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">10</field>
    </record>

    <record id="action_customer_advance_pdf" model="ir.actions.report">
        <field name="name">Facturas de anticipo</field>
        <field name="model">customer.advance.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">entintados_pdv.customer_advance_pdf</field>
        <field name="paperformat_id" ref="paperformat_customer_advance_pdf"/>
    </record>

    <template id="customer_advance_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article o_content" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <t t-set="detailed" t-value="o.report_kind == 'detail'"/>
                    <div t-attf-class="page o_advance_pdf {{ '' if detailed else 'o_advance_pdf_general' }}">
                        <t t-call-assets="account_reports.assets_pdf_export" t-js="False"/>
                        <style>
                            .o_advance_pdf { color: #111; font-family: Verdana, sans-serif; }
                            .o_advance_pdf .o_advance_heading { width: 100%; margin-bottom: 16px; font-size: 11px; }
                            .o_advance_heading td { padding: 0 5px; vertical-align: top; }
                            .o_advance_heading address { margin: 0; color: #777; font-style: normal; }
                            .o_advance_heading .o_company_logo { max-height: 45px; max-width: 175px; margin-bottom: 7px; }
                            .o_advance_heading .o_title { margin: 0 0 8px; font-size: 17px; font-weight: bold; }
                            .o_advance_heading .o_advance_title_cell { text-align: right; }
                            .o_advance_pdf table.o_customer_advance_report {
                                width: 100%; margin: 0 0 16px; border-collapse: collapse; font-size: 10px;
                            }
                            .o_advance_pdf .o_customer_advance_report > :not(caption) > * > * {
                                padding: 4px 8px; vertical-align: top;
                            }
                            .o_customer_advance_report th { text-align: left; font-weight: 700; }
                            .o_customer_advance_report tbody tr { border-bottom: 1px solid #d5d8dd; }
                            .o_customer_advance_report .text-end { text-align: right; }
                            .o_customer_advance_report .text-nowrap { white-space: nowrap; }
                            .o_customer_advance_report .o_advance_currency th:last-child {
                                text-align: center; background-color: #e7e9ed;
                            }
                            .o_customer_advance_report .o_advance_customer { font-weight: bold; }
                            .o_customer_advance_report .o_advance_customer td { background-color: #d4e2f3; color: #000; }
                            .o_customer_advance_report .o_advance_invoice_with_applications td { background-color: #fff0c2; }
                            .o_advance_pdf .o_customer_advance_report tr.o_advance_invoice td:first-child {
                                padding-left: 16px; font-weight: bold;
                            }
                            .o_advance_pdf .o_customer_advance_report tr.o_advance_application td:first-child { padding-left: 26px; }
                            .o_advance_application_tag {
                                display: inline-block; padding: 1px 6px; border-radius: 8px;
                                background-color: #dceafa; color: #174b80; font-weight: bold;
                            }
                            .o_customer_advance_report .o_advance_total { font-weight: bold; }
                            .o_advance_pdf_general .o_advance_heading { font-size: 14px; }
                            .o_advance_pdf_general .o_advance_heading .o_title { font-size: 22px; }
                            .o_advance_pdf_general table.o_customer_advance_report { font-size: 14px; }
                            .o_advance_pdf_general .o_customer_advance_report > :not(caption) > * > * {
                                padding: 7px 10px;
                            }
                        </style>
                        <t t-set="sections" t-value="o._report_sections()"/>
                        <table class="o_advance_heading">
                            <tr>
                                <td>
                                    <t t-call="account_reports.company_information">
                                        <t t-set="options" t-value="{'companies': [{'name': company.name} for company in env.companies]}"/>
                                    </t>
                                </td>
                                <td class="o_advance_title_cell">
                                    <div class="o_title">Facturas de anticipo</div>
                                    <div t-if="detailed">Detalle por cliente</div>
                                    <div t-else="">Resumen por cliente</div>
                                </td>
                            </tr>
                        </table>
                        <p t-if="not sections">No hay facturas que coincidan con los filtros.</p>
                        <t t-foreach="sections" t-as="section">
                            <t t-set="currency" t-value="section['currency']"/>
                            <table class="o_table o_customer_advance_report">
                                <thead style="display: table-header-group;">
                                    <tr class="o_advance_currency">
                                        <th/>
                                        <th t-att-colspan="5 if detailed else 4" t-out="currency.name"/>
                                    </tr>
                                    <tr>
                                        <t t-if="detailed">
                                            <th>Factura de anticipo / aplicación</th>
                                            <th>Fecha</th>
                                        </t>
                                        <t t-else="">
                                            <th>Cliente</th>
                                            <th class="text-end">Facturas</th>
                                        </t>
                                        <th class="text-end">Total</th>
                                        <th class="text-end">Saldo utilizado</th>
                                        <th class="text-end">Saldo disponible</th>
                                        <th t-if="detailed">Estatus de nota de crédito</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="detailed">
                                        <t t-foreach="section['customers']" t-as="customer">
                                            <tr class="o_advance_customer">
                                                <td colspan="6" t-out="customer['name'] or ''"/>
                                            </tr>
                                            <t t-foreach="customer['invoices']" t-as="invoice">
                                                <t t-set="balances" t-value="invoice._advance_report_balances()"/>
                                                <t t-set="used_amounts" t-value="invoice._advance_report_used_amounts_by_invoice()"/>
                                                <tr t-attf-class="o_advance_invoice {{ 'o_advance_invoice_with_applications' if used_amounts else '' }}">
                                                    <td class="text-nowrap"><span t-field="invoice.name"/></td>
                                                    <td class="text-nowrap"><span t-field="invoice.invoice_date"/></td>
                                                    <td class="text-end text-nowrap"><span t-field="invoice.amount_total"/></td>
                                                    <td class="text-end text-nowrap"><span t-out="balances['advance_applied']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                                    <td class="text-end text-nowrap"><span t-out="balances['advance_available']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                                    <td t-out="invoice._advance_report_credit_status()"/>
                                                </tr>
                                                <tr t-foreach="invoice.browse(list(used_amounts))" t-as="related" class="o_advance_application">
                                                    <td>Aplicado en <span class="o_advance_application_tag" t-field="related.name"/></td>
                                                    <td class="text-nowrap"><span t-field="related.invoice_date"/></td>
                                                    <td/>
                                                    <td class="text-end text-nowrap">
                                                        <span t-out="used_amounts.get(related.id, 0.0)"
                                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                                    </td>
                                                    <td/>
                                                    <td/>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr t-foreach="section['customers']" t-as="customer">
                                            <td t-out="customer['name'] or ''"/>
                                            <td class="text-end" t-out="customer['count']"/>
                                            <td t-foreach="customer['amounts']" t-as="amount" class="text-end text-nowrap">
                                                <span t-out="amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="o_advance_total">
                                        <td colspan="2">Total general</td>
                                        <td t-foreach="section['totals']" t-as="amount" class="text-end text-nowrap">
                                            <span t-out="amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                        <td t-if="detailed"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
                <div class="footer text-end" style="font-size: 10px; text-align: right;">
                    <span class="page"/> / <span class="topage"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
